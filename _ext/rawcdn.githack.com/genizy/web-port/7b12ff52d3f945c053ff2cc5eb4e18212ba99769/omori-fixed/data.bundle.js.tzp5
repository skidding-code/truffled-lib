lready been calculated\\nif (this._calculatedBaseDmg) {\\n  // Set the damage to the cached amount\\n  value = this._calculatedBaseDmg;\\n// Otherwise\\n} else {\\n  // Get the total number of enemies\\n  var totalEnemies = target.friendsUnit().aliveMembers().length;\\n  // If there is 1 enemy total\\n  if (totalEnemies === 1) {\\n    // Use this formula\\n    this._calculatedBaseDmg = user.atk * 3 - b.def;\\n  // If there are 2 enemies in total\\n  } else if (totalEnemies === 2) {\\n    // Use this formula\\n    this._calculatedBaseDmg = user.atk * 2.5 - b.def;\\n  // If there are 3 enemies in total\\n  } else if (totalEnemies === 3) {\\n    // Use this formula\\n    this._calculatedBaseDmg = user.atk * 2 - b.def;\\n  // if there are 4 or more\\n  } else {\\n    // Use this formula\\n    this._calculatedBaseDmg = user.atk * 2 - b.def;\\n  }\\n  // Set the value equal to the calculated amount\\n  value = this._calculatedBaseDmg;\\n}\\n</Damage Formula>\\n\",\"occasion\":1,\"repeats\":1,\"requiredWtypeId1\":0,\"requiredWtypeId2\":0,\"scope\":2,\"speed\":0,\"stypeId\":1,\"successRate\":100,\"tpCost\":0,\"tpGain\":0},{\"id\":72,\"animationId\":0,\"damage\":{\"critical\":true,\"elementId\":0,\"formula\":\"a.atk * 2\",\"type\":1,\"variance\":20},\"description\":\"An attack that ignores a foe's DEFENSE,<br>\\nthen reduces the foe's DEFENSE. Cost: 20\",\"effects\":[],\"hitType\":1,\"iconIndex\":0,\"message1\":\"\",\"message2\":\"\",\"mpCost\":20,\"name\":\"POWER HIT\",\"note\":\"<BattleLogType:POWER HIT>\\n\\n<whole action>\\nanimation 31: target\\nwait: 60\\nanimation 219: target\\n\\n if target.isStateAffected(99) \\n   add state 100: target\\n   remove state 99: target\\n else if target.isStateAffected(98) \\n   add state 99: target\\n   remove state 98: target\\n else \\n   add state 98: target\\n</whole action>\\n<AntiFail>\\n\",\"occasion\":1,\"repeats\":1,\"requiredWtypeId1\":0,\"requiredWtypeId2\":0,\"scope\":1,\"speed\":0,\"stypeId\":1,\"successRate\":100,\"tpCost