    u_xlat5.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(16 >> 2) + 2]));
