    u_xlat10.xyw = vec3(uintBitsToFloat(inMatrices_buf[u_xlati3.z].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati3.z].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati3.z].value[(48 >> 2) + 2]));
