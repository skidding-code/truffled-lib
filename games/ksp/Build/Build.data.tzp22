␀␀␀_input_map␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀_output_buf␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿY␀␀#version 310 es

#define HLSLCC_ENABLE_UNIFORM_BUFFERS 1
#if HLSLCC_ENABLE_UNIFORM_BUFFERS
#define UNITY_UNIFORM
#else
#define UNITY_UNIFORM uniform
#endif
#define UNITY_SUPPORTS_UNIFORM_LOCATION 1
#if UNITY_SUPPORTS_UNIFORM_LOCATION
#define UNITY_LOCATION(x) layout(location = x)
#define UNITY_BINDING(x) layout(binding = x, std140)
#else
#define UNITY_LOCATION(x)
#define UNITY_BINDING(x) layout(std140)
#endif
UNITY_BINDING(0) uniform cbReplacementData {
	uint numReplacements;
	uint pad0;
	uint pad1;
	uint pad2;
};
layout(std430, binding = 1) readonly buffer _input_map {
	uint _input_map_buf[];
};
layout(std430, binding = 0) buffer _output_buf {
	uint _output_buf_buf[];
};
vec2 u_xlat0;
int u_xlati0;
uint u_xlatu0;
bool u_xlatb0;
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
    u_xlatu0 = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x;
    u_xlatb0 = u_xlatu0<numReplacements;
    if(u_xlatb0){
        u_xlati0 = int(gl_LocalInvocationID.x) << (3 & int(0x1F));
        u_xlati0 = int(gl_WorkGroupID.x) * 2048 + u_xlati0;
        u_xlat0.xy = vec2(uintBitsToFloat(_input_map_buf[(u_xlati0 >> 2) + 0]), uintBitsToFloat(_input_map_buf[(u_xlati0 >> 2) + 1]));
        u_xlati0 = floatBitsToInt(u_xlat0.x) << (2 & int(0x1F));
        _output_buf_buf[(u_xlati0 >> 2)] = uint(floatBitsToUint(u_xlat0.y));
    }
    return;
}
