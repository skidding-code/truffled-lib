	section Clothes
		#texturename,	nametag,	modelname,	type,	stats to change,	price
		#type is a number and can be one of the following
		# 0 = torso cant go over 25 for stats
		# 2 = legs cant go over 10 for stats
		# 3 = shoes cant go over 5 for stats
		# 13 = extra1	(necklace) cant go over 2 for stats
		# 14 = extra2	(bracelet/watch) cant go over 3 for stats
		# 15 = extra3	(glasses) cant go over 2 for stats 
		# 16 = extra4	(hats) cant go over 3 for stats
		#texturename,		nametag,	modelname,	type,	stats to change,		price
		player_torso		TORSO		torso		0		respect 5 	sexy 20		0
