[node name="Body" parent="NPC_Level_5" index="0"]
LINES = [ "Hey! Need help cooking your books?" ]
DYN_LINES = [ [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "I lost my job at the Megamall for poor handling of security during the Gurney's rally.", "I had the place crawling with police deathmechs, what else could I possibly have done?", "Now I'm doing accounting here. It's not so bad. Starting to get the hang of it.", "This room is a lot nicer than my last one." ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ] ]
