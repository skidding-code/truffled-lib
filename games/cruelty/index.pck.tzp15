[node name="NPC_Level_4" parent="." instance=ExtResource( 36 )]
transform = Transform( 1, 0, 0, 0, 1, 0, 0, 0, 1, 32.1341, 0.996457, 18.3384 )
npc_name = "Michael Nielsen"
health = 200
permadeath = true

[node name="Body" parent="NPC_Level_4" index="0"]
LINES = [ "So good to see you around. You changed my life." ]
DYN_LINES = [ [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "You really blasted up the PD huh? Can't say I blame you.", "The whole place is in complete disarray as people are fighting for power and trying to figure out a new source of steroids.", "I had been planning to quit for a while, the oppressive work environment just wasn't working out for me.", "Private security was the obvious choice so here I am. I even get to decide my own working hours here, so nice!", "I'm extremely grateful that you provided me with this opportunity to finally change the course of my life. Things are looking up." ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ], [ "N" ] ]
level_range_min = 5

