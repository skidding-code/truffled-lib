  "obj_gigaqueen_enemy_slash_Step_0_gml_121_0_b": "<!--[アンタら]ハ&確カニ&[ワタシ]ノ　対戦相手ニ&フサワシイ-->/%",
  "obj_gigaqueen_enemy_slash_Step_0_gml_122_0": "<!--ヨッテ　[アンタら]ノ&[ボコリングマシン]ノ&真ノ　目的ヲ　思イ出サセテ&アゲマス; ソレハ-->/%",
