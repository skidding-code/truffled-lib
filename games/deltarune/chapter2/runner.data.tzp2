  "obj_spamton_neo_enemy_slash_Step_0_gml_213_0": "[[ブルーライトセール]]の&時間です！/%",
  "obj_spamton_neo_enemy_slash_Step_0_gml_214_0": "＊ スパムトンNEOの　ATが低下！&＊ スパムトンNEOの　DEFが大幅に上昇！/%",
  "obj_spamton_neo_enemy_slash_Step_0_gml_217_0": "ご存じあﾘませnでレた？&[[NEO]]の売ﾘは&高い[[ぼうぎょ力]]　！！/%",
