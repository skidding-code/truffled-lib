  "obj_spamton_neo_enemy_slash_Step_0_gml_89_0": "[[受話器]]に向かって&[[叫]]ﾝでも/%",
  "obj_spamton_neo_enemy_slash_Step_0_gml_90_0": "NO MORE　[[キセキ]]&NO MORE　[[まほう]]/%",
  "obj_spamton_neo_enemy_slash_Step_0_gml_91_0": "[[ヘド]]が出ます！/%",
