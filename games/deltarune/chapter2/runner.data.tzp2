  "obj_ch2_scene25_slash_Step_0_gml_153_0": "\\ED＊ <!--[ノエル]ハ　モウ&　 [ワタシ]ノ　モノ-->/",
  "obj_ch2_scene25_slash_Step_0_gml_154_0": "\\E1＊ <!--[あの娘]ノ　[意志]ニ&　 変化ガ　生ジルノハ&　 時間ノ　問題-->/",
  "obj_ch2_scene25_slash_Step_0_gml_155_0": "\\E6＊ <!--[ノエル]ハ&　 ミズカラノ　[力]ヲ&　 解放シマス-->/",
  "obj_ch2_scene25_slash_Step_0_gml_156_0": "\\E7＊ <!--ソシテ　コノ世界ハ/%",
  "obj_ch2_scene25_slash_Step_0_gml_657_0": "\\E8＊ <!--アラ　ヤダ-->/",
  "obj_ch2_scene25_slash_Step_0_gml_658_0": "\\E8＊ <!--[誰か]ガ　[ワタシ]ノ&　 [シールドのエネルギー源]ヲ&　 吸イツクシタ　ヨウデス-->/",
  "obj_ch2_scene25_slash_Step_0_gml_660_0": "\\EW＊ っつうことは…/%",
  "obj_ch2_scene25_slash_Step_0_gml_685_0": "\\EY＊ いま　こうげきすりゃ&　 さえぎるもんは&　 なんもねーってことだな。/",
  "obj_ch2_scene25_slash_Step_0_gml_687_0": "\\E9＊ <!--ソレハ-->/",
  "obj_ch2_scene25_slash_Step_0_gml_688_0": "\\E7＊ <!--ドウカシラ-->/%",
  "obj_ch2_scene25_slash_Step_0_gml_740_0": "\\E1＊ <!--[鳥ボーイ]ノ　[HP]ハ&　 マダ　[満タン]-->/",
  "obj_ch2_scene25_slash_Step_0_gml_741_0": "\\EA＊ <!--大事ナ　[フレンド]ヲ&　 痛イ目ニ　遭ワセタク&　 ナカッタラ-->/",
  "obj_ch2_scene25_slash_Step_0_gml_742_0": "\\ED＊ [[以下を推奨します]]/%",
  "obj_ch2_scene25_slash_Step_0_gml_754_0": "\\E7＊ [[・自分が鳥ボーイに&　 痛い目に遭わされる]]/%",
  "obj_ch2_scene25_slash_Step_0_gml_776_0": "＊ おまえ^1…　なんかの^1…　言いなりに^1…&　 なるもんか…/",
  "obj_ch2_scene25_slash_Step_0_gml_778_0": "\\EE＊ <!--ナ-->/",
  "obj_ch2_scene25_slash_Step_0_gml_779_0": "\\EH＊ <!--ナニシテルノ-->/%",
  "obj_ch2_scene25_slash_Step_0_gml_795_0": "＊ こんな^1…　ケーブル^1…&　 外してやる…！/%",
  "obj_ch2_scene25_slash_Step_0_gml_803_0": "\\EE＊ <!--ヤメ/",
  "obj_ch2_scene25_slash_Step_0_gml_804_0": "\\EH＊ <!--ヤメナサイ&　 [ウデ]ガ/%",
  "obj_ch2_scene25_slash_Step_0_gml_822_0": "\\EH＊ <!--[[STOP!!]]-->/%",
  "obj_ch2_scene25_slash_Step_0_gml_965_0": "\\EZ＊ バードリー　おまえ^1…&　 なにやってんだよ！？/",
  "obj_ch2_scene25_slash_Step_0_gml_966_0": "＊ ウデが^1…&＊ バカかよ…！？/",
  "obj_ch2_scene25_slash_Step_0_gml_1035_0": "\\E8＊ バードリー…/%",
  "scr_text_slash_scr_text_gml_7350_0": "＊ (箱に　大量のベーグルが&　 入っている。１つ取る？)/",
  "obj_zpoppup_enemy_slash_Step_0_gml_489_0": "＊ ラルセイは　お城の画像がついた広告を&　 クリックしようとした…/",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_278_0": "クイーンさま&のご命令に&より　ゴミを&買い取ります",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_279_0": "以上ですね&お荷物を&お運び&しましょうか",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_280_0": "なにも&お持ちで&ないよう&ですが",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_366_0": "クイーンさま&のお気に召す&品を&お持ちで？",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_367_0": "クイーンさま&をお守りする&ぶきを&お持ちで？",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_368_0": "クイーンさま&にお似合いの&ぼうぐを&お持ちで？",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_369_0": "クイーンさま&も　きっと&よろこばれる&かと",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_370_0": "おやめに&なりますか？&じっくり&ご検討を",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_371_0": "お買い取り&できない&モノも&ございます",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_372_0": "黒は&悲しみの&色で&ございます",
  "obj_shop_ch2_swatch_slash_Draw_0_gml_387_0": "$~1",
  "DEVICE_FAILURE_slash_Create_0_gml_12_0": "THE DEATH",
  "DEVICE_FAILURE_slash_Step_0_gml_39_0": "  クリ^1ス&  しっかりしろよ！/",
  "DEVICE_FAILURE_slash_Step_0_gml_40_0": "  まだ終われねーだろ^1？&  起きろって…！/%",
  "DEVICE_FAILURE_slash_Step_0_gml_47_0": "  キミは　こんなところで&  終わるはずじゃない…！/",
  "DEVICE_FAILURE_slash_Step_0_gml_48_0": "  あきらめちゃ&  ダメだよ！/%",
  "DEVICE_FAILURE_slash_Step_0_gml_103_0_b": "CONTINUE",
  "DEVICE_FAILURE_slash_Step_0_gml_104_0": "GIVE UP",
  "DEVICE_FAILURE_slash_Step_0_gml_172_0": "THE DARK",
  "DEVICE_MENU_slash_Create_0_gml_8_0": "CONTACT",
  "DEVICE_MENU_slash_Create_0_gml_17_0": "DELTARUNE",
  "DEVICE_MENU_slash_Create_0_gml_97_0": "[データなし]",
  "DEVICE_MENU_slash_Draw_0_gml_189_0": "キャンセル",
  "DEVICE_MENU_slash_Draw_0_gml_190_0": "キャンセル",
  "DEVICE_MENU_slash_Draw_0_gml_199_0": "写ス",
  "DEVICE_MENU_slash_Draw_0_gml_200_0": "消ス",
  "DEVICE_MENU_slash_Draw_0_gml_201_0": "写す",
  "DEVICE_MENU_slash_Draw_0_gml_201_1": "消す",
  "DEVICE_MENU_slash_Step_0_gml_105_0": "[データなし]",
  "obj_berdlyb2_enemy_slash_Step_0_gml_79_0": "ボクの弱みに&つけ込めば&ボクを倒せる…&そう思いついて…/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_88_0": "ボクのいちばん&大切なもの…&ノエルを&誘拐したんだろう！/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_98_0": "だがボクは&おまえが一生かかっても&手に入れられないものを&いろいろ持っている！/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_171_0": "ノエル　少し痛い思いを&してもらうよ&でも　これはキミを&救うためなんだ！/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_180_0": "(助けて)/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_226_0": "ノエル…！&クリスが倒れたぞ！/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_236_0": "さあ　いまのうちに&こっちへ…！/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_247_0": "…/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_258_0": "ノエ…ル？/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_266_0": "(まだ…&聞こえる…&わたしに…&指示する声が…)/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_338_0": "＊ バードリーは　イラついて&　 IQ値スカウターを　にぎりつぶした。",
  "obj_berdlyb2_enemy_slash_Step_0_gml_339_0": "＊ 凍ったトリ肉の　ニオイがする。",
  "obj_berdlyb2_enemy_slash_Step_0_gml_371_0": "＊ 敵の弱点: 氷&　 氷属性の最強まほうを使え。/%",
  "obj_berdlyb2_enemy_slash_Step_0_gml_484_0": "＊ ノエルは　かしこくふるまった！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_29_0_b": "食らえ　クリス！&懲罰の辻風を！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_30_0": "聖斧ハルバード！&われに力を！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_31_0": "スージィ！&100点取ってみたいかい？&いま　お見舞いしてやろう！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_36_0": "さあ　好きなだけ&たいあたりしてくるがいい！&たいあたりしか能がない&タイアタリアンどもめ！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_42_0": "なっ…？　ボクの&ジェットコースターが&壊れかけている…！？/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_48_0": "クリス　キミがボクの&ジャマを　するのは&ボクに　ヤキモチを&焼いているからだな！？/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_49_0": "クラスの３番手として&遠くから　ボクとノエルの&完熟果実的成功を見ているのに&嫌気が　さしたんだろう！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_50_0": "だが　キミは　勉学に&はげむこともせず&スージィと手を組み&ボクたちを陥れようとした！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_51_0": "つくづく&気の毒なヤツだ。&クラス随一の乱暴者と&ドロ水遊びとは。/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_52_0": "とはいえ　ボクは&勇敢かつ心やさしい&ヒーローだ！&こちらに寝返れば…/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_80_0": "真のたいあたりとは　頭脳戦！&運転技術は無関係ということを&教えてやろう！/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_82_0": "キミは「すこーしだけ&ナンバー２に近い&ナンバー３」になれる…&かもしれない。/%",
  "obj_berdlyb_enemy_slash_Step_0_gml_158_0": "＊ バードリーは　クイーンに助けを求めた！&　 しかしクイーンは　電話中のフリを&　 している！",
  "obj_berdlyb_enemy_slash_Step_0_gml_159_0": "＊ バードリーはクイーンに　今日のおやつを&　 聞いた！　クイーンは　うなずいた…&　 クイーンは　耳せんをしている！",
  "obj_berdlyb_enemy_slash_Step_0_gml_160_0": "＊ バードリーは　ヒミツのサインを出した！&　 しかしクイーンは　ぬり絵をしていて&　 見ていない！",
  "obj_berdlyb_enemy_slash_Step_0_gml_161_0": "＊ バードリーは　クイーンを呼び出した！&＊ クイーンは　病欠した！",
  "obj_berdlyb_enemy_slash_Step_0_gml_162_0": "＊ バードリーは　クイーンに&　 コレクションしているカードを見せた！&　 クイーンは　うまく逃れた！",
