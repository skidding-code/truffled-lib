  "scr_text_slash_scr_text_gml_5190_0": "#弾の#かわしかた",
  "scr_text_slash_scr_text_gml_5191_0": "#当たり範囲",
  "scr_text_slash_scr_text_gml_5192_0": "募金ホール",
  "scr_text_slash_scr_text_gml_5193_0": "特にない",
  "scr_text_slash_scr_text_gml_5196_0": "＊ ボクはバトルマスター。&　 バトルのことなら&　 なんでも聞いて。/",
  "scr_text_slash_scr_text_gml_5197_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_5205_0": "＊ 弾が直撃しそうなら&　 あわてず騒がず&　 ゆっくり　かわすゥ。/",
  "scr_text_slash_scr_text_gml_5206_0": "＊ そしたら弾は追ってこず^1ゥ&　 さっき　いたとこ　かすめてくゥ。/",
  "scr_text_slash_scr_text_gml_5207_0": "＊ 動くときは　ちょっとずつゥ。/",
  "scr_text_slash_scr_text_gml_5208_0": "＊ ギリギリかわせば　TPたまるゥ。/%",
  "scr_text_slash_scr_text_gml_5214_0": "＊ 弾の見た目は　関係ないィ。/",
  "scr_text_slash_scr_text_gml_5215_0": "＊ サイズ　デカいほど怖くないィ。/",
  "scr_text_slash_scr_text_gml_5216_0": "＊ 痛いのは　内側　ちょっとの範囲ィ。/",
  "scr_text_slash_scr_text_gml_5217_0": "＊ 範囲の見極め　とっても大事ィ。/%",
  "scr_text_slash_scr_text_gml_5225_0": "＊ 目標額は　未達成ィ。/",
  "scr_text_slash_scr_text_gml_5226_0": "＊ だから　しないよ&　 募金ホールの話ィ。/%",
  "scr_text_slash_scr_text_gml_5230_0": "＊ 今月の目標額　達成済みィ。/",
  "scr_text_slash_scr_text_gml_5231_0": "＊ 聞かせてあげるよ&　 募金ホールの話ィ。/",
  "scr_text_slash_scr_text_gml_5232_0": "＊ ダークドルで　満たされた^1ァ&　 暗い暗い　穴だったァ。/",
  "scr_text_slash_scr_text_gml_5233_0": "＊ フォロワーたちの　サブスクでェ&　 しぼり取ってきた　おカネェ。/",
  "scr_text_slash_scr_text_gml_5234_0": "＊ 銀行からも　カネ貸しからも&　 ぜんぜん融資　受けれないィ。/",
  "scr_text_slash_scr_text_gml_5235_0": "＊ 貯まった資金の　合計額^1ゥ&　 1^1…　^1…　^1…&　 ダークドルゥ。/",
