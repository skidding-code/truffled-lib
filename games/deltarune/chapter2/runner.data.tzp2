  "scr_text_slash_scr_text_gml_3036_0_b": "\\E0＊ Kris^1, honey^1, you have grown up so much.../",
  "scr_text_slash_scr_text_gml_3040_0": "\\E8＊ You asked when your horns were going to grow in?/",
  "scr_text_slash_scr_text_gml_3041_0": "\\E0＊ So we bought that headband with the little red horns on it./",
  "scr_text_slash_scr_text_gml_3042_0": "\\E4＊ Oh^1, you wore it for months! Whatever happened to it?/%",
  "scr_text_slash_scr_text_gml_3070_0_b": "\\E1＊ .../",
  "scr_text_slash_scr_text_gml_3088_0_b": " ",
  "scr_text_slash_scr_text_gml_3089_0": " ",
  "scr_text_slash_scr_text_gml_3091_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3101_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_3142_0_b": " ",
  "scr_text_slash_scr_text_gml_3143_0_b": " ",
  "scr_text_slash_scr_text_gml_3146_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3171_0": " ",
  "scr_text_slash_scr_text_gml_3172_0": " ",
  "scr_text_slash_scr_text_gml_3181_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3205_0": " #No",
  "scr_text_slash_scr_text_gml_3206_0_b": " ",
  "scr_text_slash_scr_text_gml_3207_0_b": " ",
  "scr_text_slash_scr_text_gml_3210_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3233_0": "スージィと#くんだせいで#ねむれません！",
  "scr_text_slash_scr_text_gml_3234_0": "むしろ#よくねむれる#ようになりました",
  "scr_text_slash_scr_text_gml_3235_0": " ",
  "scr_text_slash_scr_text_gml_3236_0": " ",
  "scr_text_slash_scr_text_gml_3239_0": "\\E3＊ クリス…/",
  "scr_text_slash_scr_text_gml_3240_0": "\\E5＊ ひょっとして^1…&　 きょう　じゅぎょうちゅう&　 ずっと　ねてたのは…/",
  "scr_text_slash_scr_text_gml_3241_0": "\\E9＊ パートナーとの　かだいが&　 しんぱいで^1　きのう　あまり&　 ねむれなかったから…？/",
  "scr_text_slash_scr_text_gml_3242_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3250_0": "\\E1＊ そんな^1　げんきいっぱいに&　 いわれても…/",
  "scr_text_slash_scr_text_gml_3251_0": "\\EC＊ …/",
  "scr_text_slash_scr_text_gml_3252_0": "\\E1＊ クリス^1　あなたの&　 たんにんとして…/",
  "scr_text_slash_scr_text_gml_3253_0": "\\E5＊ せんせいが　できる&　 アドバイスは&　 かぎられてるけど…/",
  "scr_text_slash_scr_text_gml_3254_0": "\\E7＊ よかった^1ら&　 ひとつ　おすすめが&　 あります。/",
  "scr_text_slash_scr_text_gml_3255_0": "\\EA＊ …FPSゲームの&　 ポッドキャストがあって^1ね&　 それをきくと　よくねむれ…/",
  "scr_text_slash_scr_text_gml_3256_0": "\\EB＊ あ^1　きょうみない^1？&　 そ…そうですか。/%",
  "scr_text_slash_scr_text_gml_3261_0": "\\E3＊ え…^1　そ…そう…^1？&　 なら^1…　よかった^1…のかな？/",
  "scr_text_slash_scr_text_gml_3262_0": "\\E6＊ じゃあ　きょう&　 ずっと　ねてたのは^1…&　 きのうの　よる…/",
  "scr_text_slash_scr_text_gml_3263_0": "\\E7＊ アズリエルと　オンライン&　 チャットしてて^1　ねるのが&　 おそくなった^1　とか…？/",
  "scr_text_slash_scr_text_gml_3264_0": "\\E8＊ …あ^1　でも^1　そっか^1…&　 いまは　チャット&　 できないんでしたね…/",
  "scr_text_slash_scr_text_gml_3265_0": "\\E9＊ は^1…はやく　ふっきゅう&　 すると　いいです^1ね&　 インターネット。/",
  "scr_text_slash_scr_text_gml_3266_0": "\\EA＊ せんせいも^1　いまさら&　 げんしせいぶつに&　 たいか　したくないです。/%",
  "scr_text_slash_scr_text_gml_3272_0": "ふたりで#ものおきに#はいるから…",
  "scr_text_slash_scr_text_gml_3273_0": "これから#はんざい#おかすから…",
  "scr_text_slash_scr_text_gml_3274_0": " ",
  "scr_text_slash_scr_text_gml_3275_0": " ",
  "scr_text_slash_scr_text_gml_3278_0": "\\EP＊ (クリス^1！　どうする！&　 なんて　こたえれば&　 いい！？)/",
  "scr_text_slash_scr_text_gml_3279_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3291_0": "\\E2＊ えーっと^1…　これから&　 ふたりで　ものおきに&　 はいるところでさ…/",
  "scr_text_slash_scr_text_gml_3292_0": "\\EA＊ ほら^1　ダチどうし　ふたり^1で&　 サクッと　ものおきにでも&　 はいるかー…っつって？/",
  "scr_text_slash_scr_text_gml_3293_0": "\\EK＊ んで　ほら…^1　ほうきとか^1？&　 いろいろさわったり&　 するかー…っつって？/%",
  "scr_text_slash_scr_text_gml_3298_0": "\\E2＊ そう^1！　これから&　 はんざい　おかさないと&　 いけなくてさー。/",
  "scr_text_slash_scr_text_gml_3299_0": "\\EA＊ はんざいおかして&　 そんで^1…&　 ケームショに　はいる。/",
  "scr_text_slash_scr_text_gml_3300_0": "\\EH＊ シューシンケイだ。/",
  "scr_text_slash_scr_text_gml_3301_0": "\\E5＊ サイアクだ。/%",
  "scr_text_slash_scr_text_gml_3308_0": "#ハグする",
  "scr_text_slash_scr_text_gml_3309_0": "#しない",
  "scr_text_slash_scr_text_gml_3310_0": " ",
  "scr_text_slash_scr_text_gml_3311_0": " ",
  "scr_text_slash_scr_text_gml_3313_0": "\\E0＊ (…だれも見ていない)/",
  "scr_text_slash_scr_text_gml_3314_0": "＊ (マネキンを　ハグする？)/",
  "scr_text_slash_scr_text_gml_3315_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3321_0": "＊ マネキンを　ハグした。/",
  "scr_text_slash_scr_text_gml_3322_0": "＊ 少しぐらいモフっても&　 バチは当たらない。/%",
  "scr_text_slash_scr_text_gml_3327_0": "＊ マネキンを　ハグしなかった。/",
  "scr_text_slash_scr_text_gml_3328_0": "＊ もうこれ以上&　 モフる道は　歩まない。/%",
  "scr_text_slash_scr_text_gml_3333_0": "#そうだよ！",
  "scr_text_slash_scr_text_gml_3334_0": "#ちがう…",
  "scr_text_slash_scr_text_gml_3335_0": " ",
