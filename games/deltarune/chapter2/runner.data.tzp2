  "scr_roomname_slash_scr_roomname_gml_16_0_b": "高層エリア",
  "scr_roomname_slash_scr_roomname_gml_23_0": "館 - 屋上",
  "scr_text_slash_scr_text_gml_6329_0_b": "\\E4＊ (…うん^1　やっぱり&　 心配いらなかった)/",
  "scr_text_slash_scr_text_gml_6330_0_b": "\\Ed＊ (さっきの指輪は^1…&　 手に入れてよかった^1…&　 そうだよね…？/",
  "scr_text_slash_scr_text_gml_6331_0": "\\Ee＊ (だから^1…&　 バカなことを考えるのは&　 やめよう…)/",
  "scr_text_slash_scr_text_gml_6332_0": "\\EW＊ (スキをついて&　 スイッチから　降りよう&　 なんて…)/",
  "scr_text_slash_scr_text_gml_6333_0": "\\EZ＊ (…そんなことした^1ら&　 クリスは…)/",
  "scr_text_slash_scr_text_gml_6334_0": "\\EW＊ (ダメ^1！&　 そんなヒドいこと^1…&　 考えちゃダメ…)/",
  "scr_text_slash_scr_text_gml_6825_0": "\\EB＊ (…クリスって&　 いつから　こんなに…)/",
  "scr_text_slash_scr_text_gml_6827_0": "\\E4＊ (…きっと　ま^1た&　 からかわれてるだけ&　 だよね！)/%",
  "scr_text_slash_scr_text_gml_6971_0": "\\E2＊ …今度は&　 どうやって解く？/",
  "scr_text_slash_scr_text_gml_7074_0": "\\EF＊ え？　わたしが…？/",
  "scr_text_slash_scr_text_gml_7075_0": "\\E8＊ えっと^1…　わたしが&　 おカネを出すってこと？/",
  "scr_text_slash_scr_text_gml_7076_0": "\\E9＊ ムリだよ^1…&　 そんな　おカネ…/",
  "scr_text_slash_scr_text_gml_7093_0": "\\E2＊ え^1…えぇ？/",
  "scr_text_slash_scr_text_gml_7094_0": "\\E3＊ だから^1…　そんな　おカネ　&　 ないってば。/",
  "scr_text_slash_scr_text_gml_7095_0": "\\E2＊ なに…^1？&　 わたしに　なにを&　 させたいの…？/",
  "scr_text_slash_scr_text_gml_7096_0": "\\EB＊ まさか^1…　でも…　そんな…/",
  "scr_text_slash_scr_text_gml_7325_0": "\\E3＊ 前進^1…って…/",
  "scr_text_slash_scr_text_gml_7326_0_b": "\\E2＊ どこへも　行けないよ？/",
  "scr_text_slash_scr_text_gml_7327_0_b": "\\E3＊ だって^1…&　 道が　ふさがってるでしょ？/",
  "scr_text_slash_scr_text_gml_7328_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7359_0": "\\EC＊ え…^1　どうしたの？/",
  "scr_text_slash_scr_text_gml_7360_0": "\\ED＊ ねえ…^1　大丈夫？/",
  "scr_text_slash_scr_text_gml_7361_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7392_0": "\\EC＊ あのね^1　電流が流れてて&　 道が…/",
  "scr_text_slash_scr_text_gml_7393_0": "\\EC＊ これ以上^1…　進んだら^1…&　 わたし…/",
  "scr_text_slash_scr_text_gml_7394_0": "\\ED＊ ねえ　クリス^1…&　 さっき　わたしが言ったこ^1と&　 聞こえてなかったよね？/",
  "scr_text_slash_scr_text_gml_7395_0": "\\ED＊ まさか^1…　わたしを…/",
  "scr_text_slash_scr_text_gml_7396_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7427_0": "\\EC＊ ク…/",
  "scr_text_slash_scr_text_gml_7428_0": "\\ED＊ クリ…ス…？/",
  "scr_text_slash_scr_text_gml_7429_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7454_0": "#買う",
  "scr_text_slash_scr_text_gml_7455_0": "#買わない",
  "scr_text_slash_scr_text_gml_7462_0": "＊ (自販機だ。&　 泉前フードが　売られている)&＊ (ベーグル１コ　$120。買う？)/",
  "scr_text_slash_scr_text_gml_7485_0": "＊ (どういうわけか^1…&　 おカネが　足りなかった)/%",
  "scr_text_slash_scr_text_gml_7497_0": "#なかま",
  "scr_text_slash_scr_text_gml_7498_0": "#アイテムそうこ",
  "scr_text_slash_scr_text_gml_7499_0": "操作",
  "scr_text_slash_scr_text_gml_7500_0": "読まない",
  "scr_text_slash_scr_text_gml_7503_0": "＊ (マニュアルだ。どの項目を読む？)/",
  "scr_text_slash_scr_text_gml_7511_0": "＊ 同じタイプの敵を　一定数以上&　 「にがす」か「スリープ」させると&　 その敵が　「なかま」になります。/",
  "scr_text_slash_scr_text_gml_7512_0": "＊ 「なかま」は　キャッスルタウンに&　 移住してきます。全員集めると&　 なにかが起きる…？/",
  "scr_text_slash_scr_text_gml_7513_0": "＊ なかまになる敵の情報は　各エリアの&　 セーブポイントで確認できます。&　 (一部のボスは除きます)/%",
  "scr_text_slash_scr_text_gml_7519_0": "＊ セーブポイントで&　「そうこ」メニューを&　 使えるようになりました。/",
  "scr_text_slash_scr_text_gml_7520_0": "＊ 「アイテム」を持ちきれなくなる^1と&　 以降　拾ったり買ったりしたものは&　 「そうこ」に送られます。/",
  "scr_text_slash_scr_text_gml_7521_0": "＊ しばらく使わなそうなアイテム^1は&　 「そうこ」に入れておくと&　 よいでしょう。/%",
  "scr_text_slash_scr_text_gml_7527_0": "＊ 操作のおさらいです。&　 (設定メニューで　変更もできます)/",
  "scr_text_slash_scr_text_gml_7528_0": "＊ ~1&＊ 「決定」「調べる」「使う」/",
  "scr_text_slash_scr_text_gml_7529_0": "＊ ~1&＊ 「キャンセル」「長押しで走る」&　 「全テキストを　一度に表示」/",
  "scr_text_slash_scr_text_gml_7530_0": "＊ ~1&＊ 「メニューを開く」「長押しで&　 テキストボックスをスキップ」/%",
  "scr_text_slash_scr_text_gml_7536_0": "＊ (本を読む時間なんてない)/%",
