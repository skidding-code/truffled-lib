  "obj_virovirokun_enemy_slash_Step_0_gml_331_0": "そうだよ",
  "obj_virovirokun_enemy_slash_Step_0_gml_344_0": "\\EH＊ …/%",
  "obj_virovirokun_enemy_slash_Step_0_gml_428_0": "＊ Ralsei cooked up a cure./",
