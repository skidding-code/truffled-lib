  "obj_tasque_manager_enemy_slash_Step_0_gml_19_0": "プロセス！　サービス！&ディテール！&パフォーマンス！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_23_0": "",
  "obj_tasque_manager_enemy_slash_Step_0_gml_27_0": "お洋服がシワシワ？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_30_0": "ネコ背？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_33_0": "サボりグセ？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_36_0": "ほどけたクツひも？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_39_0": "~1&ワタシのムチで&たたき直しましょう！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_46_0": "執事嬢…&ジツジジョウ…&…じゃなくて&秩序です！秩序なのです！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_46_1": "秩序です！&秩序なのです！",
