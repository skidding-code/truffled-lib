  "scr_text_slash_scr_text_gml_4096_0": "#べつの#だれか",
  "scr_text_slash_scr_text_gml_4097_0": "ようは　ない",
  "scr_text_slash_scr_text_gml_4098_0": " ",
  "scr_text_slash_scr_text_gml_4099_0": "＊ あ^1？　なんだよ^1？　ああんッ！？/",
  "scr_text_slash_scr_text_gml_4100_0": "＊ ブルっちを　さがしているな^1ら&　 ここには　いない！！/",
  "scr_text_slash_scr_text_gml_4101_0": "＊ …それとも　べつの　だれかを&　 さがしているのか？/",
  "scr_text_slash_scr_text_gml_4102_0": "\\C3 ",
  "scr_text_slash_scr_text_gml_4108_0": "＊ オレ^1？　オレと^1？　はなしたい！？/",
  "scr_text_slash_scr_text_gml_4109_0": "＊ こっちは　おまえと　はなすことなど&　 なにもないッ！/",
  "scr_text_slash_scr_text_gml_4110_0": "＊ そもそも　そんなショボくれた&　 かおに　みおぼえはないッ！/",
  "scr_text_slash_scr_text_gml_4111_0": "＊ でも^1　おとうさんには&　 よろしくいっといてー！/",
  "scr_text_slash_scr_text_gml_4112_0": "＊ …ん^1？　まて！^1！　いまのナシ^1！&　 あのおとこは　しらない…^1　オレが^1…&　 いや　なんでもないッ！！/%",
  "scr_text_slash_scr_text_gml_4129_0": "＊ …フン^1！　そうか^1！　そうなのか^1！&　 べつの　だれかと　はなしたい！？&　 だったら　とっとと　はなすがいい！/",
  "scr_text_slash_scr_text_gml_4130_0": "＊ …/",
  "scr_text_slash_scr_text_gml_4131_0": "＊ …え^1？&　 ボクと　はなしたいって　ひとが&　 きてる…？/",
  "scr_text_slash_scr_text_gml_4137_0": "＊ …また　キミか^1　こねこちゃん。/",
  "scr_text_slash_scr_text_gml_4138_0": "＊ やれやれ^1。&　 どうして　そんなに　なんども&　 うちを　たずねてくるんだい？/",
  "scr_text_slash_scr_text_gml_4139_0": "＊ ひょっとして^1…&　 ボクの　ファンだったりして？/",
  "scr_text_slash_scr_text_gml_4140_0": "＊ ハハ^1…　こんな　かげのうすい&　 いっぱんピーに　ファンなんて&　 いるはずないね。/",
  "scr_text_slash_scr_text_gml_4141_0": "＊ …/",
  "scr_text_slash_scr_text_gml_4142_0": "＊ そうだな^1…　もしキミが　ほんとうに&　 ボクの　ファンなら^1…&　 ひとつ　おねがいをしてもいいかい？/",
  "scr_text_slash_scr_text_gml_4146_0": "＊ …しらないひとの　いえのドアを&　 ノックするなん^1て&　 キミは　かわってるね。/",
  "scr_text_slash_scr_text_gml_4147_0": "＊ れいぎというものを&　 しらないのかい^1　こねこちゃん？/",
  "scr_text_slash_scr_text_gml_4148_0": "＊ まあ…/",
  "scr_text_slash_scr_text_gml_4149_0": "＊ ボクみたいに　かげのうすい&　 いっぱんピーには^1　おきゃくさんを&　 えらぶ　けんりなんて　ないか。/",
  "scr_text_slash_scr_text_gml_4150_0": "＊ …/",
  "scr_text_slash_scr_text_gml_4151_0": "＊ じゃあ^1　このきかいに&　 ひとつ^1　おねがいをしても&　 いいかい？/",
  "scr_text_slash_scr_text_gml_4154_0": "＊ インターネットが&　 ダウンしてからというも^1の&　 ボクは　うえているんだ…/",
  "scr_text_slash_scr_text_gml_4155_0": "＊ エンタメに。/",
  "scr_text_slash_scr_text_gml_4156_0": "＊ なんでもいい^1。たのしくなりそうな&　 ものを　みつけたら…/",
  "scr_text_slash_scr_text_gml_4157_0": "＊ ボクには　すごく&　 だいじなことなんだ^1。&　 たのんだよ^1　こねこちゃん。/%",
  "scr_text_slash_scr_text_gml_4160_0": "＊ …まだ　いたのかい　こねこちゃん。/",
  "scr_text_slash_scr_text_gml_4161_0": "＊ こんな　かげのうすい&　 いっぱんピーの　ボク^1に&　 ずいぶん　こだわるんだねえ。/",
  "scr_text_slash_scr_text_gml_4162_0": "＊ それじゃまるで　キミは^1…&　 ボクのファンみたいじゃないか。/",
  "scr_text_slash_scr_text_gml_4163_0": "＊ …もう　かえってくれるかな。/%",
  "scr_text_slash_scr_text_gml_4169_0": "＊ だったら　かえれ^1！　かえれ^1！&　 いますぐにッ！！/%",
