  "scr_text_slash_scr_text_gml_6951_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_6958_0": "\\EQ＊ クリス^1…　ノエルさんが&　 もどってきたら&　 どうするの…？/",
  "scr_text_slash_scr_text_gml_6960_0": "\\E5＊ そーだよ^1　あいつ&　 ノミがいるかもだぜ^1？&　 起きろよ！/%",
  "scr_text_slash_scr_text_gml_6966_0": "＊ (どうせ　自分のベッドじゃない)/%",
  "scr_text_slash_scr_text_gml_6993_0": "#館",
  "scr_text_slash_scr_text_gml_6994_0": "#サイバー#フィールド",
  "scr_text_slash_scr_text_gml_6995_0": "ゴミ捨て場",
  "scr_text_slash_scr_text_gml_6996_0": "キャンセル",
  "scr_text_slash_scr_text_gml_6999_0": "＊ (とびらだ^1)&＊ (どこへ行く？)/",
  "scr_text_slash_scr_text_gml_7026_0": "＊ (どういうわけ^1か&　 もう　そこにいる)/%",
  "scr_text_slash_scr_text_gml_7030_0": "＊ (とびらが　開いた…)/%",
  "scr_text_slash_scr_text_gml_7037_0": "#Yes",
  "scr_text_slash_scr_text_gml_7038_0": "#No",
  "scr_text_slash_scr_text_gml_7039_0": " ",
  "scr_text_slash_scr_text_gml_7040_0": " ",
  "scr_text_slash_scr_text_gml_7041_0": "＊ Choice text./",
  "scr_text_slash_scr_text_gml_7042_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7048_0": "＊ Result A./%",
  "scr_text_slash_scr_text_gml_7052_0": "＊ Result B./%",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_2_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_11_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_12_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_13_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_14_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_15_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_39_0": "…おまえ　剣持ってたのかよ！？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_42_0": "(かじったあとが　ある…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_64_0": "ああ…　いいにおい…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_86_0": "え… わたし　寒くないよ？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_105_0": "みんなの武器",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_106_0": "みんなにぴったり。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_107_0": "あー… おう",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_108_0": "ぴったりだね！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_109_0": "これって…　なに？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_132_0": "(ちょっと　かっこいい…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_154_0": "(すごい存在感…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_176_0": "え…？　笑いかけてきた…？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_194_0": "トレフォイル",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_195_0": "クローバーのエンブレムがついた#こけむしたレイピア。#獲得する$が5％増える。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_196_0": "やだよ　だっせぇ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_198_0": "オッケー！　…え？　「ボツ」？　どういうイミ！？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_220_0": "イタッ！　でも…　イヤじゃない",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_242_0": "やめて！　なんで着せようとするの！？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_260_0": "ツイストソード",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_261_0": "おかしな剣。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_262_0": "…なんだよこれ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_263_0": "ネジネジだね",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_264_0": "なんかちょっと…　怖い…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_282_0": "スノーリング",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_283_0": "雪の結晶のエンブレムがついた指輪。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_284_0": "ノエルのにおいがする",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_285_0": "…プロポーズするの？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_286_0": "(やっぱり　これが落ち着く…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_305_0": "いばらの指輪",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_306_0": "身につけると痛みでダメージを受けるかわりに#氷のまほうのTPコストが下がる。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_307_0": "拷問器具か…？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_308_0": "…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_309_0": " ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_328_0": "バウンスソード",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_329_0": "ゴムの刀身がついた　ピンク色の剣。#こうげき力は低いが　ぼうぎょ力がアップする。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_330_0": "なんだこれ　ゴムかよ？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_331_0": "やわらかくてプニプニしてる！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_332_0": "やめて！　たたかないで！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_351_0": "チアーマフラー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_352_0": "ポジティブで前向きなイメージの#カラフルなマフラー。#クリティカルダメージを受けたときに獲得するTPが増える。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_353_0": "スマイルマーク？　うぇ…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_354_0": "大丈夫！　キミならできる！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_355_0": "なにこのマフラー！　ダサーい！　ふはは！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_374_0": "メカセーバー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_375_0": "柄の部分を押すと刀身が伸びる。#カシャーン！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_376_0": "＊カシャカシャカシャ＊ …ケッ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_377_0": "クリスに　にあうと思うな！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_378_0": "＊カシャ＊ わあああ！　…びっくりした",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_397_0": "オートアックス",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_398_0": "かべのコンセントにつないで#充電するのを忘れずに。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_399_0": "＊ウィーン＊ ガハハハ！！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_400_0": "(大丈夫かな　これ…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_401_0": "＊ウィーン＊ わあああ！　…びっくりした",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_420_0": "クロスマフラー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_421_0": "ソフトなマイクロファイバー製のマフラー。#こうげき力と　まりょくをバランスよくアップ。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_422_0": "(やらかいな…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_423_0": "毛がバチバチいうよー…！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_424_0": "いいよ　装備す…　え？　これ　武器なの？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_443_0": "ダガマフ２",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_444_0": "するどくてチクチクするマフラー。#回復力ダウン　こうげき力アップ。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_445_0": "こりゃ　ラルセイのだな",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_446_0": "ボクは　チクチク王子だ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_447_0": "(サンタさんのヒゲみたいな感じかな…)",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_467_0": "折れた剣",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_468_0": "拒絶されて　まっぷたつにポッキリ折れた剣。#これはさすがに　装備できない…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_469_0": "…ゴミじゃねーか",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_470_0": "修理する…？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_471_0": "(え…　なんで　わたしに…？)",
  "obj_rudinnranger_slash_Step_0_gml_205_0": "＊ スージィは　わざと&　 敵を　ほめなかった！/",
  "obj_hatguy_enemy_slash_Draw_0_gml_60_0": "DANCING!",
  "obj_hatguy_enemy_slash_Draw_0_gml_65_0": "2 TURNS!",
  "obj_hatguy_enemy_slash_Draw_0_gml_70_0": "NOT DANCING",
  "obj_hatguy_enemy_slash_Step_0_gml_4_0": "(くたびれ)",
  "obj_kk_enemy_slash_Draw_0_gml_106_0": "DANCING!",
  "obj_kk_enemy_slash_Draw_0_gml_111_0": "2 TURNS!",
  "obj_kk_enemy_slash_Draw_0_gml_116_0": "NOT DANCING",
  "obj_kk_enemy_slash_Step_0_gml_3_0": "(くたびれ)",
  "obj_kk_enemy_slash_Step_0_gml_130_0": "＊ ミュージックの　ニオイがする。",
  "obj_readable_room1_slash_Other_10_gml_2837_0": "＊ サイバーシティへ　ようこそ^1！&　 道路を横断したい歩行者^1は&　 スイッチを押してください！/%",
  "obj_readable_room1_slash_Other_10_gml_2640_0": "＊ (信号機を使って　ブロックを正しく&　 回転させ^1　ネズミを解放すること^1は&　 この街の市民の務めです)/",
  "obj_readable_room1_slash_Other_10_gml_2641_0": "＊ ~1: アクセス／アクセス解除&＊ ~2 ~3: 回転&＊ ~4: リリース/%",
  "obj_ch2_scene25_slash_Step_0_gml_69_0": "\\EH＊ いたぞ！/%",
  "obj_ch2_scene25_slash_Step_0_gml_151_0": "\\E1＊ <!--アア&　 [おバカ]ナ　[子どもたち]:&　 [ナイスタイミング]-->/",
