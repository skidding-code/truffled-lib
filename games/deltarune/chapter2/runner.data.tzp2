  "scr_armorinfo_slash_scr_armorinfo_gml_75_0": "…見覚えがあるような。",
  "scr_armorinfo_slash_scr_armorinfo_gml_78_0": "イヤだっつってんだろ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_79_0": "オシャレするのって　いいよね…",
  "scr_armorinfo_slash_scr_armorinfo_gml_91_0": "かすりエリア",
  "scr_armorinfo_slash_scr_armorinfo_gml_105_0": "イヤだっつってんだろ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_106_0": "オシャレするのって　いいよね…",
  "scr_armorinfo_slash_scr_armorinfo_gml_108_0": "…見覚えがあるような",
  "scr_armorinfo_slash_scr_armorinfo_gml_130_0": "こういうオバケ　映画で見たな",
  "scr_armorinfo_slash_scr_armorinfo_gml_140_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_151_0": "…ネズミの絵が描いてある",
  "scr_armorinfo_slash_scr_armorinfo_gml_161_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_172_0": "(ステキなしっぽ…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_182_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_189_0": "シルバーカード",
  "scr_armorinfo_slash_scr_armorinfo_gml_190_0": "バトル後に手に入るおカネが５％増える。",
  "scr_armorinfo_slash_scr_armorinfo_gml_191_0": "カネ　オレの　ほしいもの",
  "scr_armorinfo_slash_scr_armorinfo_gml_192_0": "カードで　お買い物できる？",
  "scr_armorinfo_slash_scr_armorinfo_gml_193_0": "わたしの　うで時計と同じ色！",
  "scr_armorinfo_slash_scr_armorinfo_gml_203_0": "$ +5％",
  "scr_armorinfo_slash_scr_armorinfo_gml_210_0": "ツインリボン",
  "scr_armorinfo_slash_scr_armorinfo_gml_211_0": "２本のリボン。髪型をツインテールにしないと#装備できない。",
  "scr_armorinfo_slash_scr_armorinfo_gml_212_0": "…マジでカンベンしてくれ",
  "scr_armorinfo_slash_scr_armorinfo_gml_213_0": "ツノに巻くね！",
  "scr_armorinfo_slash_scr_armorinfo_gml_214_0": "…なつかしいな",
  "scr_armorinfo_slash_scr_armorinfo_gml_225_0": "かすりエリア",
  "scr_armorinfo_slash_scr_armorinfo_gml_232_0": "ライトブレス",
  "scr_armorinfo_slash_scr_armorinfo_gml_233_0": "緑色のワイヤー製のじょうぶなブレスレット。#とがったライトが　ちりばめられている。",
  "scr_armorinfo_slash_scr_armorinfo_gml_234_0": "こんがらがってるな…",
  "scr_armorinfo_slash_scr_armorinfo_gml_235_0": "ボクが　ほどいてあげるね…",
  "scr_armorinfo_slash_scr_armorinfo_gml_236_0": "ツリー用のライトみたい…",
  "scr_armorinfo_slash_scr_armorinfo_gml_247_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_254_0": "チェーンメイル",
  "scr_armorinfo_slash_scr_armorinfo_gml_255_0": "くさりを編んでつくったよろい。#10人に転送しないと　ぼうぎょ力を失う。",
  "scr_armorinfo_slash_scr_armorinfo_gml_256_0": "ダメだ…　こりゃ呪われたな…",
  "scr_armorinfo_slash_scr_armorinfo_gml_257_0": "手紙…？　ボクに…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_258_0": "よろい？(かっこいい…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_269_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_276_0": "Ｂ＊＊蝶タイ",
  "scr_armorinfo_slash_scr_armorinfo_gml_277_0": "上品な蝶ネクタイ。タグのブランド名が#切り落とされている。",
  "scr_armorinfo_slash_scr_armorinfo_gml_278_0": "オタクファッションかよ…",
  "scr_armorinfo_slash_scr_armorinfo_gml_279_0": "サスペンダーも　ほしいな",
  "scr_armorinfo_slash_scr_armorinfo_gml_280_0": "…これは　髪につけるのかな？",
  "scr_armorinfo_slash_scr_armorinfo_gml_291_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_298_0": "スパイクバンド",
  "scr_armorinfo_slash_scr_armorinfo_gml_299_0": "トゲトゲがビッシリついた　黒いリストバンド。#くっついて　こんがらがりがち。",
  "scr_armorinfo_slash_scr_armorinfo_gml_300_0": "トゲなら　なんでもウェルカムだぜ",
  "scr_armorinfo_slash_scr_armorinfo_gml_301_0": "どう…？　強そうに見える？",
  "scr_armorinfo_slash_scr_armorinfo_gml_302_0": "(スージィに気に入ってもらえるかな？)",
  "scr_armorinfo_slash_scr_armorinfo_gml_313_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_320_0": "銀のうで時計",
  "scr_armorinfo_slash_scr_armorinfo_gml_321_0": "バトルで弾をギリギリよけると#敵ターンの長さが短くなる(効果10％+)。",
  "scr_armorinfo_slash_scr_armorinfo_gml_322_0": "「おしおきの“時間”だぜ」",
  "scr_armorinfo_slash_scr_armorinfo_gml_323_0": "「遅刻だ　遅刻～！」",
  "scr_armorinfo_slash_scr_armorinfo_gml_324_0": "(こ…これ…　わたしの…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_342_0": "TP蝶タイ",
  "scr_armorinfo_slash_scr_armorinfo_gml_343_0": "バトル中に弾をギリギリかわして得られる#テンションの量が10％増える",
  "scr_armorinfo_slash_scr_armorinfo_gml_364_0": "マネキン",
  "scr_armorinfo_slash_scr_armorinfo_gml_365_0": "服を着たマネキン。服はしっかりくっついていて#どうやっても取れない。使い道ナシ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_366_0": "ノーコメントだ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_367_0": "ドレスはカワイイけど…",
  "scr_armorinfo_slash_scr_armorinfo_gml_368_0": "(なんで$300も払ったの…！？)",
  "scr_armorinfo_slash_scr_armorinfo_gml_386_0": "ダークＧバンド",
  "scr_armorinfo_slash_scr_armorinfo_gml_387_0": "黄金色に輝く　黒い金属製。",
  "scr_armorinfo_slash_scr_armorinfo_gml_388_0": "Not even gonna ask.",
  "scr_armorinfo_slash_scr_armorinfo_gml_389_0": "Um, the d-dress is cute...",
  "scr_armorinfo_slash_scr_armorinfo_gml_390_0": "(Why did they spend $300 on this!?)",
  "scr_armorinfo_slash_scr_armorinfo_gml_401_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_408_0": "スカイマント",
  "scr_armorinfo_slash_scr_armorinfo_gml_409_0": "ぼんやり光る蛍光マント。#電属性と聖属性のこうげきを防ぐ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_430_0": "トゲの手かせ",
  "scr_armorinfo_slash_scr_armorinfo_gml_431_0": " ",
  "scr_armorinfo_slash_scr_armorinfo_gml_432_0": "ヤベえ！　見ろよ　これ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_433_0": "うーん　トガッてるー！",
  "scr_armorinfo_slash_scr_armorinfo_gml_434_0": "(服のそでが破けちゃう…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_452_0": "ボロボロの蝶タイ",
  "scr_armorinfo_slash_scr_armorinfo_gml_453_0": "古ぼけた蝶ネクタイ。#ぼうぎょ力は　ほとんど失われているようだ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_454_0": "オレも一応　身だしなみは気にすんだよ",
  "scr_armorinfo_slash_scr_armorinfo_gml_455_0": "まだ使えるよ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_456_0": "(アズゴアおじさんっぽいな…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_467_0": " ",
  "scr_encountersetup_slash_scr_encountersetup_gml_60_0": "＊ テスト用の敵が現れた。",
  "scr_encountersetup_slash_scr_encountersetup_gml_551_0": "＊ Q-9が　クラクションを鳴らして&　 せまってきた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_568_0": "＊ ポップアップが　ポップアップした！",
  "scr_encountersetup_slash_scr_encountersetup_gml_585_0": "＊ タスクが　横切った！",
  "scr_encountersetup_slash_scr_encountersetup_gml_603_0": "＊ ケーブロイドが　ブラッと現れた。",
  "scr_encountersetup_slash_scr_encountersetup_gml_620_0": "＊ マウスたちに　行く手をふさがれた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_637_0": "＊ ウィルスンが　フワッと現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_640_0": "＊ First strike!",
  "scr_encountersetup_slash_scr_encountersetup_gml_661_0": "＊ パレットラーが&　 おじぎをしながら　現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_681_0": "＊ タスクマネージャーに&　 行く手を　ふさがれた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_695_0": "＊ バードリーが　乗り込んできた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_708_0": "＊ クイーンに　行く手を　ふさがれた！ ",
  "scr_encountersetup_slash_scr_encountersetup_gml_720_0": "＊ BIGになりたい　そこのｱnﾀ！",
  "scr_encountersetup_slash_scr_encountersetup_gml_732_0": "＊ さあ　[[BIG]]になろう！",
  "scr_encountersetup_slash_scr_encountersetup_gml_752_0": "＊ スイート・キャップ・ケーキが&　 立ちはだかった！",
  "scr_encountersetup_slash_scr_encountersetup_gml_776_0": "＊ ボコリングマシンが&　 しぶしぶ　バトルを開始した！",
  "scr_encountersetup_slash_scr_encountersetup_gml_791_0": "＊ パレットラーが&　 おじぎをしながら　現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_808_0": "＊ ケーブロイドロイドが&　 力強く　立ちふさがった！",
  "scr_encountersetup_slash_scr_encountersetup_gml_817_0": "＊ マウスが　行く手をふさいだ！",
  "scr_encountersetup_slash_scr_encountersetup_gml_831_0": "＊ え…ええっ！？&　 なにこれ！？",
  "scr_encountersetup_slash_scr_encountersetup_gml_848_0": "＊ ウィルスンとQ-9は　仲間割れしている！",
  "scr_encountersetup_slash_scr_encountersetup_gml_865_0": "＊ ウィルスンとQ-9は　仲間割れしている！",
  "scr_encountersetup_slash_scr_encountersetup_gml_882_0": "＊ ケモノの巣窟だ。",
  "scr_encountersetup_slash_scr_encountersetup_gml_892_0": "＊ クローバーが　ステージに現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_901_0": "＊ 身かわしアドベンチャー。",
  "scr_encountersetup_slash_scr_encountersetup_gml_915_0": "\\EE＊ え…！？　なにこれ！？&＊ なにが　始まったの！？",
  "scr_encountersetup_slash_scr_encountersetup_gml_935_0": "＊ ビュッフェスタイル　その２。",
  "scr_encountersetup_slash_scr_encountersetup_gml_955_0": "＊ ケーブロイドが　ブラッと現れた。",
  "scr_encountersetup_slash_scr_encountersetup_gml_975_0": "＊ ケーブロイドとマウスが&　 ケーブルアクションヒーローのように&　 ブラッと現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_992_0": "＊ Q-9と　そのペットが現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1012_0": "＊ ポップアップと世話係が現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1032_0": "＊ マウスたちに　行く手をふさがれた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1052_0": "＊ パレットラーと　害獣が現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1066_0": "＊ ケーブロイドロイドが&　 勇ましく行く手をふさいだ！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1076_0": "＊ バードリーに　行く手を　ふさがれた！ ",
  "scr_encountersetup_slash_scr_encountersetup_gml_1090_0": "＊ マウスホイールが　転がってきた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1104_0": "＊ ギガクイーンに　行く手を　ふさがれた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1114_0": " ",
  "scr_fusion_info_slash_scr_fusion_info_gml_11_0": "60HP回復x2",
  "scr_fusion_info_slash_scr_fusion_info_gml_23_0": "60HP回復x2",
  "scr_fusion_info_slash_scr_fusion_info_gml_34_0": "獲得$+5%",
  "scr_fusion_info_slash_scr_fusion_info_gml_45_0": "トランス",
  "scr_fusion_info_slash_scr_fusion_info_gml_56_0": "かすりエリア+",
  "scr_gamestart_slash_scr_gamestart_gml_19_0": "",
  "scr_gamestart_slash_scr_gamestart_gml_72_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_101_0_b": " ",
  "scr_gamestart_slash_scr_gamestart_gml_105_0": "ノエル",
  "scr_gamestart_slash_scr_gamestart_gml_231_0": "エキドナ",
  "scr_gamestart_slash_scr_gamestart_gml_282_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_293_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_297_0": "%%",
  "scr_gamestart_slash_scr_gamestart_gml_300_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_303_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_305_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_306_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_307_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_341_0": "",
  "scr_gamestart_slash_scr_gamestart_gml_353_0": " ",
  "scr_gamestart_slash_scr_gamestart_gml_356_0_b": "Yes",
  "scr_gamestart_slash_scr_gamestart_gml_357_0": "No",
  "scr_gamestart_slash_scr_gamestart_gml_358_0": "Maybe",
  "scr_gamestart_slash_scr_gamestart_gml_359_0": "Don't know",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_1_0": "---",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_5_0": "---",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_8_0": "40HP回復。赤と黒の星形キャンディ。#マシュマロみたいな味がする。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_11_0": "倒れた仲間のHPを全回復。#緑色をした　ミントの香りのクリスタル。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_14_0": "キラキラ輝くかけら。#使いみちは　わからない。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_17_0": "ラルセイの手作りマニュアル。#いろんなヒントや裏技が書いてある。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_20_0": "壊れてもなお　すさまじい気を発するケーキ。#鍛冶職人なら直せるだろう。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_23_0": "一口食べれば舌がクルクルおどる絶品ケーキ。#仲間全員のHPを160回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_27_0": "コマの形をした菓子パン。#仲間全員のHPを~1回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_30_0": "ナゾのハンバーガー。なぜか黒い…#と思ったらコゲてるだけだった！70HP回復",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_33_0": "ランサーの顔の形をしたクッキー。#じつはクッキーじゃないかも…　1HP回復？",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_36_0": "巨大なサラダ…というか#ただの使えないレタス。4HP回復",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_39_0": "3つに割れるサンドイッチ。#仲間全員のHPを70回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_42_0": "ハートの形のドーナツ。中の赤いジャムは#空気にふれると固まる。??HP回復",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_45_0": "かなり小さい。好きなひとは#なぜか　ものすごく好き。??HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_48_0": "パーフェクトな味。#500HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_51_0": "ほうじゅんな香りの黒っぽいルー。#ミミズ入り。50HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_54_0": "なかが鏡状の　歯ごたえバツグンのベーグル。#ひと口ごとに音を奏でる。80HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_57_0": "It's a mannequin with the clothes#permanently attached. Useless",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_60_0": "自分の味のティー。#「クリス味」とだけ書いてある。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_63_0": "自分の味のティー。#「ノエル味」とだけ書いてある。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_66_0": "自分の味のティー。#「ラルセイ味」とだけ書いてある。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_69_0": "自分の味のティー。#「スージィ味」とだけ書いてある。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_72_0": "ダブルダークバーガー。#２くちで食べよう！",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_75_0": "チョークっぽい食感の白いキャンディ。#120HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_78_0": "正式名称: 執事ジュース。#温度によって色が変わる。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_81_0": "熟練コード職人が編み出したスパゲティ。#マカロンとリボン入り。仲間全員30HP回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_84_0": "コーヒーチョコレート味のクッキー。#かむと文字があふれだす。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_87_0": "バトル中　TPを32%アップ。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_90_0": "バトル中　TPを50%アップ。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_93_0": "バトル中　TPを満タンにする。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_96_0": "ミントの香りの粉。#倒れた仲間全員を　HP25％で復活させる。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_99_0": "割って使えるミント。#倒れた仲間全員を　HP100％で復活させる。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_102_0": "色とりどりの正方形でできた水薬。#飲むと毒状態になる。",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_5_0": " ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_53_0": "CDベーグル",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_56_0": "マネキン",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_59_0": "クリスティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_62_0": "ノエルティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_65_0": "ラルセイティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_68_0": "スージィティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_71_0": "ダブルDバーガー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_74_0": "ライトキャンディ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_77_0": "シツジュース",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_80_0": "スパゲティコード",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_83_0": "Javaクッキー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_86_0": "テンションビッツ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_89_0": "テンションジェム",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_92_0": "テンションMAX",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_95_0": "リザレクトダスト",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_98_0": "リザレクトライト",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_101_0": "S.POISON",
  "scr_itemuse_slash_scr_itemuse_gml_42_0": "ベタベタしてる…？",
  "scr_itemuse_slash_scr_itemuse_gml_65_0": "ミント…？　大好き！",
  "scr_itemuse_slash_scr_itemuse_gml_96_0": "お誕生日おめでとう！　あはは！",
  "scr_itemuse_slash_scr_itemuse_gml_112_0": "目がまわる…",
  "scr_itemuse_slash_scr_itemuse_gml_132_0": "これ…ホンモノのお肉…？",
  "scr_itemuse_slash_scr_itemuse_gml_151_0": "これは…なんだろ。カワイイ…",
  "scr_itemuse_slash_scr_itemuse_gml_169_0": "モグモグしたい！",
  "scr_itemuse_slash_scr_itemuse_gml_179_0": "(クリスが３分の２　食べちゃった…)",
  "scr_itemuse_slash_scr_itemuse_gml_203_0": "ウソ…　この赤いのって…　血なの…！？",
  "scr_itemuse_slash_scr_itemuse_gml_229_0": "あ…　いいよ。クリスにもあげるね…",
  "scr_itemuse_slash_scr_itemuse_gml_247_0": "(クリスが　この味好きなんて…)",
  "scr_itemuse_slash_scr_itemuse_gml_265_0": "なんか…“なわとび”みたいな味…",
  "scr_itemuse_slash_scr_itemuse_gml_275_0": "ゴリッゴリだな",
  "scr_itemuse_slash_scr_itemuse_gml_279_0": "お上品だね！",
  "scr_itemuse_slash_scr_itemuse_gml_283_0": "ステキな曲…",
  "scr_itemuse_slash_scr_itemuse_gml_290_0": "＊ (The clothes are stuck to the doll...)/",
  "scr_itemuse_slash_scr_itemuse_gml_291_0": "＊ (There's no way you can use this.)/%",
  "scr_itemuse_slash_scr_itemuse_gml_303_0": "(反応ナシか？)",
  "scr_itemuse_slash_scr_itemuse_gml_304_0": "(反応ナシ…？)",
  "scr_itemuse_slash_scr_itemuse_gml_309_0": "リンゴジュースだ！！",
  "scr_itemuse_slash_scr_itemuse_gml_310_0": "ちょ…　ゆっくり飲んで！",
  "scr_itemuse_slash_scr_itemuse_gml_315_0": "ブルーベリーの味！",
  "scr_itemuse_slash_scr_itemuse_gml_316_0": "は？　マジかよ",
  "scr_itemuse_slash_scr_itemuse_gml_320_0": "シナモンの味！(…でも　あと味がヘン…？)",
  "scr_itemuse_slash_scr_itemuse_gml_332_0": "(…なんだよ　その顔)",
  "scr_itemuse_slash_scr_itemuse_gml_333_0": "(飲んでるね…)",
  "scr_itemuse_slash_scr_itemuse_gml_334_0": "(え…　なに　その顔)",
  "scr_itemuse_slash_scr_itemuse_gml_339_0": "エッグノグだ！！",
  "scr_itemuse_slash_scr_itemuse_gml_340_0": "ちょ…　ゆっくり飲んで！",
  "scr_itemuse_slash_scr_itemuse_gml_345_0": "やさしくて　あまーい味",
  "scr_itemuse_slash_scr_itemuse_gml_349_0": "…ただの水だよ！　からかわれてる！？　",
  "scr_itemuse_slash_scr_itemuse_gml_361_0": "(反応ナシか？)",
  "scr_itemuse_slash_scr_itemuse_gml_362_0": "(うれしいな！)",
  "scr_itemuse_slash_scr_itemuse_gml_367_0": "お　マシュマロ味だ！",
  "scr_itemuse_slash_scr_itemuse_gml_368_0": "ちょ…　ゆっくり飲んで！",
  "scr_itemuse_slash_scr_itemuse_gml_373_0": "これって…　ただの水じゃない？",
  "scr_itemuse_slash_scr_itemuse_gml_377_0": "なにも入ってないよ！",
  "scr_itemuse_slash_scr_itemuse_gml_389_0": "なんでオレを見るんだよ！",
  "scr_itemuse_slash_scr_itemuse_gml_390_0": "(気に入ったみたいだね)",
  "scr_itemuse_slash_scr_itemuse_gml_395_0": "これ…　茶なのか？",
  "scr_itemuse_slash_scr_itemuse_gml_400_0": "グレープジュースだ！",
  "scr_itemuse_slash_scr_itemuse_gml_401_0": "は？　マジかよ",
  "scr_itemuse_slash_scr_itemuse_gml_405_0": "(ボトルで売ってないのかな？)",
  "scr_itemuse_slash_scr_itemuse_gml_418_0": "残り　食わせろよ！",
  "scr_itemuse_slash_scr_itemuse_gml_422_0": "残りは　スージィにあげたら？",
  "scr_itemuse_slash_scr_itemuse_gml_427_0": "まだ残ってるの…！？",
  "scr_itemuse_slash_scr_itemuse_gml_438_0": "こりゃサイコーだな！",
  "scr_itemuse_slash_scr_itemuse_gml_442_0": "とってもチョークっぽい味！",
  "scr_itemuse_slash_scr_itemuse_gml_446_0": "(これって…　スージィにあげたチョーク…？)",
  "scr_itemuse_slash_scr_itemuse_gml_456_0": "ヘンな名前だな",
  "scr_itemuse_slash_scr_itemuse_gml_460_0": "ボクが作ったんだ",
  "scr_itemuse_slash_scr_itemuse_gml_464_0": "頭がキーンとする…！　…なーんてね",
  "scr_itemuse_slash_scr_itemuse_gml_472_0": "オレは装備しねーぞ",
  "scr_itemuse_slash_scr_itemuse_gml_473_0": "カワイイ！",
  "scr_itemuse_slash_scr_itemuse_gml_474_0": "わたしの持ってるセーターみたい",
  "scr_itemuse_slash_scr_itemuse_gml_487_0": "「ガッツ」って書いてあるぞ！",
  "scr_itemuse_slash_scr_itemuse_gml_491_0": "「モフさ」って書いてある…",
  "scr_itemuse_slash_scr_itemuse_gml_495_0": "この記号は…　解読できないよ…",
  "scr_itemuse_slash_scr_itemuse_gml_504_0": "＊ (テンションが　上がった)/",
  "scr_itemuse_slash_scr_itemuse_gml_505_0": "＊ (…バトル中に使ったほうが&　 よさそうだ)/%",
  "scr_itemuse_slash_scr_itemuse_gml_512_0": "＊ (テンションが　上がった)/",
  "scr_itemuse_slash_scr_itemuse_gml_513_0": "＊ (…バトル中に使ったほうが&　 よさそうだ)/%",
  "scr_itemuse_slash_scr_itemuse_gml_520_0": "＊ (テンションが　上がった)/",
  "scr_itemuse_slash_scr_itemuse_gml_521_0": "＊ (…バトル中に使ったほうが&　 よさそうだ)/%",
  "scr_itemuse_slash_scr_itemuse_gml_529_0": "ヘンな粉かけんなよ！",
  "scr_itemuse_slash_scr_itemuse_gml_530_0": "ミントのかおり！",
  "scr_itemuse_slash_scr_itemuse_gml_531_0": "なにを　ふりまいてるの…？",
  "scr_itemuse_slash_scr_itemuse_gml_538_0": "オレにミント投げんなよ！",
  "scr_itemuse_slash_scr_itemuse_gml_539_0": "ミントのかおり！",
  "scr_itemuse_slash_scr_itemuse_gml_540_0": "なにを投げてるの…？",
  "scr_itemuse_slash_scr_itemuse_gml_553_0": "ウゲッ！　…あれ？　うまいな",
  "scr_itemuse_slash_scr_itemuse_gml_557_0": "う…　あ…ありがと　クリス！",
  "scr_itemuse_slash_scr_itemuse_gml_561_0": "(とりあえず…　飲むフリだけ…)",
  "scr_itemuse_slash_scr_itemuse_gml_616_0": "＊ ジェムを　目の前にかかげた。/",
  "scr_itemuse_slash_scr_itemuse_gml_617_0": "＊ なぜか^1　ほんの一瞬…/",
  "scr_itemuse_slash_scr_itemuse_gml_618_0": "＊ パソコンルームが　見えた気がした。/",
  "scr_itemuse_slash_scr_itemuse_gml_619_0": "＊ …でも^1　きっと気のせいだ。/%",
  "scr_itemuse_slash_scr_itemuse_gml_624_0": "＊ ジェムを　目の前にかかげた。/",
  "scr_itemuse_slash_scr_itemuse_gml_625_0": "＊ しかし^1　なにも起こらなかった。/%",
  "scr_itemuse_slash_scr_itemuse_gml_629_0": "＊ 使いみちは　なさそうだ。/%",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_2_0": "---",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_3_0": " ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_9_0": "---",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_10_0": " ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_43_0": "ホッホッホ！　ボクさまは　じょうぶな子だ！#アイテムあつかいしてくれて　けっこうだぞ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_46_0": "ホッホッホ！　ルールノーはポケットから#(サブ)パパッと飛び出したゾ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_48_0": "ランサー",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_52_0": "なんじの見るはまことのイケメン。豪胆なる鬼才#にして天が下の民草より崇めあ待ってまだ続きが",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_53_0": "ﾙｰﾙﾉｰ･ｶｧﾄﾞｰ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_56_0": "ナゾのマシンから手に入れたデータ保存用#ディスク。だれかが欲しがっていたような…",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_57_0": "ﾌﾞﾗﾝｸﾃﾞｨｽｸ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_60_0": "ナゾのディスク。#手に持つと　ほほ笑みの感触が伝わってくる。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_61_0": "ﾃﾞｰﾀﾃﾞｨｽｸ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_64_0": "怪しげなプログラム。#あるとびらのカギを開けることができる。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_65_0": "キー生成キ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_70_0": "手のなかで　するどい影が　水のように#うごめく。~1 個入手済み。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_71_0": "シャドウジェム",
  "scr_litemdesc_slash_scr_litemdesc_gml_39_0": "＊ 「トランプ」 - スペードのジャック^1と&　 ルールのカード。/%",
  "scr_litemdesc_slash_scr_litemdesc_gml_42_0": "＊ 「ハートのハコいりチョコ」 -&　 じぶんのじゃない^1。&　 けど　それがどうした？/%",
  "scr_litemdesc_slash_scr_litemdesc_gml_45_0": "＊ ポケットに&　 なにかの　ちいさな　かけらが&　 はいっている。/",
  "scr_litemdesc_slash_scr_litemdesc_gml_46_0": "＊ ガラスのような　しつかんだけど…？/%",
  "scr_litemname_slash_scr_litemname_gml_6_0": "ホットチョコレート",
  "scr_litemname_slash_scr_litemname_gml_7_0": "エンピツ",
  "scr_litemname_slash_scr_litemname_gml_8_0": "ばんそうこう",
  "scr_litemname_slash_scr_litemname_gml_9_0": "はなたば",
  "scr_litemname_slash_scr_litemname_gml_10_0": "ゴミのかたまり",
  "scr_litemname_slash_scr_litemname_gml_11_0": "ハロウィンエンピツ",
  "scr_litemname_slash_scr_litemname_gml_12_0": "ラッキーエンピツ",
  "scr_litemname_slash_scr_litemname_gml_13_0": "タマゴ",
  "scr_litemname_slash_scr_litemname_gml_14_0": "トランプ",
  "scr_litemname_slash_scr_litemname_gml_15_0": "ハコいりハートチョコ",
  "scr_litemname_slash_scr_litemname_gml_16_0": "ガラス",
  "scr_litemuseb_slash_scr_litemuseb_gml_69_0": "＊ トランプを　とりだした^1。&＊ ゆびで　もった　かんしょくは&　 とても　うすっぺらい。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_107_0": "＊ え？　ハートの&　 ハコいりチョコ？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_108_0": "\\E3＊ あー。そういうことか。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_109_0": "\\E2＊ ヘヘ。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_110_0": "＊ いやー。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_111_0": "\\E0＊ アンタってやつは…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_112_0": "＊ んー。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_113_0": "\\E1＊ まー。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_114_0": "\\E0＊ …しょうがないな。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_115_0": "\\E3＊ へんぴん&　 したいんだろ？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_116_0_b": "\\E5＊ いいって^1　いいって^1。&　 オイラ　べつに&　 きずつかないよ。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_117_0_b": "\\E0＊ ほら。５ドル。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_119_0": "＊ (チョコレートを　わたして&　 ５ドル　うけとった)/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_123_0": "＊ (アルフィーに　はなしかければ&　 チョコレートを　わたせる)/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_131_0": "\\E7＊ おい^1！&　 どこで　みつけてきたんだよ&　 それ！/",
  "scr_litemuseb_slash_scr_litemuseb_gml_132_0": "\\E6＊ …あ？　「もらった」？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_133_0": "\\EY＊ ガーッハッハッ^1！&　 まーたまた^1！&　 どーせ　ぬすんだんだろ！？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_134_0": "\\E2＊ うし^1　とっとと　くっ^1て&　 しょうこは&　 かくしちまおうぜ！/",
  "scr_litemuseb_slash_scr_litemuseb_gml_136_0_b": "＊ (スージィと　いっしょに&　 ハートのハコいりチョコをたべた)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_137_0_b": "＊ (ふたりとも　むねに&　 こみあげるものが　あった…)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_139_0": "\\EC＊ うげっ^1…　はらが…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_141_0": "＊ (…それは　「いちどに　ぜんぶ&　 たべたのは　まちがいだった」という&　 こうかいの　きもちだ)/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_149_0": "＊ (ハートのハコいりチョコを&　 ためらうことなく　むさぼった)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_150_0": "＊ (おなかが　やられた)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_151_0": "＊ (これもまた　じんせいと&　 うけいれた…)/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_168_0_b": "＊ ガラスを　とおして&　 むこうを　みた。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_169_0": "＊ なぜか^1　ほんの　いっしゅん…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_170_0_b": "＊ スージィが^1　つめたい　まなざしで&　 じぶんを　にらんでいるように&　 みえた^1…きがした。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_171_0_b": "＊ ガラスを　どけてみた…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_172_0_b": "＊ スージィが　わらいながら&　 げひんなポーズをして&　 こちらを　みている。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_178_0": "＊ ガラスを　とおして&　 むこうを　みた。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_179_0": "＊ …しかし　なにも　おこらなかった。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_182_0": "＊ なにかの　やくに&　 たちそうには　みえない。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_271_0": "＊ (プルルル^1　プルルル…)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_273_0": "\\M1\\E1＊ あら^1　ごめんなさい^1。&　 でんわだわ。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_274_0": "\\E0＊ クリス…^1？&　 どうしたの？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_275_0": "\\E3＊ え^1？　あなたは&　 「フツー」？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_276_0": "\\E3＊ え^1？&　 「ゴミのオーブ」を&　 つくったの？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_277_0": "\\E4＊ …それは　どういう&　 イミかしら^1。せつめい&　 してくれる？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_279_0": "\\E6＊ (ややややめて　クリス^1！&　 せんせいに　でんわ&　 わたさないで…！！)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_281_0": "\\E1＊ え^1？　あとで&　 としょかんに　いくの？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_282_0": "\\E0＊ そう^1。ちゃんと　おしえて&　 くれて　ありがとう^1。&　 いってらっしゃい！/",
  "scr_litemuseb_slash_scr_litemuseb_gml_284_0": "\\M0＊ ツー…/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_289_0": "＊ (プルルル^1　プルルル…)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_291_0": "\\M1\\E1＊ クリス^1　としょかんへは&　 いきたいときに&　 いっていいのよ。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_293_0": "\\M0＊ ツー…/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_302_0": "＊ (プルルル^1　プルルル…)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_304_0": "\\E0＊ あら　クリス^1！　え…^1？&　 これから　がっこうの&　 かだいを　やるの…？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_305_0": "\\E1＊ …ああ　わかったわ^1！&　 ママに　てつだって&　 ほしいのね！？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_306_0": "\\E4＊ じゃあ^1　てづくりの&　 かおりつきノリを&　 さがしてこなきゃ！/",
  "scr_litemuseb_slash_scr_litemuseb_gml_307_0": "\\E8＊ …え^1？&　 こんどの　かだい^1は&　 おともだちと…？/",
  "scr_litemuseb_slash_scr_litemuseb_gml_308_0": "\\E9＊ まあ！^1　じゃあ&　 その　おともだちにも…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_309_0": "\\E4＊ バタースコッチのかおりの&　 ノリ^1　きにいってもらえると&　 いいわねえ！/",
  "scr_litemuseb_slash_scr_litemuseb_gml_311_0": "＊ ツー…/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_317_0": "＊ (プルルル^1　プルルル…)/",
  "scr_litemuseb_slash_scr_litemuseb_gml_319_0": "\\E0＊ クリス^1　としょかんへは&　 いきたいときに&　 いっていいのよ。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_320_0": "\\E5＊ バードリーが&　 「かりを　かえせ」って&　 しつこく　いってきたら…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_321_0": "\\E4＊ ママが　かけつけ^1て&　 けむりだまを　なげるか^1ら&　 そのスキに　にげなさい。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_322_0": "\\E0＊ …フフフ^1。なんてね。&　 じょうだんよ^1！&　 がんばってね。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_324_0": "＊ ツー…/%",
