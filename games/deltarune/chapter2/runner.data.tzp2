  "scr_iteminfo_slash_scr_iteminfo_gml_234_0": "S.POISON",
  "scr_iteminfo_slash_scr_iteminfo_gml_235_0": "味方に#ダメージ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_50_0": "ホッホッホ！　楽しそうなゲームだったぞ！#次は　ボクさまが　イスやる番！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_54_0": "ミルクっぽい　ペチャッって音がしたぞ！#さてはナイショで　ミルクを吸収してたな！？",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_58_0": "ボクさま　とっても丈夫なコ！#落ちてもヘッチャラ　無傷だヨ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_62_0": "ふた手に分かれて　事件を解決！#こっちは　だまって　モクモク前進！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_66_0": "ホッホッホ！　ソフトクリームが仲間になった！#そいつは　悪モノになってくれるかな？",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_70_0_b": "あの黄金の像…　あれはおそらく…#疑似乳首法で製作されたものだぞ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_74_0": "無料のサンプル　うれしいな！#もう　ひと口も　食べられない！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_79_0": "ショボッショボの　青いトリ。#飛べ　飛べ　空高く！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_83_0": "ボクさま　なにか見逃した？#自重トレーニング中で見てなかったぞ。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_87_0": "テープを食べて　おなかいっぱい！　ボクさまの#おなかを押してみて！　音楽が流れるヨ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_91_0": "ホッホッホ！　ボクさまを自由にしてくれたら#自由にしてあげちゃうぞ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_95_0": "(無垢な少年たちは#ぐっすり眠っている)",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_123_0": "スターウォーカー",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_124_0": "オリジナルの                     #         (スターウォーカー)",
