voice=you
3.08=<caption=true>*mumbling*
6.5=No!
7.88=This... this is...
10.0=...impossible!

[SFX\SCP\012\Speech7.ogg]
voice=you
0.07=<caption=true>*pain!*
0.89=<caption=true>*mumbling*
