{
  "id" : "apex_mission1",
  "mainQuest" : true,
  "prerequisites" : [ "avian_mission2" ],
  "title" : "Find Clues to Locate the Apex Artifact",
  "text" : "I think we should begin our hunt for the ^orange;Apex artifact^reset;. The Apex are generally found on ^orange;frozen planets^reset; around ^orange;frozen stars^reset;, so those are ^green;the best places to search for the ^orange;clues^green; we need^reset;. Wrap up warm dear, and remember: Apex society is in upheaval at the moment, so be on your guard.",
  "completionText" : "You've found all the clues we need to locate the Apex artifact! This is brilliant, dear - we've come so far.",
