[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
#var z=preload(\"res://-Scenes/AppZ/Z.tscn\")
#var t = z.instance()


var tab1_preload = preload(\"res://-Scenes/Application001/Main/1.tscn\")
func refreshZ():
	pass
	#get_node(\"Z\").queue_free()
	#add_child(z.instance())

func _add_child(n,i):
	if i == 1:
		#print(\"attempt add kinito from preload\")
		get_node(str(n)).add_child(tab1_preload.instance())
	
	else:
		get_node(str(n)).add_child(load(  (\"res://-Scenes/Application%s/Main/1.tscn\") % str(str(i).pad_zeros(3)) ).instance())

func _res_add_child(n,res):
	get_node(str(n)).add_child(load(  str(res)  ).instance())

func _rem_current(current):
	#print(\"removing child: \",current)
	print(get_node(str(current)).get_children())
	for child in get_node(str(current)).get_children():
	#	print(child.name,\"  removing....\")
		child.queue_free()
	#get_node(str(current)).get_child(0).queue_free()
	

func remCam():
	$Camera2D.defualt = true
	$Camera2D.position = Vector2(0,0)
	$Camera2D.offset = Vector2(0,0)
	$Camera2D.anchor_mode = Camera2D.ANCHOR_MODE_FIXED_TOP_LEFT
	

func addCam():
	$Camera2D.defualt = false
	$Camera2D.position = Vector2(960,540)
	$Camera2D.anchor_mode = Camera2D.ANCHOR_MODE_DRAG_CENTER
#	$Camera2D.current
#	$Camera2D.visible = inp







var MouseSFX = true
var memorys = false
func _ready():
	if Vars.get(\"postDarkMode\") == true:
		if not App.singleWindow:
			OS.window_size = Vector2(5,5)
			OS.window_minimized = true
		Wallpaper.call(\"M2\")
		yield(get_tree().create_timer(5.0,false), \"timeout\")
		Wallpaper.call(\"M1\")
		if not App.singleWindow:
			# Restores the window the 5x5 shrink above collapsed. Neither half runs
			# here, so there is nothing to put back.
			OS.window_size = App.initSize
			if App.windowedMode:
				OS.window_position = Vector2.ZERO
				OS.window_borderless = false
		else:
			OS.window_borderless = true
			OS.center_window()
		Tab._start()
		$Camera2D._ready()
		Tab.open(0)
		Tab.scene(\"res://-Scenes/Application000/Main/PC.tscn\")
		OS.window_minimized = false
		
		Data._save(\"sp\",10)
		pass
	
	
	if(App.memorys != 0):
		memorys = false 
	
	
	
	#OS.window_size = Vector2(OS.get_screen_size().x,OS.get_screen_size().y-1)
	
	if(App.windowedMode == false and not App.singleWindow):
		OS.window_size = App.initSize
		#OS.window_size = App.initSize
		OS.window_position = Vector2(0,0)
		#Vars.set(\"ScreenSize\",OS.get_screen_size())
	#
	#Vars.set(\"ScreenSize\",App.originialScreenSize)
	# NOT OS.window_size. Under the fixed 1920x1080 stretch, the window can be any
	# size and any aspect; ScreenSize has to stay the size of the space the game
	# actually lays out in, or everything that centres against it aims at the wrong
	# midpoint (the power button ended up ~460px right of centre this way).
	Vars.set(\"ScreenSize\",App._renderSize())
	
	Tab._start()
	Tab.open(0)
	if(memorys == false):

		Tab.queueapp(11,true)
		Tab.queueapp(12,true)
		
		
		#Important preload
		Tab.queueapp(10,true)
		Tab.queueapp(1,true)
		Tab.queueapp(5,true)
		Tab.queueapp(7,true)
	
	Vars.set(\"player_name\",Data.data[\"name\"])
	if(Data.data[\"namefound\"] == 1):
		Vars.set(\"name_valid\",false)
	elif((Data.data[\"namefound\"] == 2)):
		Vars.set(\"name_valid\",true)



var optionOPEN = false
var settingFocus = false
var msgBoxFocus = false
var inputBoxFocus = false


	


func _process(delta):
	
#	if(Tab.RealScreenEffect == true):
#		get_node(\"Z/ScreenEffect/Node2D/Screen\")
#		get_node(\"Z/ScreenEffect\").visible = true
#		pass
	if(memorys == false):
		_mouseSFX()
	
	optionOPEN = Tab.data[\"open\"][10]

	if(settingFocus == false):
		if(Tab.isfocus() == 7):
			settingFocus = true
	else:
		if(Tab.isfocus() != 7):
			settingFocus = false
	
	if(msgBoxFocus == false):
		if(Tab.isfocus() == 11):
			msgBoxFocus = true
	else:
		if(Tab.isfocus() != 11):
			msgBoxFocus = false
	
	if(inputBoxFocus == false):
		if(Tab.isfocus() == 12):
			inputBoxFocus = true
	else:
		if(Tab.isfocus() != 12):
			inputBoxFocus = false
	
	if(inputBoxFocus or msgBoxFocus or settingFocus or optionOPEN):
		Tab.mouseOveride = true
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	else:
		Tab.mouseOveride = false
	
#			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
#			Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)

func _input(event):
	if event is InputEventMouseButton:
		if event.is_pressed():
			if(MouseSFX == true):
				if event.button_index == BUTTON_WHEEL_UP:
					$Z/Mouse/Wh.play()
				if event.button_index == BUTTON_WHEEL_DOWN:
					$Z/Mouse/Wh.play()

func _mouseSFX():
	if(MouseSFX == true):
		if(Input.is_action_just_pressed(\"click\")):
			$Z/Mouse/D1.play()
			$Z/Mouse/D1.pitch_scale = 1
		elif(Input.is_action_just_released(\"click\")):
			$Z/Mouse/U1.play()
			$Z/Mouse/D1.pitch_scale = 1
		if(Input.is_action_just_pressed(\"click2\")):
			$Z/Mouse/D1.play()
			$Z/Mouse/D1.pitch_scale = 1.1
		elif(Input.is_action_just_released(\"click2\")):
			$Z/Mouse/U1.play()
			$Z/Mouse/D1.pitch_scale = 1.1
"

[sub_resource type="GDScript" id=2]
script/source = "extends Camera2D

var shake_amount = 0.0
var zoom_amount = 1.0
var zoom_tab = -1
var zoom_offset = Vector2(0,0)
var bg_active = false
var scaledPos = Vector2(0,0)
var middle = Vector2(0,0)

export var defualt = false

onready var screen_scale = Vars.get(\"nodeScale\")
var screenSize = Vector2(0,0)

func _relayout():
	# The camera defines the visible area, so it has to follow the window. It was
	# only ever computed once, which pinned the whole view to whatever resolution
	# the scene happened to open at.
	_go()

func _go():
	
	screen_scale = Vars.get(\"nodeScale\")
	
	
	screenSize = Vars.get(\"ScreenSize\")
	if screenSize == null:
		screenSize = App._renderSize()
	#screenSize = App.originialScreenSize
	limit_bottom = screenSize.y
	limit_right = screenSize.x
	middle = Vector2(screenSize.x/2  , screenSize.y/2  ) 
	position = middle
	print(\"middle: \",middle,\"  zoom:\",zoom,\"  screensize:\",screenSize,\"  screenscale:\",screen_scale)
	zoom = screen_scale

func _ready():
	if App.windowedMode:
		if App.windowedReady == false:
			yield(get_tree(),\"idle_frame\")
	if Vars.get(\"nodeScale\") == null:
		yield(get_tree(),\"idle_frame\")
	print(\"Camera Update\")
	add_to_group(\"relayout\")
	_go()
	pass



func _process(delta):
	if defualt == false:
		# nodeScale is wiped wholesale by Tab.changeSP() (Vars.global = {}) and is
		# not set at all until Tab._ready() has run, so it can legitimately be null
		# for a frame. Reading .x off it then took the whole camera down.
		if screen_scale == null:
			screen_scale = Vars.get(\"nodeScale\")
			if screen_scale == null:
				return
		if(Tab.CameraOveride == true):
			current = false
		else:
			current = true
		
		shake_amount = Tab.effects[\"shake\"] / screen_scale.x
		zoom_amount = Tab.effects[\"zoom\"] / screen_scale.x
		zoom_tab = Tab.effects[\"zoom_tab\"]
		zoom_offset = Tab.effects[\"zoom_offset\"] / screen_scale
		
		if(Tab.effects[\"zoom\"] != 1.0):
			zoom = Vector2(float(1/zoom_amount),float(1/zoom_amount)) / screen_scale
			scaledPos = middle
			if(zoom_tab != -1):
				offset = zoom_offset
				scaledPos = (Tab.window_position(zoom_tab)) / screen_scale
			position = scaledPos 
		
		if(shake_amount > 0.0):
			position  = scaledPos+Vector2(rand_range(-1.0,1.0)*shake_amount,rand_range(-1.0,1.0)*shake_amount)

		if(Tab.effects[\"zoom\"] == 1.0 and shake_amount <= 0.0):
			position = middle
			zoom =  Vector2(float(1/zoom_amount),float(1/zoom_amount)) / screen_scale
			offset = Vector2(0,0)
	else:
		offset = Vector2(0,0)
"

