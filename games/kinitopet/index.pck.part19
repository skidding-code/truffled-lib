[sub_resource type="GDScript" id=21]
script/source = "extends AnimationPlayer
export var backgroundeffect = false
var listenin = false

func _process(delta):
	if backgroundeffect:
		backgroundeffect = false
		yield(get_tree().create_timer(0.3), \"timeout\")
		Wallpaper.call(\"M5\")
		yield(get_tree().create_timer(2.5), \"timeout\")
		Wallpaper.call(\"M2\")

func _ready():
	get_tree().connect(\"files_dropped\", self, \"_on_files_dropped\")

func _on_files_dropped(files, screen):
	if listenin:
		var file = files[0]
		var split = files[0].split(\"\\\\\")
		var reRaw = split[split.size()-1].split(\".\")[0]
		var name = \"error\"
		var data = \"404\"
		var makefile = true
		print(reRaw)
		if reRaw == str((str(\"1\")+OS.get_unique_id()).sha1_text()).left(15):
			self.play(\"Decode\")
			name = \"credentials.txt\"
			data = \"[sonny_c]\"
		elif reRaw == str((str(\"2\")+OS.get_unique_id()).sha1_text()).left(15):
			self.play(\"Decode\")
			name = \"server.txt\"
			data = \"[kinito_\"+str((str(\"server\")+OS.get_unique_id()).sha1_text()).left(5)+\"]\"
		elif reRaw == str((str(\"3\")+OS.get_unique_id()).sha1_text()).left(15):
			self.play(\"Decode\")
			name = \"password.txt\"
			data = \"hello_world123\"
		elif reRaw == str((str(\"4\")+OS.get_unique_id()).sha1_text()).left(15):
			self.play(\"Decode\")
			name = \"access.txt\"
			data = \"[\"+str((str(\"access\")+OS.get_unique_id()).sha1_text()).left(15)+\"]\"
		elif reRaw == str((str(\"5\")+OS.get_unique_id()).sha1_text()).left(15):
			self.play(\"Decode\")
			name = \"confirmatory.txt\"
			data = \"[\"+str((str(\"confirmatory\")+OS.get_unique_id()).sha1_text()).left(25)+\"]\"
		else:
			makefile = false
		
		if makefile:
			_makeFile(name,data,reRaw)
		
		listenin = false

func _makeFile(name,data,reRaw):
	yield(get_tree().create_timer(11), \"timeout\")
	var dir = Directory.new()
	dir.open(\"user://\")
	if(dir.file_exists(\"Files\") == false):
		dir.make_dir(\"Files\")
	var file = File.new()
	file.open(\"user://Files/\"+str(name), File.WRITE)
	file.store_string(str(data))
	file.close()
	
	dir.remove(\"user://Files/\"+str(reRaw)+\".encrypted\")
	listenin = true

func _on_Start_animation_finished(anim_name):
	listenin = true
"

