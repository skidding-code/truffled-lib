[sub_resource type="GDScript" id=1]
script/source = "extends Node
func _ready():
	if not App.singleWindow:
		# The game normally floats over your desktop in a transparent window. With
		# one window there is nothing behind us, and on the web a transparent root
		# viewport makes everything composited through it - which is every
		# sub-viewport in the game, Kinito included - render black.
		get_tree().get_root().set_transparent_background(true)
		OS.window_per_pixel_transparency_enabled = true
	OS.set_window_title(\"LOADING... (please wait) [KinitoPET.exe]\")
	if(App.current == 0):
		if not App.singleWindow:
			# Shrinking to a 30x30 window while loading resizes the canvas on web.
			OS.window_size = Vector2(30,30)
			OS.center_window()
		#OS.window_size = Vector2(OS.get_screen_size().x,OS.get_screen_size().y-1)
		#OS.window_position = Vector2(0,0)
		if(Settings.settings.CustomDesktop == true):
			print(\"WallpaperScene Added\")
			add_child(load(\"res://-Scenes/Application000/Sub/Wallpaper.tscn\").instance())
		else:
			Vars.set(\"WallpaperValid\",false)
			Vars.set(\"WallpaperFinnished\",true)
	else:
		Vars.set(\"WallpaperValid\",false)
		Vars.set(\"WallpaperFinnished\",true)
"

