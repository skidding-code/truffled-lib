	#Steam.setOverlayNotificationInset(500,0)
	#or one of the set overlay things
	

	#print(\"\\n====Did Steam initialize?: \"+str(INIT)+\"====\\n\")

func _initiMemorys():
	var date = OS.get_date()
	var year = date[\"year\"]
	if(year >= 1970 and year < 1994):
		memorys = 1
	elif(year >= 1994 and year < 1997):
		memorys = 2
	elif(year >= 1997 and year < 1999):
		memorys = 3
		

