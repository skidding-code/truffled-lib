[sub_resource type="GDScript" id=8]
script/source = "extends Control
var effectArray = []
onready var shader = get_node(\"Shader\")
onready var shader_ScreenMelt = shader.get_node(\"ScreenMelt\")
onready var shader_Vignig = shader.get_node(\"Vignette\")
onready var shader_Custom = shader.get_node(\"Custom\")
onready var shader_Custom_2_v = shader_Custom.get_node(\"_2/V\")
onready var shader_Custom___v = shader_Custom.get_node(\"_/V\")
func _process(delta):
		if(Tab.data[\"data\"][14][\"EffectActive\"] == true):
			Tab.data[\"data\"][14][\"EffectActive\"] = false
			$Shader/ScreenMelt.visible = false
			$Shader/Vignette.visible = false
			$Shader/Custom.visible = false
			xready()


func xready():
	shader.visible = true
	#Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
	var data = Tab.data[\"data\"][14]
	var nameOfEffect = data[\"NameOfEffect\"] 
	
	effectArray = (((nameOfEffect.to_upper()).replace(\" \",\"\")).split(\"+\"))
	for i in range(effectArray.size()):
		if(\"MELT\" in effectArray[i]):
			shader_ScreenMelt.visible = true
		
		if(\"VIGNETTE\" in effectArray[i]):
			shader_Vignig.visible = true
			shader_Vignig.get_node(\"_/AnimationPlayer\").play(\"1\")
		
		
		if(\"VIGNETTE_1\" in effectArray[i]):
			shader_Vignig.visible = true
			shader_Vignig.get_node(\"_/AnimationPlayer\").stop()
			shader_Vignig.get_node(\"_/AnimationPlayer\").play(\"2\")
		elif(\"VIGNETTE_0\" in effectArray[i]):
			shader_Vignig.visible = true
			shader_Vignig.get_node(\"_/AnimationPlayer\").stop()
			shader_Vignig.get_node(\"_/AnimationPlayer\").play(\"3\")
		
		if(\"CUSTOM\" in effectArray[i]):
			shader_Custom.visible = true
			if(data[\"EffectDuration\"] > 0.0):
				var InitalEffect = data[\"InitalEffect\"]
				var initValues = InitalEffect.split(\"[\")[1].split(\",\")
				shader_Custom_2_v.material.set(\"shader_param/brightness\",float(initValues[0]))
				shader_Custom_2_v.material.set(\"shader_param/contrast\",float(initValues[1]))
				shader_Custom_2_v.material.set(\"shader_param/saturation\",float(initValues[2].rstrip(\"]\")))
				shader_Custom.get_node(\"A\").playback_speed = 1/float(data[\"EffectDuration\"])
				shader_Custom.get_node(\"A\").play(\"Time\")
			var values = effectArray[i].split(\"[\")[1].split(\",\")
			shader_Custom___v.material.set(\"shader_param/brightness\",float(values[0]))
			shader_Custom___v.material.set(\"shader_param/contrast\",float(values[1]))
			shader_Custom___v.material.set(\"shader_param/saturation\",float(values[2].rstrip(\"]\")))
	
	if(data[\"OtherInfo\"] != 0):
		get_node(\"Sfx\").get_node(str(data[\"OtherInfo\"])).play()
	if(data[\"TotalDuration\"] > 0.0):
		yield(get_tree().create_timer(float(data[\"TotalDuration\"]),false), \"timeout\")
	else:
		yield(get_tree().create_timer(float(data[\"EffectDuration\"]),false), \"timeout\")
	Tab.data[\"data\"][14][\"Background\"] = false
	shader.visible = false
"

