[sub_resource type="GDScript" id=46]
script/source = "extends AnimationPlayer



func _on_AnimationPlayer_animation_finished(anim_name):
	App._worldToKinito(\"FUNFAIR_blackout\")
	App.worldChangeScene(self, \"res://Act3/Home/Scenese/Feild/Feild.tscn\")
	pass # Replace with function body.
"

[sub_resource type="GDScript" id=47]
script/source = "extends MeshInstance

export var rotVal = 5
func _process(delta):
	self.rotation_degrees = Vector3(stepify(self.rotation_degrees.x,rotVal),stepify(self.rotation_degrees.y,rotVal),stepify(self.rotation_degrees.z,rotVal))
"

[sub_resource type="GDScript" id=48]
script/source = "extends Spatial
var zoom = false
var fpv_camera_angle = 0
var fpv_camera_X = 0
var fpv_mouse_sensitivity = 0.3
var c_fov = 70
var dis_fov = 0
export var xBounds = false
onready var camera = $B/Camera
func _process(delta):
	camera.fov = camera.fov + ((c_fov+dis_fov) - camera.fov) * delta*10.0
	camera.fov = clamp(camera.fov,10,70)
	
	
func _input(event):
	if Input.is_action_just_pressed(\"esc\"):
		pass
	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if event is InputEventMouseMotion:
			var change = -event.relative.y * fpv_mouse_sensitivity
			var changer = -event.relative.x * fpv_mouse_sensitivity
			
			
			#print(deg2rad(-event.relative.x * fpv_mouse_sensitivity))
			if xBounds:
				if changer + fpv_camera_X < 90 and changer + fpv_camera_X > -90:
					fpv_camera_X += changer
					rotate_y(deg2rad(-event.relative.x * fpv_mouse_sensitivity))
			else:
				rotate_y(deg2rad(-event.relative.x * fpv_mouse_sensitivity))
				
			if change + fpv_camera_angle < 90 and change + fpv_camera_angle > -90:
				$B.rotate_x(deg2rad(change))
				fpv_camera_angle += change
			
	if Input.is_action_just_pressed(\"click2\"):
		c_fov = 40
		zoom = true 
		$zoom/in.play()
	elif Input.is_action_just_released(\"click2\"):
		c_fov = 70
		dis_fov = 0
		zoom = false
		$zoom/out.play()
	if zoom:
		if Input.is_action_just_pressed(\"ScrollUp\"):
			dis_fov -= 10
			$zoom/c.pitch_scale = -(float(dis_fov)/100)/2+3.7
			$zoom/c.play()
		if Input.is_action_just_pressed(\"ScrollDown\"):
			dis_fov += 10
			$zoom/c.pitch_scale = -(float(dis_fov)/100)/2+3.7
			$zoom/c.play()
		dis_fov = clamp(dis_fov,-30,20)
"

[sub_resource type="GDScript" id=49]
script/source = "extends Spatial

func _ready():
	var na_me = Data.data[\"name\"]
	
	$Viewport/Control/T.bbcode_text = \"[center]Welcome to \" + na_me + \" Land!\"
	if na_me.length() > 4:
		$Viewport/Control/T/A.play(\"B\")
	else:
		$Viewport/Control/T/A.play(\"S\")
"

