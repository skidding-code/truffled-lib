[sub_resource type="GDScript" id=16]
script/source = "extends KinematicBody2D
export var on = false
export var speed = 100
onready var anim = get_node(\"Pos/Test\")
var dir = \"SW\"
var moving = false
var velocity = Vector2.ZERO
var path = []
var threshold = 16
var cursousrPos = Vector2.ZERO
var destination = Vector2.ZERO
var modeGoTo = 0
var lock = false

export var lockmode = 0
onready var nav = get_parent().get_node(\"Navigation2D\")
func _physics_process(delta):
	if(on):
		
		
		
		#(get_global_mouse_position()-Tab.window_position(5))/1.25  /Vars.get(\"nodeScale\").x
		
		cursousrPos = ((get_global_mouse_position()-Tab.window_position(5))/1.25/Vars.get(\"nodeScale\").x)  +   (Vector2(-418,-380)) + (Vector2(0,(8.5*Vars.get(\"webWRLD_SCROLL\")))/Vector2(Vars.get(\"nodeScale\").x,Vars.get(\"nodeScale\").x))
		
		
		
		#cursousrPos = ((((get_global_mouse_position()-Tab.window_position(5))/1.25  /Vars.get(\"nodeScale\").x)+ Vector2(-418*Vars.get(\"nodeScale\").x,-380*Vars.get(\"nodeScale\").x))+ Vector2(0,(8.5*Vars.get(\"webWRLD_SCROLL\")) )  /Vars.get(\"nodeScale\") )
		if path.size() > 0:
			move_to_target()
			
			
		if(position.distance_to(destination) < 25):
			if(mode == \"FactoryFrenzy\"):
				mode = \"\"
				get_parent().get_parent().get_node(\"1/1/House2/A\").play(\"A\")
				yield(get_tree().create_timer(1.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"SceneChange/AnimationPlayer\").play(\"transition\")
				yield(get_tree().create_timer(5.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"Game2\").add_child(load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2.tscn\").instance())
				get_parent().get_parent().get_parent().visible = false
				Vars.set(\"KinitoWebWorld\",\"game2PRE\")
				
				
			elif(mode == \"ReadyRepair\"):
				mode = \"\"
				get_parent().get_parent().get_node(\"1/1/House1/A\").play(\"A\")
				yield(get_tree().create_timer(1.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"SceneChange/AnimationPlayer\").play(\"transition\")
				yield(get_tree().create_timer(2.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"Game1\").add_child(load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game1.tscn\").instance())
				get_parent().get_parent().get_parent().visible = false
				Vars.set(\"KinitoWebWorld\",\"game1PRE\")
			
			elif(mode == \"HideAndSeek\"):
				mode = \"\"
				get_parent().get_parent().get_node(\"1/1/House3/A\").play(\"A\")
				yield(get_tree().create_timer(1.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"SceneChange/AnimationPlayer\").play(\"transition\")
				yield(get_tree().create_timer(2.0), \"timeout\")
				get_parent().get_parent().get_parent().get_parent().get_node(\"Game3\").add_child(load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game3.tscn\").instance())
				get_parent().get_parent().get_parent().visible = false
				Vars.set(\"KinitoWebWorld\",\"game3PRE\")
			
			
			#HideAndSeek
				# TROY IF YOU WONDERING WHY FUNNY SCARE NO WORKY THIS IS WHY THIS CODE IS WHY IT DOSNT WORK. I DISABLED IT FOR THE DEMOP BECAUSE I CBA TO IMPLEMETN IT LMAOOOO
#			elif(mode == \"Scare1\"):
#				mode = \"\"
#				get_parent().get_parent().get_node(\"PlaceJump/AnimationPlayer\").play(\"DontGoThere\")




		if(moving):
			anim.play(str(dir)+\"_RUN\")
		else:
			anim.play(str(dir)+\"_IDLE\")
			
var mode = \"\"

func move_to_target():
	if(on):
		if position.distance_to(path[0]) < threshold:
			
			path.remove(0)
			yield(get_tree().create_timer(0.1), \"timeout\")
			moving = false

#				if(lockmode == 1 and modeGoTo == 1):
#					Tab.kinitoWebWorld[\"Button\"] = \"World_To_CardCatastrophe\"
#				elif(lockmode == 5):
#					Tab.kinitoWebWorld[\"Button\"] = \"World_To_Tree\"
			
		else:
			moving = true
			var direction = position.direction_to(path[0])
			velocity = direction * speed
			if(direction.x > -1 and direction.y > 0   and   direction.x < 0 and direction.y < 1 ):
				dir = \"SW\"
			elif(direction.x > 0 and direction.y < 1   and   direction.x < 1 and direction.y > 0 ):
				dir = \"SE\"
			elif(direction.x > 0 and direction.y > -1   and   direction.x < 1 and direction.y < 0 ):
				dir = \"NE\"
			elif(direction.x < 1 and direction.y < 0   and   direction.x < 0 and direction.y > -1 ):
				dir = \"NW\"
			#anim.play(\"SW_IDLE\")
			
			velocity = move_and_slide(velocity)
			
func get_target_path(target_pos):
	if(on):
		if(get_parent().animation == false):
			destination = target_pos
			# Navigation2D works in GLOBAL space in Godot 3, but position and
			# target_pos are both local to this node's parent. That only agrees
			# while the scene sits at the origin. The browser window is centred, so
			# its container sits at (424, 168) and both endpoints landed outside the
			# navmesh and were clamped to one boundary point - the character walked
			# to that same spot whatever you clicked, then stopped.
			#
			# Measured at nav origin (0,0) the path ends on the target; at (424,168)
			# it collapsed to [(149.9, 76.6), (149.9, 76.6)].
			var xf = get_parent().get_global_transform()
			var inv = xf.affine_inverse()
			var gpath = nav.get_simple_path(xf.xform(position), xf.xform(target_pos), false)
			path = []
			for gp in gpath:
				path.append(inv.xform(gp))


func _on_Board_button_down():
	if(on):
		get_target_path(  cursousrPos  )


func _on_H3_button_down():
	if(on):
		mode= \"Scare1\"
		get_target_path(  Vector2(-2.952,141)  )
	pass # Replace with function body.


func _on_H1_button_down():
	if(on):
		get_parent().get_parent().get_node(\"H1\").visible = false
		mode= \"ReadyRepair\"
		get_target_path(  Vector2(-185,48)  )
	pass # Replace with function body.


func _on_H2_button_down():
	if(on):
		get_parent().get_parent().get_node(\"H2\").visible = false
		mode= \"FactoryFrenzy\"
		get_target_path(  Vector2(230,-45)  )
	pass # Replace with function body.


func _on_H4_button_down():
	if(on):
		get_parent().get_parent().get_node(\"H4\").visible = false
		mode= \"HideAndSeek\"
		get_target_path(  Vector2(-38.455,-70.77)  )
	pass # Replace with function body.
"

