[sub_resource type="GDScript" id=1]
script/source = "extends Node
onready var info = App.data[\"data\"][2]
func _ready():
	OS.window_size = Vector2(1,1)
	OS.window_position = Vector2(0,0)
	var timeToExecute = [0,0,0]
	var mainvalue = info[\"CurrentTime\"][2] + info[\"ExecutionTime\"]
	var addedvalue = 0
	while (mainvalue >= 60) and (mainvalue-60 <= 0):
		mainvalue -= 60
		info[\"CurrentTime\"][1] += 1
		addedvalue += 1
	info[\"CurrentTime\"][2] = mainvalue
	var newmainvalue = info[\"CurrentTime\"][1] + addedvalue
	var addedaddedvalue = 0
	while (newmainvalue >= 60) and (newmainvalue-60 <= 0):
		newmainvalue -= 60
		info[\"CurrentTime\"][0] += 1
		addedaddedvalue += 1
	info[\"CurrentTime\"][1] = newmainvalue
	var newnewmainvalue = info[\"CurrentTime\"][0] + addedaddedvalue
	if (newnewmainvalue >= 24) :
		info[\"CurrentTime\"][0] = 0
func _process(delta):
	var currentTime = [OS.get_time().hour , OS.get_time().minute , OS.get_time().second ]
	if(info[\"CurrentTime\"][0] <= currentTime[0] and info[\"CurrentTime\"][2] <= currentTime[2]  and info[\"CurrentTime\"][1] <= currentTime[1]  ):
		get_tree().change_scene(\"res://-Scenes/NewInstance/2/2.tscn\")
"

[node name="Node" type="Node"]
