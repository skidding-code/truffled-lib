script/source = "extends Control

func _on_X_button_up():
	get_node(\"AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0,false), \"timeout\")
	Tab.close(26)

"

[sub_resource type="GDScript" id=2]
script/source = "extends Control


# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.

# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass


func _on_Text_meta_clicked(meta):
	if meta == \"localdir\":
		App._openExternal( (OS.get_executable_path().get_base_dir().replace(\"\\\\\",\"/\") + \"/agreement.txt\") )
		print(OS.get_executable_path().get_base_dir().replace(\"\\\\\",\"/\") + \"/agreement.txt\")
	elif meta == \"localdir2\":
		App._openExternal( (OS.get_executable_path().get_base_dir().replace(\"\\\\\",\"/\") + \"/readme.html\") )
		print(OS.get_executable_path().get_base_dir().replace(\"\\\\\",\"/\") + \"/readme.html\")
	else:
		App._openExternal(meta)
	pass # Replace with function body.
"

