[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
var selected = false
var grab = true
var inside = false
var offset = Vector2(0,0)
var windowClampX = Vector2(153,520)
var windowClampY = Vector2(225,480)

var windowClampOUTX = Vector2(153,520+200)
var windowClampOUTY = Vector2(225-50,480+50)


const FOLLOW_SPEED = 10.0

func _process(delta):
	if(grab):
		$Lerp.position = $Lerp.position.linear_interpolate(position, delta * FOLLOW_SPEED)
		$RePUT/UNKOWN_CHAR/Attempt.playback_speed = 0
		$RePUT/UNKOWN_CHAR/Attempt.play(\"A\")
		$RePUT/UNKOWN_CHAR/Attempt.seek( (($Lerp.position.x - position.x)/100)+1)
		
		var realPOS = (offset+ ((get_global_mouse_position()-Tab.window_position(5))/1.3 /Vars.get(\"nodeScale\").x )+ Vector2(35,25+(8.5*Vars.get(\"webWRLD_SCROLL\")) ))
		if Input.is_action_just_released(\"click\"):
			if(inside):
				get_parent()._deselectAll()
				get_parent().PickedUp = true
				grab = false
				_on_GRAB_button_up()
			else:
				get_parent().PickedUp = false
				queue_free()
		if(inside == false):
			if( (realPOS.x > ( windowClampX.x+($GRAB.rect_size.x/2*0.525) ) and realPOS.x < ( windowClampX.y-($GRAB.rect_size.x/2*0.525)) ) and (realPOS.y > windowClampX.x+($GRAB.rect_size.x/2*0.525) and realPOS.y < (windowClampY.y-($GRAB.rect_size.y/2*0.525)) )    ):
				inside = true
			position.x = clamp(realPOS.x,  windowClampOUTX.x+($GRAB.rect_size.x/2*0.525),   windowClampOUTX.y-($GRAB.rect_size.x/2*0.525)  )
			position.y = clamp(realPOS.y,  windowClampOUTY.x+($GRAB.rect_size.y/2*0.525),   windowClampOUTY.y-($GRAB.rect_size.y/2*0.525)  )
		else:
			position.x = clamp(realPOS.x,  windowClampX.x+($GRAB.rect_size.x/2*0.525),   windowClampX.y-($GRAB.rect_size.x/2*0.525)  )
			position.y = clamp(realPOS.y,  windowClampY.x+($GRAB.rect_size.y/2*0.525),   windowClampY.y-($GRAB.rect_size.y/2*0.525)  )
	else:
		position.y = 215

func _deselect():
	get_parent().PickedUp = false
	selected = false

func _on_GRAB_button_up():
	inside = true
	grab = false
	$GRAB.visible = false
	$RePUT/UNKOWN_CHAR/Attempt.playback_speed = 2
	$RePUT/UNKOWN_CHAR/Attempt.play(\"Fall\")



"

