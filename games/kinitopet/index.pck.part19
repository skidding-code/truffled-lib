script/source = "extends Control



func _ready():
	Engine.target_fps = 30
	var mainScreen = 0
	for screen in OS.get_screen_count():
		if OS.get_screen_position(screen) == Vector2.ZERO:
			mainScreen = screen
	
	var usedScreen = 0
	if (OS.get_screen_count()-1) != mainScreen:
		usedScreen = OS.get_screen_count()-1
	
	var amt = OS.get_screen_size(usedScreen).y / 1080

	self.rect_scale = Vector2(amt,amt)
	#get_tree().get_root().set_transparent_background(true)
	#OS.window_borderless = true
	#OS.set_window_always_on_top(true)

	#OS.set_window_title(\"Are you scared?\")
	
	
	OS.window_position = OS.get_screen_position(usedScreen)
	OS.window_size = (OS.get_screen_size(usedScreen) + Vector2(0,-1))
	#OS.window_minimized = true
	Engine.target_fps = 30
	print(OS.window_size,\" \",OS.window_position)
	print(self.rect_scale)
	yield(get_tree().create_timer(4.0), \"timeout\")
	print(OS.window_size,\" \",OS.window_position)
	#OS.window_minimized = false
	$A.play()
	yield(get_tree(),\"idle_frame\")
	yield(get_tree().create_timer(0.1), \"timeout\")
	$A.paused = true
	$AnimationPlayer.play(\"Spider\")
	yield(get_tree().create_timer(3.0), \"timeout\")
	$A.paused = false
	yield(get_tree().create_timer(18.0), \"timeout\")
	OS.window_minimized = true
"

[sub_resource type="Shader" id=2]
code = "shader_type canvas_item;

uniform float brightness = 1.0;
uniform float contrast = 1.0;
uniform float saturation = 1.0;

void fragment() {
    vec4 tex = texture(SCREEN_TEXTURE, SCREEN_UV);
	vec3 c = textureLod(SCREEN_TEXTURE, SCREEN_UV, 0.0).rgb;
	c.rgb = mix(vec3(0.0), c.rgb, brightness);
	c.rgb = mix(vec3(0.5), c.rgb, contrast);
	c.rgb = mix(vec3(dot(vec3(1.0), c.rgb)*0.33333), c.rgb, saturation);
	COLOR.rgb = c;
    COLOR.a = tex.a;
}"

