[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
func _ready():
	Tab._trasnparentScreen()
	
	self.position = Vars.get(\"ScreenSize\")/Vars.get(\"nodeScale\")/2 
	
export var soundeffect = 0
var ot = false
func _process(delta):
	if soundeffect != 0:
		if(ot == false):
			ot = true
			Tab.data[\"data\"][17] = soundeffect
			Tab.pauseCheck(17)
	pass
	
"

