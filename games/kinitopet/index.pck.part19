[sub_resource type="GDScript" id=113]
script/source = "extends Spatial
func _process(delta):
	if (Tab.soloKinito):
		translation = Vector3((Tab.os_mouse_pos().x- Tab.window_position(1).x  )/100,  ((Tab.os_mouse_pos().y- Tab.window_position(1).y)/100)  ,translation.z)
	else:
		# Sub-Viewport: the mouse is not stretch-corrected here, so his gaze only
		# lined up at the base resolution.
		var m = App._viewportMouseUnscaled(self)
		translation = Vector3((m.x-200  )/100,  -((m.y-175)/100)  ,translation.z)
"

[sub_resource type="GDScript" id=114]
script/source = "extends Spatial
func _process(delta):
	if (Tab.soloKinito):
		translation = Vector3((Tab.os_mouse_pos().x - Tab.window_position(1).x )/100,  ((Tab.os_mouse_pos().y- Tab.window_position(1).y)/100)  ,translation.z)
	else:
		# Sub-Viewport: the mouse is not stretch-corrected here, so his gaze only
		# lined up at the base resolution.
		var m = App._viewportMouseUnscaled(self)
		translation = Vector3((m.x-200  )/100,  ((m.y-175)/100)  ,translation.z)
"

