[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
export var borderlessoveride = true
func _ready():
	Tab.close(1)
	#Tab.close(0)
	
	Tab.tempRevertSurvey() 
	print(\"Revert - survey\")
	
	
	
	#OS.window_position = Vector2.ZERO
	Tab._trasnparentScreen()
	#Tab._fullScreen()
	print(\"Revert - survey\")
	Wallpaper.call(\"M2\")
	$ScreenEffect.scale = Vars.get(\"nodeScale\")
	#/Vars.get(\"nodeScale\")
	
	$ScreenEffect.position = (  App._renderSize() / Vars.get(\"nodeScale\") )/2
	Tab.setAudioMasterReverb(false)
	AudioServer.set_bus_mute( AudioServer.get_bus_index(\"MandKsounds\"), true)
	
	AudioServer.set_bus_mute( AudioServer.get_bus_index(\"Ambiance\"), true)
	Tab.soloAudio(false)
	#Tab.revertblackoutScreen()
	App.captureMouse(true, self)
	#AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"NonOutof\"),-80.0)
	yield(get_tree().create_timer(15.5), \"timeout\")
	get_tree().change_scene(\"res://-Scenes/-OVERRIDE/Act2_Night/NightTime/NightTime.tscn\")
"

[sub_resource type="ShaderMaterial" id=2]
shader = ExtResource( 7 )
shader_param/blur_amount = 1.275
shader_param/signal_quality = 0.0
shader_param/bottom_strenth = 0.0

[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;

vec4 sample_glow_pixel(sampler2D tex, vec2 uv) {
    float hdr_threshold = 0.1; // Exagerated, almost everything will glow
    return max(textureLod(tex, uv, 2.0) - hdr_threshold, vec4(0.0));
}

void fragment() {
    vec2 ps = SCREEN_PIXEL_SIZE;
    // Get blurred color from pixels considered glowing
    vec4 col0 = sample_glow_pixel(SCREEN_TEXTURE, SCREEN_UV + vec2(-ps.x, 0));
    vec4 col1 = sample_glow_pixel(SCREEN_TEXTURE, SCREEN_UV + vec2(ps.x, 0));
    vec4 col2 = sample_glow_pixel(SCREEN_TEXTURE, SCREEN_UV + vec2(0, -ps.y));
    vec4 col3 = sample_glow_pixel(SCREEN_TEXTURE, SCREEN_UV + vec2(0, ps.y));

    vec4 col = texture(SCREEN_TEXTURE, SCREEN_UV);
    vec4 glowing_col = 0.25 * (col0 + col1 + col2 + col3);

    COLOR = vec4(col.rgb + glowing_col.rgb, col.a);
}"

[sub_resource type="ShaderMaterial" id=4]
shader = SubResource( 3 )

[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

uniform float lod: hint_range(0.0, 5) = 0.0;

void fragment(){
	vec4 color = texture(SCREEN_TEXTURE, SCREEN_UV, lod);
	COLOR = color;
}"

