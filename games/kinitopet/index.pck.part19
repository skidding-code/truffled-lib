[sub_resource type="StreamTexture" id=15]
load_path = "res://.import/CharHand.png-6684339a7de26a166e1c92639fac1856.stex"

[sub_resource type="Shader" id=16]
code = "shader_type canvas_item;

void fragment(){
	vec4 tex = texture(TEXTURE, UV);
	float uv_height = SCREEN_PIXEL_SIZE.y / TEXTURE_PIXEL_SIZE.y;
	vec2 reflected_screenuv = vec2(SCREEN_UV.x, SCREEN_UV.y + uv_height * UV.y * 2.0);
	COLOR = texture(SCREEN_TEXTURE, reflected_screenuv);
    COLOR.a = tex.a;
}"

