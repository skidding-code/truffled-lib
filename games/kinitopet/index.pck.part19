[sub_resource type="GDScript" id=1]
script/source = "extends Control
func _ready():
	var Op11 = Tab.data[\"data\"][11]
	var TitleText = Op11[\"Title\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	var MainText = Op11[\"BaseText\"].replace(\"[name]\",str(Vars.get(\"player_name\")))

	
	
	$Active/Title.bbcode_text = TitleText
	$Active/box_text.bbcode_text = MainText
	
	$Active/Icon.frame = Op11[\"Icon\"]
	$Active/Y/Y.text = Op11[\"Option1\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	$Active/N/N.text = Op11[\"Option2\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	
	if($Active/Y/Y.text == \"\" or $Active/Y/Y.text == null):
		$Active/Y/Y.visible = false
	yield(get_tree(), \"idle_frame\")
	if($Active/box_text.rect_size.y > 30):
		$Active/Background.rect_size.y += $Active/box_text.rect_size.y-30
	
	if($Active/Background.rect_size.y > 104):
		$Active/Y/Y.rect_position.y += $Active/Background.rect_size.y-104
		$Active/N/N.rect_position.y += $Active/Background.rect_size.y-104
	
	if(Op11[\"Timer\"] > 0):
		yield(get_tree().create_timer(float(  Op11[\"Timer\"]  ),false), \"timeout\")
		
		$Active/Icon/AnimationPlayer.play(\"0\")
		yield(get_tree().create_timer(1), \"timeout\")
		
		Tab.close(11)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control
var OT = false
func _on_Y_button_up():
	if(OT == false):
		OT = true
		Tab.data[\"data\"][11][\"Output\"] = 1
		_close1()
func _on_N_button_up():
	if(OT == false):
		OT = true
		Tab.data[\"data\"][11][\"Output\"] = 2
		_close1()



func _close1():
	$Icon/AnimationPlayer.play(\"0\")
	yield(get_tree().create_timer(1,false), \"timeout\")
	Tab.close(11)
"

