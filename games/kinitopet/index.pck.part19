[sub_resource type="GDScript" id=3]
script/source = "extends Node
export var keyboardNoise = true
var lastevent
var pitch = 1.0
func _input(event):
	if(keyboardNoise == true):
		if event is InputEventKey:
			if((event.scancode != KEY_ENTER) and (event.scancode != KEY_BACKSPACE) and (event.scancode != KEY_SPACE) and (event.scancode != KEY_CAPSLOCK) and (event.scancode != KEY_SHIFT) and (event.scancode != KEY_CONTROL) and (event.scancode !=  KEY_ALT) ):
				if event.pressed:
					if(lastevent != event.scancode):
						lastevent = event.scancode
						pitch = rand_range(0.9,1.1)
						get_node(\"1D\").pitch_scale = pitch
						get_node(\"1D\").play()
				else:
					lastevent = null
					pitch = rand_range(0.9,1.1)
					get_node(\"1U\").pitch_scale = pitch
					get_node(\"1U\").play()
			else:
				if event.pressed:
					if(lastevent != event.scancode):
						lastevent = event.scancode
						pitch = rand_range(0.9,1.1)
						get_node(\"2D\").pitch_scale = pitch
						get_node(\"2D\").play()
				else:
					lastevent = null
					pitch = rand_range(0.9,1.1)
					get_node(\"2U\").pitch_scale = pitch
					get_node(\"2U\").play()
"

[sub_resource type="Shader" id=4]
code = "shader_type canvas_item;

uniform float brightness = 1.0;
uniform float contrast = 1.0;
uniform float saturation = 1.0;

void fragment() {
    vec4 tex = texture(SCREEN_TEXTURE, SCREEN_UV);
	vec3 c = textureLod(SCREEN_TEXTURE, SCREEN_UV, 0.0).rgb;
	c.rgb = mix(vec3(0.0), c.rgb, brightness);
	c.rgb = mix(vec3(0.5), c.rgb, contrast);
	c.rgb = mix(vec3(dot(vec3(1.0), c.rgb)*0.33333), c.rgb, saturation);
	COLOR.rgb = c;
    COLOR.a = tex.a;
}"

