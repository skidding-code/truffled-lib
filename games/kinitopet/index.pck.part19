[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

func _ready():
	Data._save(\"win\",true)
	#Tab._closeAll(30)
	#Tab.close(0)
	get_tree().get_root().set_transparent_background(false)
	if App.singleWindow:
		pass
	elif App.windowedMode == false:
		OS.window_fullscreen = true
	else:
		App._windowMode()
		
	Wallpaper.call(\"M2\")
	AudioServer.set_bus_mute(AudioServer.get_bus_index(\"MandKsounds\"),true)
	
	
	
	if Vars.get(\"EndTrapped\") == true:
		Steam.setAchievement(\"Trapped\")
		Steam.storeStats()
	else:
		Steam.setAchievement(\"NoEscape\")
		Steam.storeStats()
	
	yield(get_tree().create_timer(4.0), \"timeout\")
	

	$CanvasLayer/Control/NS.rect_scale = Vector2(App._renderSize().x / 1920,App._renderSize().x / 1920)
"

