func removeTempDesktop():
	var dir = Directory.new()
	dir.open(\"user://\")
	if dir.dir_exists(tempDesktopPath):
		var sub_dir = Directory.new()
		sub_dir.open(tempDesktopPath)
# warning-ignore:unused_variable
		var sub_dir_list = sub_dir.list_dir_begin()
		while true:
			var folder_name = sub_dir.get_next()
			if folder_name == \"\":
				break
			sub_dir.remove(folder_name)
		sub_dir.list_dir_end()
		dir.remove(tempDesktopPath)



