[ext_resource path="res://Script/TakeScreenshot.gd" type="Script" id=3]

[sub_resource type="GDScript" id=1]
script/source = "extends Node
var effectArray = []
# Called when the node enters the scene tree for the first time.
func _runEffect():
	#Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
	if not App.singleWindow:
		OS.window_size = Vector2(OS.get_screen_size().x,OS.get_screen_size().y-1)
		OS.window_position = Vector2(0,0)
	var data = Tab.data[\"data\"][14]
	var nameOfEffect = data[\"NameOfEffect\"] 
	

	effectArray = (((nameOfEffect.to_upper()).replace(\" \",\"\")).split(\"+\"))
	for i in range(effectArray.size()):
		if(\"MELT\" in effectArray[i]):
			$Shader/ScreenMelt.visible = true
		
		if(\"CUSTOM\" in effectArray[i]):
			$Shader/Custom.visible = true
			if(data[\"EffectDuration\"] > 0.0):
				var InitalEffect = data[\"InitalEffect\"]
				var initValues = InitalEffect.split(\"[\")[1].split(\",\")
				$Shader/Custom/_2/V.material.set(\"shader_param/brightness\",float(initValues[0]))
				$Shader/Custom/_2/V.material.set(\"shader_param/contrast\",float(initValues[1]))
				$Shader/Custom/_2/V.material.set(\"shader_param/saturation\",float(initValues[2].rstrip(\"]\")))
				$Shader/Custom/A.playback_speed = 1/float(data[\"EffectDuration\"])
				$Shader/Custom/A.play(\"Time\")
			var values = effectArray[i].split(\"[\")[1].split(\",\")
			$Shader/Custom/_/V.material.set(\"shader_param/brightness\",float(values[0]))
			$Shader/Custom/_/V.material.set(\"shader_param/contrast\",float(values[1]))
			$Shader/Custom/_/V.material.set(\"shader_param/saturation\",float(values[2].rstrip(\"]\")))
	
	if(data[\"OtherInfo\"] != 0):
		get_node(\"Sfx\").get_node(str(data[\"OtherInfo\"])).play()
	if(data[\"TotalDuration\"] > 0.0):
		yield(get_tree().create_timer(float(data[\"TotalDuration\"])), \"timeout\")
	else:
		yield(get_tree().create_timer(float(data[\"EffectDuration\"])), \"timeout\")
	
	#Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	Tab.close(14)



# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass
"

[sub_resource type="StreamTexture" id=2]
flags = 4

[sub_resource type="GDScript" id=3]
script/source = "extends TextureRect
func _ready():
	var image = Image.new()
	var err = image.load(\"user://Kinitopet_DATA/Wallpaper_DATA/MX.png\")
	if err != OK:
		Tab.close(14)
		print(\"Error in loading and or generating screenshot: (FAIL)\")
		# Failed
	texture = ImageTexture.new()
	texture.create_from_image(image, 0)
"

[sub_resource type="GDScript" id=4]
script/source = "extends Control
func _ready():
	rect_scale = App._screenSize()
"

[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;
uniform float iTime;
void fragment(){
	vec2 l = SCREEN_UV;
	l.y += .01 * iTime * fract(sin(dot(vec2(l.x), vec2(5.0, 500.2)))* 400.5);
	COLOR = texture(SCREEN_TEXTURE, l);
}"

