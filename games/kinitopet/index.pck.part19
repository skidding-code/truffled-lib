[sub_resource type="GDScript" id=3]
script/source = "extends Control
var selected = 3

func resetAll(sel):
	selected = sel
	get_node(\"../Edit/ViewportContainer/Viewport/Control\").selMode = int(sel)
	for i in range(6):
		get_node(str(i+1))._setFalse()
"

[sub_resource type="GDScript" id=4]
script/source = "extends Button

func _on_Button_toggled(button_pressed):
	if(button_pressed):
		get_parent().resetAll(self.name)
		$S.frame = 1
		$Icon.position = Vector2(13.5,13.5)
	else:
		$S.frame = 0
		$Icon.position = Vector2(12.5,12.5)

func _setFalse():
	pressed = false
	_on_Button_toggled(false)
"

