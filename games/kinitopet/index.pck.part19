[sub_resource type="GDScript" id=34]
script/source = "extends MeshInstance



func _on_duckGame_body_entered(body):
	if body.name == \"Player\":
		body.gunMode = true
		App._worldToKinito(\"FUNFAIR_duckgame\")
		body.get_node(\"head/Camera/Hand/gun/AnimationPlayer\").play(\"Out\")


func _on_duckGame_body_exited(body):
	if body.name == \"Player\":
		body.gunMode = false
		body.get_node(\"head/Camera/Hand/gun/AnimationPlayer\").play(\"In\")



func _on_moleGame_body_entered(body):
	if body.name == \"Player\":
		body.malletMode = true
		App._worldToKinito(\"FUNFAIR_molegame\")
		body.get_node(\"head/Camera/Hand/mallet/AnimationPlayer\").play(\"Out\")


func _on_moleGame_body_exited(body):
	if body.name == \"Player\":
		body.malletMode = false
		body.get_node(\"head/Camera/Hand/mallet/AnimationPlayer\").play(\"In\")
"

