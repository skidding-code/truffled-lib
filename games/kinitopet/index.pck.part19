export var up = false
var hit = false
var last = false
var forw = false
var time = 0
func _process(delta):
	time += delta
	if up:
		if last == false:
			last = true
			forw = false
			$AnimationPlayer.play(\"Up\")
			hit = false
			time = 0
	else:
		if forw == false:
			forw = true
			last = false
			if hit == false:$AnimationPlayer.play(\"Down\")
			hit = false
			time = 0

func _on_Area_area_entered(area):
	if area.name == \"GunSite\": _down()

func _down():
	if up:
		up = false
		hit = true
		$AnimationPlayer.play(\"Hit\")
		#get_parent().get_node(\"VScore\").value += ( clamp(200-(int(time*100)+3),0,500)  +50)
		#print( ((1/int(time*10)) *10)   + 50  )
		
		time = 0
"

