[sub_resource type="GDScript" id=16]
script/source = "extends Control
export var option_0 = \"\"
export var option_1 = \"\"
export var option_2 = \"\"

var preOP0 = \"\"
var preOP1 = \"\"
var preOP2 = \"\"

func _process(delta):
	if preOP0 != option_0:
		preOP0 = option_0
		$Answ0.bbcode_text = \"[center][\"+str(option_0)+\"]\"
	if preOP1 != option_1:
		preOP1 = option_1
		$Answ0.bbcode_text = \"[center][\"+str(option_1)+\"]\"
	if preOP2 != option_2:
		preOP2 = option_2
		$Answ0.bbcode_text = \"[center][\"+str(option_2)+\"]\"
	pass


func _on_0_button_down():
	Vars.set(\"Survey_Answer\",\"0\")
	$sel.play(\"DONE\")
func _on_0_mouse_entered():$sel.play(\"0\")
func _on_0_mouse_exited():$sel.play(\"NA\")


func _on_1_button_down():
	Vars.set(\"Survey_Answer\",\"1\")
	$sel.play(\"DONE\")
func _on_1_mouse_entered():$sel.play(\"1\")
func _on_1_mouse_exited():$sel.play(\"NA\")


func _on_2_button_down():
	Vars.set(\"Survey_Answer\",\"2\")
	$sel.play(\"DONE\")
func _on_2_mouse_entered():$sel.play(\"2\")
func _on_2_mouse_exited():$sel.play(\"NA\")
"

[sub_resource type="GDScript" id=17]
script/source = "extends AudioStreamPlayer


func _process(delta):
	if Vars.get(\"SURVEY_CAMERA_\") == true:
		stream_paused = false
	else:
		stream_paused = true
	pass
"

