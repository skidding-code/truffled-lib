[sub_resource type="GDScript" id=1]
script/source = "extends Control


# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.
func _ready():
	if App.singleWindow:
		# Went fullscreen as its own window; here that means the world's fake window
		# filling the render space. The transparency below would punch a hole
		# through the game rather than showing a desktop behind it.
		# Screen-glitch and fade overlays: these are meant to cover the whole
		# monitor, so the window fills the render space. It only ever looked like a
		# scene replacement because change_scene really was replacing the scene -
		# that is fixed separately, and the desktop and Kinito survive underneath.
		App.setWorldWindowBase(App._renderSize())
	else:
		get_tree().get_root().set_transparent_background(true)
		OS.window_per_pixel_transparency_enabled = true
		OS.set_window_always_on_top(true)
		OS.window_position = Vector2(0,0)
		OS.window_size = OS.get_screen_size() - Vector2(0,1)
	
	
	print(\"TAB 3 pre crash\")
	yield(get_tree().create_timer(10.0), \"timeout\")
	print(\"crash 0\")
	if App.singleWindow:
		# End of the world sequence: the window goes, and so does the desktop it was
		# sitting on. Leaving that backdrop up meant every later full-screen shader
		# - the TV effect in the final cutscene among them - was still sampling it.
		App.setWorldWindowVisible(false)
		App.showVirtualDesktop(false)
	else:
		# \"crash\" by collapsing the window to nothing.
		OS.window_size = Vector2(10,10)
		OS.window_minimized = true
	print(\"crash 1\")
	print(\"crash 2\")
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass
"

