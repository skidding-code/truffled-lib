func open(i):
	if i == 10 and disablePause:
		pass
	else:
		if(data[\"open\"][i] == false):
			data[\"open\"][i] = true
			pauseCheck(i)
			#print(appParent.name)
			appParent._add_child(str(i),i)
			
			#res://-Scenes/Application{/Main/1.tscn
			RuntimeAlter.start(i)
			focus(i)
			if i == 10:
				Tab.effects[\"load\"] = false
			
		
#		if(i > NodeCount):
#			pass
##			appParent.get_node(str(i)).add_child(load(\"res://Mod/Scenes/Application\"+str(i-(NodeCount+1)).pad_zeros(3)+\"/1.tscn\").instance())
#		else:
			
			#if(preloadbank.has(\"res://-Scenes/Application\"+str(i).pad_zeros(3)+\"/Main/1.tscn\")):
				#appParent.get_node(str(i)).add_child(( preloadbank[(\"res://-Scenes/Application\"+str(i).pad_zeros(3)+\"/Main/1.tscn\")][0] ).instance())
			#else:
#				appParent.get_node(str(i)).add_child(load( (\"res://-Scenes/Application\"+str(i).pad_zeros(3)+\"/Main/1.tscn\") ).instance())
		else:
			print(str(i),\"<- is already open\")


func scene(res):
	var current = int(res.split(\"Application\")[1].split(\"/\")[0])
	# Deliberately does NOT reset the container position. Apps navigate between
	# their own pages through here - the browser loads every page this way - and
	# each page re-centres itself through its own Center node. Resetting here sent
	# any page without one to the top-left corner. Full-screen scenes that need
	# the origin ask for it themselves in _ready(), which is what 1.tscn, 2.tscn
	# and 29.tscn already do.
	appParent._rem_current(str(current))
	
	var child = appParent._res_add_child(str(current),res)
	#child.raise()
	
#	if(preloadbank.has(str(res))):
#		var child = appParent.get_node(str(current)).call_deferred(\"add_child\" , (preloadbank[str(res)][0] ))
#		child.raise()
#		if(preloadbank[str(res)][1] == false):
#			preloadbank.erase(str(res))
#	else:
	#var child = appParent.get_node(str(current)).call_deferred(\"add_child\" , (load(str(res))).instance())


func close(i):
	if(data[\"open\"][i] == true):
		data[\"open\"][i] = false
		pauseCheck(i)
		if(topfocus == i):
			topfocus = -1
		appParent.get_node(str(i)).get_child(0).queue_free()
		if i == 14:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			Tab.mouseOveride = false
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		if i == 24:
			get_tree().paused = false
		if i == 5:
			Tab.effects[\"load\"] = false

func kinito_grab(tab,offset,endpos,other): 
	#print(\"Kinito Grab Tab \",tab)
	Tab.data[\"data\"][2][0] = tab
	Tab.data[\"data\"][2][1] = offset
	Tab.data[\"data\"][2][2] = endpos
	Tab.data[\"data\"][2][3] = other
	# other:
	# 0 = grab tab and return
	# 1 = go to position and dissapear
	
	Tab.open(2)
	while data[\"open\"][2] == true:
		yield(get_tree(), \"idle_frame\")


func focus(i):
	buttonValue = 0
	appParent.get_node(str(i)).raise()  
	topfocus = i
	#order of tabs
	appParent.get_node(str(12)).raise()
	appParent.get_node(str(11)).raise()
	appParent.get_node(str(1)).raise()
	appParent.get_node(str(2)).raise()
	if(i == 7):
		appParent.get_node(str(7)).raise()
		
	appParent.get_node(str(14)).raise()
	
	appParent.get_node(\"Z\").raise()
	
	appParent.get_node(str(10)).raise()
	appParent.get_node(str(16)).raise()
	# this is the tv scene (overlay)
	appParent.get_node(str(17)).raise()
	return topfocus




var setScreenBlack = false
func pauseCheck(i): # pause check  /  tab check for special tabs
	
	if Tab.data[\"open\"][24]:
		close(10)
		whiteoutScreen()
		#blackoutScreen()
		soloAudio(true)
		get_tree().paused = true
	
	if data[\"open\"][17]:
		Tab._regScreen()
		close(10)
		blackoutScreen()
		setAudioMasterReverb(true)
	
	if data[\"data\"][17] != 0:
		setAudioMasterReverb(false)
		soloAudio(true)
	
	if setScreenBlack or revbaudioAs or soloaudioAs:
		if data[\"open\"][17] or data[\"open\"][24]:pass
		else:
			setAudioMasterReverb(false)
			soloAudio(false)
			revertblackoutScreen()
	
	if i == 30:
		Tab.mouseOveride = false
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

	if(i == 10 or i == 14):
		
		if(get_tree().paused == true):
			get_tree().paused = false
			appParent.get_node(\"Z/S1\").visible = false
			Wallpaper.call(\"M1\")
		else:
			get_tree().paused = true
			appParent.get_node(\"Z/S1\").visible = true
			if(i == 14):
				Wallpaper.call(\"M2\")
			else:
				Wallpaper.call(\"M3\")

var soloaudioAs = false
func soloAudio(vars):
	soloaudioAs = vars
	AudioServer.set_bus_solo( AudioServer.get_bus_index(\"NonOutof\"), vars)
	
func whiteoutScreen(): 
	if(setScreenBlack == false):
		setScreenBlack = true
		if App.windowedMode == false and not App.singleWindow:
			OS.window_fullscreen = true
		Wallpaper.call(\"M5\")
func blackoutScreen():   # currently also full screens game
	if(setScreenBlack == false):
		setScreenBlack = true
		if App.windowedMode == false and not App.singleWindow:
			OS.window_fullscreen = true
		Wallpaper.call(\"M2\")

func revertblackoutScreen():
	if(setScreenBlack == true):
		setScreenBlack = false
		if App.windowedMode == false and not App.singleWindow:
			OS.window_fullscreen = false
		get_tree().get_root().set_transparent_background(true)
		OS.window_per_pixel_transparency_enabled = true
		Wallpaper.call(\"M1\")

var revbaudioAs = false
func setAudioMasterReverb(val):
	revbaudioAs = val
	AudioServer.set_bus_effect_enabled(0, 0, val)
	AudioServer.set_bus_effect_enabled(0, 1, val)

func msgBox(Title,BaseText,Icon,Option1,Option2,Timr):
	close(11)
	yield(get_tree(), \"idle_frame\")
	data[\"data\"][11] = {
		\"Title\":str(Title),
		\"BaseText\":str(BaseText),
		\"Icon\":Icon,
		\"Option1\":str(Option1),
		\"Option2\":str(Option2),
		\"Timer\":Timr,
		\"Output\":0 }
	open(11)
	print(data)
	while data[\"data\"][11][\"Output\"] == 0 and data[\"open\"][11] == true:
		yield(get_tree(), \"idle_frame\")
	print(\"msgBox Output:\",data[\"data\"][11][\"Output\"])
	return data[\"data\"][11][\"Output\"]


func inputBox(Title,BaseText,SubText,Timr,MaxChar,CustomReq,timeToClose):
	close(12)
	yield(get_tree(), \"idle_frame\")
	data[\"data\"][12] = {
		\"Title\":str(Title),
		\"Info\":str(BaseText),
		\"SubInfo\":str(SubText),
		\"Timer\":Timr,
		\"CustomReq\":str(CustomReq),
		\"MaxChar\":int(MaxChar),
		\"Output\":\"\",
		\"timeToClose\":0}
	open(12)
	print(data)
	while data[\"data\"][12][\"Output\"] == \"\" and data[\"open\"][12] == true:
		yield(get_tree(), \"idle_frame\")
	print(\"inputBox Output:\",data[\"data\"][12][\"Output\"])
	return data[\"data\"][12][\"Output\"]

func cmdBox(num):
	close(13)
	yield(get_tree(), \"idle_frame\")
	data[\"data\"][13] = num
	open(13)
	while data[\"open\"][13] == true:
		yield(get_tree(), \"idle_frame\")

func screenEffect(Initaleffect, NameOfEffect , EffectDuration , TotalDuration , OtherInfo):
	data[\"data\"][14] = {
		\"InitalEffect\":str(Initaleffect),
		\"NameOfEffect\":str(NameOfEffect),
		\"EffectDuration\":float(EffectDuration),
		\"TotalDuration\":float(TotalDuration),
		\"OtherInfo\":int(OtherInfo),
	}
	open(14)

func gameEffect(Initaleffect, NameOfEffect , EffectDuration , TotalDuration, OtherInfo):
	data[\"data\"][14] = {
		\"InitalEffect\":str(Initaleffect),
		\"NameOfEffect\":str(NameOfEffect),
		\"EffectDuration\":float(EffectDuration),
		\"TotalDuration\":float(TotalDuration),
		\"OtherInfo\":int(OtherInfo),
		\"EffectActive\":true
	}


