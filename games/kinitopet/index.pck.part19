[sub_resource type="GDScript" id=18]
script/source = "extends LineEdit

var info = []
func _ready():
	info = Tab.data[\"data\"][12]
	print(\"info\",info)

var fText = \"\"
func _input(event):
	if(info[\"MaxChar\"] > 0):
		max_length = info[\"MaxChar\"]
	if(info[\"CustomReq\"] == \"ONLYAZ\"):
		var final_text = \"\"
		var regex = RegEx.new()
		regex.compile(\"[a-zA-Z]\")
		var regex_match = regex.search_all(text)
		if regex_match:
			for i in range(0,regex_match.size()):
				final_text += regex_match[i].get_string()
		text = final_text.to_lower().capitalize()
		fText = final_text.to_lower().capitalize()
		caret_position = text.length()
	else:
		fText = text
		caret_position = text.length()
"

