script/source = "extends Node
var mainScreen = 0

func _ready():
	
	OS.set_window_title(\" \");
	OS.window_size = Vector2(1,1)
	OS.window_minimized = true
	Engine.target_fps = 1
	
	
		#get_tree().root.get_node(\"/root/ButtonSfx\").call_deferred(\"free\")
	   #get_tree().root.get_node(\"/root/Tab\").call_deferred(\"free\")
#		get_tree().root.get_node(\"/root/Settings\").call_deferred(\"free\")
	   #get_tree().root.get_node(\"/root/Vars\").call_deferred(\"free\")
	   #get_tree().root.get_node(\"/root/Time\").call_deferred(\"free\")
	
	OS.set_window_always_on_top(true)
	mainScreen = 0
	for screen in OS.get_screen_count():
		if OS.get_screen_position(screen) == Vector2.ZERO:
			mainScreen = screen


func _process(delta):
	var time = OS.get_time()
	var timeNum = int(str(time.hour).pad_zeros(2)+\",\"+str(time.minute).pad_zeros(2)+\",\"+str(time.second).pad_zeros(2))
	if App.data == null:
		get_tree().change_scene(\"res://-Scenes/NewInstance/1/1.tscn\")
	else:
		if App.data[\"data\"][1] == 10: 
			get_tree().change_scene(\"res://-Scenes/NewInstance/1/1.tscn\")
		elif(App.data[\"data\"][1] != 0):
			execute(time,timeNum)


func execute(time,timeNum):
	yield(get_tree(),\"idle_frame\")
	if(timeNum > App.data[\"data\"][2]):
		App._save()
		if(timeNum <= App.data[\"data\"][2] + 10):
			print(\"External Action Triggerd\")
			if(App.data[\"data\"][1] == 10):
				get_tree().change_scene(\"res://-Scenes/NewInstance/1/1.tscn\")
				
			
			if(App.data[\"data\"][1] == 4):
				App.data[\"data\"][2] = 0
				OS.window_minimized = false
				Engine.target_fps = 30
				self.add_child(load(\"res://-Scenes/NewInstance/-1/spider.tscn\").instance())
				
				while (OS.window_minimized == false):
					Engine.target_fps = 30
					yield(get_tree(),\"idle_frame\")
				OS.window_minimized = true
				get_node(\"spider\").queue_free()
#			elif(App.data[\"data\"][1] == 5):
#				App.data[\"data\"][2] = 0
#				OS.window_minimized = false
#				Engine.target_fps = 30
#				self.add_child(load(\"res://-Scenes/NewInstance/-1/FK.tscn\").instance())
#
#				while (OS.window_minimized == false):
#					Engine.target_fps = 30
#					yield(get_tree(),\"idle_frame\")
#				OS.window_minimized = true
#				get_node(\"FK\").queue_free()
				
			if(OS.get_screen_count() > 1):
				if(App.data[\"data\"][1] == 1):
					App.data[\"data\"][2] = 0
					
				elif(App.data[\"data\"][1] == 2):
					App.data[\"data\"][2] = 0
					
					var usedScreen = 0
					if (OS.get_screen_count()-1) != mainScreen:
						usedScreen = OS.get_screen_count()-1
						
					OS.window_minimized = false
					OS.window_position = OS.get_screen_position(usedScreen)
					print(OS.window_position)
					var amt = OS.get_screen_size(usedScreen).x / 1920
					amt = clamp(amt,0.9,100.0)
					$Scale.rect_scale = Vector2(amt,amt)
					OS.window_size = Vector2(119,203)*amt
					OS.window_position = OS.window_position +  (Vector2(250,250)  * amt)
					$Scale/Eye.visible = true
					$Scale/Eye/Audio.play()
					yield(get_tree().create_timer(2.0), \"timeout\")
					$Scale/Eye.visible = false
					
				elif(App.data[\"data\"][1] == 3):
					App.data[\"data\"][2] = 0
					OS.window_minimized = false
					var usedScreen = 0
					if (OS.get_screen_count()-1) != mainScreen:
						usedScreen = OS.get_screen_count()-1
					
					OS.window_position = OS.get_screen_position(usedScreen) + Vector2(OS.get_screen_size(usedScreen).x,OS.get_screen_size(usedScreen).y/2)
					print(OS.window_position)
					var amt = OS.get_screen_size(usedScreen).x / 1920
					amt = clamp(amt,0.9,100.0)
					$Scale.rect_scale = Vector2(amt,amt)
					OS.window_size = Vector2(136,280)*amt
					OS.window_position = OS.window_position - (Vector2(272/2,280/2)  * amt)
					
					$Scale/Jade.visible = true
					$Scale/Jade/AnimationPlayer.play(\"run\")
					yield(get_tree().create_timer(6.0), \"timeout\")
					$Scale/Jade/AnimationPlayer.stop()
					$Scale/Jade.visible = false
				elif(App.data[\"data\"][1] == 5):
					App.data[\"data\"][2] = 0
					OS.window_minimized = false
					var usedScreen = 0
					if (OS.get_screen_count()-1) != mainScreen:
						usedScreen = OS.get_screen_count()-1
					
					OS.window_position = OS.get_screen_position(usedScreen)
					print(OS.window_position)
					var amt = OS.get_screen_size(usedScreen).x / 1920
					amt = clamp(amt,0.9,100.0)
					$Scale.rect_scale = Vector2(amt,amt)
					OS.window_size = Vector2(234,241)*2*amt
					OS.window_position = OS.window_position +  (Vector2(250,250)  * amt)
					#OS.window_position = OS.window_position - (Vector2(234/2,241/2)  * amt)
					$Scale/Face/face/run.play(\"run\")
					$Scale/Face.visible = true
					$Scale/Face/face/Control/AnimationPlayer.play(\"run\")
					yield(get_tree().create_timer(25.0), \"timeout\")
					$Scale/Face/face/Control/AnimationPlayer.stop()
					$Scale/Face.visible = false
						
						
				elif(App.data[\"data\"][1] == 6):
					App.data[\"data\"][2] = 0
					OS.window_minimized = false
					var usedScreen = 0
					if (OS.get_screen_count()-1) != mainScreen:
						usedScreen = OS.get_screen_count()-1
					
					OS.window_position = OS.get_screen_position(usedScreen) + Vector2(OS.get_screen_size(usedScreen).x,OS.get_screen_size(usedScreen).y)
					print(OS.window_position)
					var amt = OS.get_screen_size(usedScreen).x / 1920
					amt = clamp(amt,0.9,100.0)
					$Scale.rect_scale = Vector2(amt,amt)
					OS.window_size = Vector2(212,107)*amt
					OS.window_position = OS.window_position - (Vector2(212+50,107+50)  * amt)
					#OS.window_position = OS.window_position - (Vector2(234/2,241/2)  * amt)
					$Scale/Spider/Sprite/run.play(\"run\")
					$Scale/Spider.visible = true
					yield(get_tree().create_timer(25.0), \"timeout\")
					$Scale/Spider/Sprite/run.stop()
					$Scale/Spider.visible = false
				else:
					App.data[\"data\"][2] = 0
				
				OS.window_position = Vector2(0, 0 )
				OS.window_size = Vector2(1,1)
				OS.window_minimized = true
				Engine.target_fps = 1
				App.data[\"data\"][1] = 0
		else:
			App.data[\"data\"][2] = 0
			App.data[\"data\"][1] = 0
		App._save()
		Engine.target_fps = 6
	pass
"

