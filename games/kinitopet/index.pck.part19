[sub_resource type="GDScript" id=1]
script/source = "extends Node

const SafeSave = preload(\"res://Script/SafeSave.gd\")

var memorys = 0
var savepath = \"user://Kinitopet_DATA/ACTIVE.data\"
#get_process_ID 

var data = {\"open\":[],\"data\":[],\"pos\":[], \"dskhide\": 0, \"wp\": -1, \"next\": 0,\"PID\":0}
var _pid = int(0)
var current = 0
var closing = false
var allowclose = false
var resetAll = false
var mods = []

var steamWorking = false
# Single window mode.
#
# The game was built as cooperating processes: a launcher (-1) that pops scares
# over your desktop, the game itself (0), and the \"your world\" window (1). That
# needs process spawning and a transparent window floating over a real desktop,
# neither of which exists in a browser tab. With this on, one process runs
# everything and the windows that used to be separate are drawn inside the scene.
#
# The multi-process code is all still here, just not taken - set this to false
# to get the original behaviour back on desktop.
var singleWindow = true

const FakeWindow = preload(\"res://-Scenes/Global/FakeWindow.gd\")
var _inSceneInstances = {}


var recording = false


var monitor = 0
var windowedMode = false

var ValidMonitor = true

var initSize = Vector2.ZERO

var luckynum = \"000\"
var kinitoNotTodayZone = false
var CMDopen = false
var originialScreenSize = Vector2.ZERO
func _ready():
	PointerLock.install()
	BackgroundRun.install()
	if OS.has_feature(\"HTML5\"):
		# Two of Godot 3's GLES3 screen-space effects come out as uninitialised
		# memory through ANGLE - which is what Chrome uses on Linux and Windows, and
		# what several other browsers use too. The whole 3D viewport renders as
		# coloured static. Firefox's native GL path is fine, which is why it read as
		# a driver quirk rather than a bug.
		#
		# Both were found by bisecting the real scenes in Chrome on the GPU:
		#   depth of field   the hide-and-seek minigame  25.1% noise -> 1.0%
		#   ss reflections   the ending credits          34.0% noise -> 0.2%
		# Everything else was ruled out first: the NTSC, bloom and blur passes, the
		# motion-blur quad, the viewport update mode, mip-level sampling, glow,
		# auto-exposure and colour adjustment all made no difference.
		#
		# Hooked on node_added rather than edited into the .tres files, so the
		# effects survive for any desktop build and only the web loses them.
		get_tree().connect(\"node_added\", self, \"_dropBrokenPostProcess\")
	print(\" \")
	print(\" \")
	print(\"\\n\\n\\n\\n\\n\")
	print(\"<!> Are you having issues with my poorley written code? <!>\")
	print(\"\"\"In which case please head on over to the discord server to dm me 
	your problems - discord.gg/GZfJqdM7au - I will try my best to fix it!\"\"\")
#	print(\"--[Stuff I may use for debugging]--\")
#	print(\"screen_orientation: \",(str(OS.screen_orientation)))
#	print(\"screen_size(0): \",(str(OS.get_screen_size(0)))
#	print(\"\")
	print(\"---\")
	print(\"\"\"Hey I know from the nature of this game you want to look through the files for lore / clues however - 
	This game is quite experimental in the things it does and thus my poorley written code will make mistakes, 
	because of this I have chosen to leave logs into the finial build so I can bug fix the game. 
	That being said there is NO hidden things in here. This is literally just to bug fix my bad code. 
	SO if you find something in here please know it was not intentonal and for your sake its better to get 
	infromation in the way that I want to present - this is not the way...\"\"\")
	print(\"---\")
	print(\"\\n\\n\\n\\n\\n\\n\\n\\n\")
	print(\" \")
	print(\" \")
	print(\" \")
	yield(get_tree(),\"idle_frame\")
	randomize()
	luckynum = str(clamp(int(rand_range(0,999)),0,999)).pad_zeros(2)
	
	
	var primarySize = $ScreenSize._PrimaryScreenSize()
	print(primarySize)
	
	
	for scr in range(OS.get_screen_count()):
		if OS.get_screen_size(scr) == primarySize:
			monitor = scr
	
	print(\"monitor primary:\",str(monitor))
	#print(OS.get_screen_size(monitor))
	OS.set_current_screen(monitor)
	originialScreenSize = OS.get_screen_size(monitor)
	initSize = $ScreenSize._ScreenSize()
	print(\"initresult: \",str(initSize))
	if initSize == Vector2.ZERO:
		print(\"initsize fail fallback enabled\")
		initSize = Vector2(OS.get_screen_size(monitor).x,OS.get_screen_size(monitor).y-10)
	elif initSize == Vector2(OS.get_screen_size(monitor).x,OS.get_screen_size(monitor).y):
		print(\"user has odd setting enabled, fallback enabled\")
		initSize = Vector2(OS.get_screen_size(monitor).x,OS.get_screen_size(monitor).y-10)
	print(initSize)
	
	if Settings.settings.Windowed == true:
		windowedMode = true
		#OS.alert(\"Warning: You are playing in windowed mode.\")
	else:
		if initSize.x < initSize.y   or    initSize.x > initSize.y*2.35:
			#OS.alert(\"This monitor size is NOT recommended. The game is best experienced in a 16:9 aspect ratio. Please configure your main screen for this.  The game will continue to boot in windowed mode \")
			windowedMode = true
	

	_initiMemorys()
	_arrangeData()
	_initalise()
	#print(\"detect record:\")
	_detectRecord()
	


func _renderSize():
	# The size of the space the game lays itself out in - always the 1920x1080
	# base, whatever the window is doing.
	#
	# Under window/stretch/mode=\"2d\" Godot keeps TWO sizes on the root viewport:
	#   .size                    - the physical drawn area, e.g. (1000, 562) in a
	#                              1000x800 window once the letterbox is removed
	#   .get_visible_rect().size - the stretch base, always (1920, 1080)
	# They are equal only when the window happens to be exactly 1920x1080, which
	# is why reading .size looked correct and then put everything that centres
	# itself against ScreenSize at the wrong midpoint on every other size.
	var v = get_tree().get_root().get_visible_rect().size
	if v.x < 1 or v.y < 1:
		return OS.window_size
	return v

func _kinitoSavedPosition():
	# Kinito's position is persisted so he comes back where he was left. He used
	# to be his own OS window; now he is a node inside this one, so his position
	# is the one Tab holds. Tab only publishes those once it has started, so fall
	# back to the stored value until then rather than indexing an empty array.
	if not singleWindow:
		return OS.window_position
	if Tab.startdone and Tab.data[\"pos\"].size() > 1:
		return Tab.window_position(1)
	return data[\"pos\"][1]


func _fallbackMouse(node):
	# Spatial has no get_global_mouse_position(); only CanvasItem does.
	if node.has_method(\"get_global_mouse_position\"):
		return node.get_global_mouse_position()
	return get_tree().get_root().get_mouse_position()


func _viewportMouse(node):
	# The mouse position inside a sub-Viewport, in that viewport's own coordinates.
	#
	# Godot 3 never applies the root's stretch transform on the sub-viewport input
	# path. get_global_mouse_position() called inside one comes back as the raw
	# window-pixel mouse with only the ViewportContainer's origin subtracted and
	# its scale left in, so it is correct only when the window happens to be
	# exactly the base resolution. Measured at a 1000x800 window: the root
	# reported (1728, 1007), which is right, while the sub-viewport reported
	# (775, 525).
	#
	# Deriving it from the root instead holds at any window size - the root's
	# mouse IS stretch-corrected, and the container's transform maps render space
	# into the viewport's own. At 1920x1080 this returns exactly what the old
	# expression did, so nothing changes at the base resolution.
	var vp = node.get_viewport()
	var root = get_tree().get_root()
	if vp == null or vp == root:
		return _fallbackMouse(node)
	var container = vp.get_parent()
	if not (container is ViewportContainer):
		return _fallbackMouse(node)
	var xform = container.get_global_transform_with_canvas()
	if container.stretch and container.stretch_shrink > 1:
		# Mirrors ViewportContainer's own input handling: right-multiplied, so the
		# shrink scales the basis without moving the origin.
		var shrink = Transform2D().scaled(Vector2(container.stretch_shrink, container.stretch_shrink))
		xform = xform * shrink
	return xform.affine_inverse().xform(root.get_mouse_position())


func _viewportMouseUnscaled(node):
	# The same sub-viewport correction as _viewportMouse, but it fixes only the
	# container's position, not its scale.
	#
	# Some scenes were authored against the broken value and already carry their
	# own hand-tuned constants to undo the container scale - the 3D computer's
	# login screen multiplies by 2.5 and 2.3 against a container scaled 0.399465
	# and 0.447223. Dividing the scale out here too would double-correct and move
	# the cursor at 1920x1080, where those scenes currently look right, so this
	# only fixes the part that actually varies with the window size.
	var vp = node.get_viewport()
	var root = get_tree().get_root()
	if vp == null or vp == root:
		return _fallbackMouse(node)
	var container = vp.get_parent()
	if not (container is ViewportContainer):
		return _fallbackMouse(node)
	return root.get_mouse_position() - container.get_global_transform_with_canvas().get_origin()


const PointerLock = preload(\"res://Script/PointerLock.gd\")
const BackgroundRun = preload(\"res://Script/BackgroundRun.gd\")

# The node that asked for the mouse. Capture lasts exactly as long as it is in
# the tree: the scenes that grab the mouse never hand it back explicitly (the
# Windows original relied on the next scene setting it visible), so without this
# the want-flag outlived the scene and clicks on the desktop afterwards would
# yank the cursor away again.
var _captureOwner = null
var _mouseFlags = [false, false]


func captureMouse(enable = true, owner = null):
	if enable:
		if owner != null and owner != _captureOwner:
			if not owner.is_connected(\"tree_exiting\", self, \"_captureOwnerLeft\"):
				owner.connect(\"tree_exiting\", self, \"_captureOwnerLeft\", [owner])
		_captureOwner = owner
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	else:
		_captureOwner = null
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	_syncMouseToBrowser(true)


func _captureOwnerLeft(owner):
	if _captureOwner != owner:
		return
	captureMouse(false)


func _mouseIsLocked():
	return PointerLock.isLocked()


func _syncMouseToBrowser(force = false):
	# The browser cannot be told to lock from here - only a real click can do that
	# (see PointerLock.gd). All this does is keep the DOM side informed of what the
	# game currently wants, so the listener there knows whether to act.
	#
	# Hidden is read straight from the engine because \"your world\" sets it directly
	# every frame rather than going through captureMouse().
	var wantLock = _captureOwner != null and is_instance_valid(_captureOwner)
	var wantHide = Input.get_mouse_mode() == Input.MOUSE_MODE_HIDDEN
	if not force and [wantLock, wantHide] == _mouseFlags:
		return
	_mouseFlags = [wantLock, wantHide]
	PointerLock.setWant(wantLock, wantHide)


func _openExternal(target):
	# The Windows build shelled out constantly: folders, .exe, .bat, .vbs, and
	# shell URIs like \"microsoft.windows.camera:\". A browser can do none of that,
	# and OS.shell_open() on HTML5 just opens a new tab - which throws the player
	# out of the game for a link that leads nowhere. So it does nothing.
	#
	# PNGs are the exception. Those are content the player is meant to look at,
	# and they can be served alongside the build.
	var t = str(target)
	if t.to_lower().ends_with(\".png\"):
		return OS.shell_open(t)
	print(\"KinitoPET: external open ignored -> \", t)
	return OK


func farewell(lines):
	# The game is over and is asking to be reloaded. Black the whole screen out
	# first, let that actually reach the canvas, show the messages, then close the
	# tab.
	#
	# The ordering matters: window.alert() blocks the browser's main thread, and
	# Godot renders on that same thread. Anything not already presented when the
	# first alert fires stays invisible until every one of them is dismissed - so
	# the blackout has to be given real frames before the first box, not just be
	# added to the tree.
	var layer = CanvasLayer.new()
	layer.layer = 128
	var rect = ColorRect.new()
	rect.color = Color(0, 0, 0, 1)
	rect.anchor_right = 1.0
	rect.anchor_bottom = 1.0
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(rect)
	get_tree().get_root().add_child(layer)

	yield(get_tree(), \"idle_frame\")
	yield(get_tree(), \"idle_frame\")
	yield(get_tree().create_timer(0.35), \"timeout\")

	# The game ends here, so the audio is muted and stays muted.
	var boxes = _messageBoxes(lines, false)
	if boxes is GDScriptFunctionState:
		yield(boxes, \"completed\")
	_closeBrowserTab()
	get_tree().quit()


func _closeBrowserTab():
	# Named for the browser, because _closeTab(i) already means \"close app tab i\".
	if not (OS.has_feature(\"HTML5\") and Engine.has_singleton(\"JavaScript\")):
		return
	# window.close() only succeeds for windows a script opened, so a tab the player
	# opened themselves will refuse it. Blanking the document is the fallback - the
	# game is gone either way, rather than sitting there frozen.
	#
	# Kept on one line and quoted with ' inside: a GDScript triple-quoted string
	# does not survive being stored in a .tscn, where every \" becomes \\\".
	Engine.get_singleton(\"JavaScript\").eval(\"(function(){try{window.close();}catch(e){}setTimeout(function(){document.documentElement.style.background='#000';if(document.body){document.body.style.background='#000';while(document.body.firstChild)document.body.removeChild(document.body.firstChild);}},250);})();\", true)


const MASTER_BUS = 0
# Long enough for the silence to be mixed and handed to the audio device before
# the thread stops being able to feed it.
const ALERT_MUTE_LEAD = 0.25


func _messageBoxes(lines, restoreAudio = true):
	# The Windows build kept these messages in .vbs scripts full of msgBox()
	# calls and handed them to the shell (extra/msg1.vbs, extra/msg2.vbs).
	# Nothing here can run a .vbs, so they go through the browser instead.
	#
	# NOT OS.alert(): it does not raise a dialog on the HTML5 export. The
	# JavaScript singleton does - window.alert() blocks the page exactly the way
	# msgBox() blocked, so the lines still arrive one at a time and each has to be
	# dismissed before the next appears. (Godot 4 renamed this singleton to
	# JavaScriptBridge; on 3.5 it is JavaScript.)
	if lines.empty():
		return
	if not (OS.has_feature(\"HTML5\") and Engine.has_singleton(\"JavaScript\")):
		for line in lines:
			OS.alert(line, \"KinitoPET\")
		return

	# window.alert() blocks the browser's main thread, and Godot's audio callback
	# runs on that same thread - so the sound tears itself apart for as long as a
	# box is up, exactly as the print dialog did. Nothing can run during the
	# block, so the silence has to already be in the pipeline before it starts.
	var wasMuted = AudioServer.is_bus_mute(MASTER_BUS)
	AudioServer.set_bus_mute(MASTER_BUS, true)
	yield(get_tree().create_timer(ALERT_MUTE_LEAD), \"timeout\")

	var js = Engine.get_singleton(\"JavaScript\")
	for line in lines:
		# JSON.print() gives a correctly quoted and escaped JS string literal.
		js.eval(\"window.alert(\" + JSON.print(line) + \");\", true)

	if restoreAudio:
		AudioServer.set_bus_mute(MASTER_BUS, wasMuted)


func _screenSize():
	# \"The screen\", for anything laying itself out.
	#
	# Every window the game used to open on the desktop now lives inside the one
	# real window, so the game's screen is its own render space, not the monitor.
	# OS.get_screen_size() still answers with the physical monitor, which is a
	# different size and often a different aspect, so using it to place or scale
	# a node put that node somewhere off in the letterbox.
	if singleWindow:
		return _renderSize()
	return OS.get_screen_size(monitor)


func _windowOrigin():
	# Where the game's window sits, in the coordinates the game lays out in.
	# With one window that window IS the screen, so its origin is the origin.
	# OS.window_position is wherever the user dragged the game on their desktop,
	# which has nothing to do with in-game coordinates.
	if singleWindow:
		return Vector2.ZERO
	return OS.window_position


func setNodeScale():
	var s = _renderSize()
	Vars.set(\"nodeScale\",Vector2( s.y/1080 , s.y/1080) )
	#Vars.set(\"nodeScale\",Vector2( (round((OS.window_size.y/1080)*10))/10 , (round((OS.window_size.y/1080)*10))/10) )

func _on_viewport_size_changed():
	# The canvas is resized whenever the browser window changes, and windows can
	# be resized on desktop too. ScreenSize and nodeScale are read all over the
	# game for layout but were only ever set once at boot, so everything stayed
	# pinned to whatever size the game happened to start at.
	var size = _renderSize()
	if size.x < 1 or size.y < 1:
		return
	setNodeScale()
	Vars.set(\"ScreenSize\", size)
	Tab._resize()
	# Anything that laid itself out from ScreenSize in _ready() needs to redo it.
	# Nodes opt in by joining the \"relayout\" group and implementing _relayout();
	# this runs after the values above are refreshed, so ordering is guaranteed.
	get_tree().call_group(\"relayout\", \"_relayout\")
#	#print (\"Viewport size changed\")
#	if windowedMode:
#		Tab._resize()
#		setNodeScale()
#		pass

func _initialize_Steam():
