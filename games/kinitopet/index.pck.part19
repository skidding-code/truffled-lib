[sub_resource type="GDScript" id=14]
script/source = "extends Node2D
export var animation = false
onready var player = $char

func _physics_process(delta):
	if(animation):
		$Master.visible = false
	else:
		$Master.visible = true
	
	if(player.position.y < 30):
		$Master/A.visible = true
	else:
		$Master/A.visible = false	
	if(player.position.y < 20):
		$Master/C.visible = true
	else:
		$Master/C.visible = false
	if(player.position.y < 6):
		$Master/F.visible = true
	else:
		$Master/F.visible = false
	if(player.position.y < 6):
		$Master/O.visible = true
	else:
		$Master/O.visible = false



func _on_H2_button_down():
	pass # Replace with function body.
"

