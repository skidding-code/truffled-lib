[sub_resource type="GDScript" id=4]
script/source = "extends LineEdit
var rng = RandomNumberGenerator.new()
func _ready():
	rng.randomize()
func _on_Password_TextEdit_text_entered(new_text):
	if(new_text != \"\"):
		if(\" \" in new_text):
			new_text = new_text.split(\" \")
			new_text = new_text[rng.randi_range(0,new_text.size())]
			
		Vars.set(\"SearchTerm\",new_text)
		get_parent().get_parent().get_parent().get_parent().get_node(\"BG/Other/Bottom/AnimationPlayer\").play(\"DD\")
		yield(get_tree().create_timer(3.0), \"timeout\")
		Tab.scene(\"res://-Scenes/Application005/Main/Web/InternetPMT.tscn\")
"

