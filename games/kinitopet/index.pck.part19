[sub_resource type="GDScript" id=66]
script/source = "extends Sprite

func _ready():
	frame = 0

func _on_Button_mouse_entered():
	frame = 1
	Vars.set(\"WebWRLD_Mouse_Select\",true)
	Vars.set(\"WebWRLD_Mouse_Mode\",0)

func _on_Button_mouse_exited():
	frame = 0
	Vars.set(\"WebWRLD_Mouse_Mode\",1)

func _on_Button_button_down():
	Vars.set(\"WebWRLD_Mouse_Press\",true)
	Vars.set(\"WebWRLD_Mouse_Mode\",1)
"

