script/source = "extends Spatial

func _ready():
	#Tab._closeAll(30)
	#Tab.close(0)
#	self.visible = false
	yield(get_tree().create_timer(19.5,false), \"timeout\")
	get_tree().get_root().set_transparent_background(false)
#	self.visible = true

	if App.singleWindow:
		pass
	elif App.windowedMode:
		App._windowMode()
	else:
		OS.window_size = App.initSize
		OS.window_position = Vector2.ZERO
	
	#Tabset_window_position(19,OS.window_position * Vars.get(\"nodeScale\"))
	
	
	Wallpaper.call(\"M2\")
	
	
	AudioServer.set_bus_mute(AudioServer.get_bus_index(\"MandKsounds\"),true)
"

