[sub_resource type="GDScript" id=81]
script/source = "extends Spatial
var inputName = \"\"
onready var material = preload(\"res://Act3/FunFair/title.material\")
var lastP = 0
func _ready():
	
	inputName = Data.data[\"name\"]
	inputName = inputName.replace(\"_\",\"\")
	if inputName[inputName.length()-1].to_lower() != \"s\":
		inputName += \"s\"
	App.setWorldWindowTitle((inputName+\"_World.exe\").to_lower())
	Vars.set(\"YOURWORLD_exename\",(inputName+\"_World.exe\").to_lower())
	for idx in range(inputName.length()):
		var letter = inputName[idx]
		print(\"Letter:\", letter, \"Position:\", idx)
		
		if letter == letter.to_lower():
			letter = \"0\"+letter.to_upper()
		var letterOBJ = MeshInstance.new()
		# .obj, like every model source in this decompile, is not on disk - only the
		# imported .mesh beside it. Scene references were repointed wholesale, but
		# this one builds its path at runtime, so it kept asking for the .obj,
		# got null, and the name simply never appeared between \"Welcome to:\" and
		# \"World\".
		letterOBJ.mesh = load(\"res://Act3/3D_TEXT/\"+letter+\".mesh\")
		if material:
			letterOBJ.mesh.surface_set_material(0, material)
		else:
			print(\"Failed to load material.\")
		letterOBJ.translation.x = idx*0.5
		lastP = letterOBJ.translation.x
		add_child(letterOBJ)
		
		#self.translation.x = -(lastP/2)
"

