[sub_resource type="GDScript" id=29]
script/source = "extends AnimationPlayer

var current = \"\"
func _process(delta):
	if Vars.get(\"Survey_Formate\") != null:
		if current != Vars.get(\"Survey_Formate\"):
			current = Vars.get(\"Survey_Formate\")
			play(str(current))
	pass
"

