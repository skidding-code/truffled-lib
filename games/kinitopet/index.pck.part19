[sub_resource type="GDScript" id=1]
script/source = "extends Spatial
export var start_pos = Vector2(0,0)
export var end_pos = Vector2(0,0)
export var speed = 0.2
var new_pos = Vector2(0,0)
var at_end = false
var loop = 0
var t = 0.0
func _ready():
	
	$Hand/A/H1/A.play(\"I\")
	$Hand/A/H2/A.play(\"I\")
	speed = 0.4
	start_pos = Tab.window_position(1) - Tab.data[\"data\"][2][1] + (Vector2(100,270)*Vars.get(\"nodeScale\").x )
	end_pos = Tab.window_position(Tab.data[\"data\"][2][0])
	$Hand.look_at(Vector3((end_pos.x)-start_pos.x,(start_pos.y + (start_pos.y-end_pos.y)-start_pos.y),0),Vector3.FORWARD)
	_Start()

#if((Tab.window_position(1) - Tab.data[\"data\"][2][1] + Vector2(100,270)).x - ().x > 0):


#Tab.data[\"data\"][2][3] = = 1

func _physics_process(delta):
	#$Hand.look_at(Vector3($TEST.translation.x,$TEST.translation.y,0),Vector3.FORWARD)
	if(at_end == false):
		t += delta * (speed)
		if(loop == 1):
			if(Tab.data[\"data\"][2][3]) == 0:
				Tab.set_window_position(Tab.data[\"data\"][2][0], (start_pos.linear_interpolate(end_pos, t)) )
		Tab.set_window_position(2, (start_pos.linear_interpolate(end_pos, t)) +  Tab.data[\"data\"][2][1])
		if(t >= 1.0):
			
			if(loop == 0):
				if(Tab.data[\"data\"][2][3]) == 1:
					Tab.data[\"data\"][2][0] = -1
					Tab.close(2)
				else:
					$Hand/A/H1/A.play(\"O\")
					$Hand/A/H2/A.play(\"O\")
					speed = 0.3
					loop = 1
					at_end = true
					new_pos = start_pos
					start_pos = end_pos
					end_pos = Tab.data[\"data\"][2][2]
					_Start()
			elif(loop == 1):
				if(Tab.data[\"data\"][2][3]) == 1:
					Tab.data[\"data\"][2][0] = -1
					Tab.close(2)
				else:
					t = 0.0
					loop = 2
					
					$Hand/A/H1/A.play(\"I\")
					$Hand/A/H2/A.play(\"I\")
					speed = 0.8
					at_end = true
					new_pos = start_pos
					start_pos = end_pos
					end_pos = Tab.window_position(1) - Tab.data[\"data\"][2][1]  + (Vector2(100,270)*Vars.get(\"nodeScale\").x )
					_Start()
			else:
				Tab.data[\"data\"][2][0] = -1
				Tab.close(2)

func _Start():
	
	if(start_pos.x - end_pos.x > 0):
		$Hand/A/H1.visible = false
		$Hand/A/H2.visible = true
	else:
		$Hand/A/H1.visible = true
		$Hand/A/H2.visible = false
	t = 0.0
	at_end = false
"

