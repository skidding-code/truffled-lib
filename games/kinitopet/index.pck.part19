[sub_resource type="GDScript" id=1]
script/source = "extends Control

func _on_X_button_up():
	get_parent().get_parent().get_parent().get_node(\"AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0,false), \"timeout\")
	Tab.set_window_position(2,Vector2(-100,-100))
	yield(get_tree().create_timer(4.0,false), \"timeout\")
	Tab.open_note(0)
	Tab.close(3) 
"

