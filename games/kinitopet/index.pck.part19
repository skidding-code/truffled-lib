[sub_resource type="GDScript" id=3]
script/source = "extends ScrollContainer
export var limit = 80


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	if self.scroll_vertical > limit: self.scroll_vertical =limit
"

[sub_resource type="GDScript" id=4]
script/source = "extends Sprite
func _on_Button_button_down():
	frame = 1
func _on_Button_button_up():
	yield(get_tree().create_timer(0.35,false), \"timeout\")
	Vars.set(\"MEMBER_installed\",true)
	get_parent().get_parent().get_parent().get_parent().get_node(\"BG/Other/Bottom/AnimationPlayer\").play(\"D\")
	
"

