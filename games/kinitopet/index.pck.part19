	var soloSize = Vector2(451,352)*1.5  * Vars.get(\"nodeScale\")
	if App.singleWindow:
		# Deliberately leaves the survey exactly where it is.
		#
		# The original moved the real window BY the survey's position and then drew
		# the survey at 0,0 inside it - so the window shrank around the survey and
		# the survey itself never moved on screen. It sits where its Center node put
		# it, which is near the middle but offset by that node's multi factor, not
		# dead centre. Re-centring it here would move it somewhere it never was.
		# The other apps are closed above, so it is the only thing left on screen.
		pass
	else:
		OS.window_borderless = true
		OS.window_size = soloSize
		OS.window_position +=  window_position(19) 
		Tab.set_window_position(19, Vector2(0,0) )
	appParent.remCam()


