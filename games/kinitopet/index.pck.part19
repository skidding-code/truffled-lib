[sub_resource type="GDScript" id=23]
script/source = "extends Node2D


func _ready():
	_jumble()


func _jumble():
	get_node(\"4\").raise()
	for i in range(5):
		get_node(str(i)).name = \"temp_\"+str(i)
	get_node(\"temp_4\").name = \"0\"
	get_node(\"temp_0\").name = \"1\"
	get_node(\"temp_1\").name = \"2\"
	get_node(\"temp_2\").name = \"3\"
	get_node(\"temp_3\").name = \"4\"
	yield(get_tree().create_timer(2.0,true), \"timeout\")
	_jumble()


# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass
"

[sub_resource type="GDScript" id=24]
script/source = "extends TextureRect
export var num = 0
export var tload = false

func _process(delta):
	if tload:
		tload = false
		_load()
	

func _load():
	var url =  (OS.get_user_data_dir()+\"/Kinitopet_DATA/Make_DATA/r\"+str(num)+\".data\")
	var file = File.new()
	if file.open(url, File.READ) == OK:
		var file_data = file.get_buffer(file.get_len())
		file.close()
		
		var image = Image.new()
		
		# Load the PNG data from the buffer
		if image.load_png_from_buffer(file_data) == OK:
			var texture = ImageTexture.new()
			texture.create_from_image(image)
			self.texture = texture
			
			rect_size = texture.get_size()
			rect_scale.x = (260/texture.get_size().x)
			rect_scale.y = (155/texture.get_size().y)
			
			print(\"Image Loaded.\")
			if num == 4:
				Vars.set(\"Survey_OBS\",true)
				var dir = Directory.new()
				dir.remove(url)
				
		else:
			print(\"Failed to load image from file.\")
	else:
		print(\"Failed to open file:\", url)

func load_external_tex(path):
	var tex_file = File.new()
	tex_file.open(path, File.READ)
	var bytes = tex_file.get_buffer(tex_file.get_len())
	var img = Image.new()
	var data = img.load_png_from_buffer(bytes)
	var imgtex = ImageTexture.new()
	imgtex.create_from_image(img)
	tex_file.close()
	return imgtex
"

