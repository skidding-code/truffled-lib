[sub_resource type="GDScript" id=1]
script/source = "extends Control
var InGame = false

func _ready():
	yield(get_tree().create_timer(3.0,false), \"timeout\")
	Vars.set(\"OnApp\",\"PinBall\")


func _on_X_button_up():
	$OC.play(\"C\")
	yield(get_tree().create_timer(0.2,false), \"timeout\")
	Tab.close(22)


func _on_ViewportContainer_mouse_entered():
	InGame = true

func _on_ViewportContainer_mouse_exited():
	InGame = false
"

[sub_resource type="GDScript" id=2]
script/source = "extends Node2D
export var value = 0
var setval = 0
var achiveset = false
func _process(delta):
	value = get_parent().get_node(\"ViewportContainer/Viewport/M\").score*50
	
	if value >= 9999999:
		if(achiveset == false):
			achiveset = true
			Steam.setAchievement(\"Overflow\")
			Steam.storeStats()
			print(\"Achivement\")
			pass
	
	setval = int(clamp(value,0,9999999))
	$\"6\".frame = int((str(setval).pad_zeros(7))[6])
	$\"5\".frame = int((str(setval).pad_zeros(7))[5])
	$\"4\".frame = int((str(setval).pad_zeros(7))[4])
	$\"3\".frame = int((str(setval).pad_zeros(7))[3])
	$\"2\".frame = int((str(setval).pad_zeros(7))[2])
	$\"1\".frame = int((str(setval).pad_zeros(7))[1])
	$\"0\".frame = int((str(setval).pad_zeros(7))[0])

"

