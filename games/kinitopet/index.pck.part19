[sub_resource type="GDScript" id=20]
script/source = "extends RichTextLabel

func _ready():
	_on_HSlider_value_changed((Settings.settings[\"mastervolume\"] +25)* 3)

func _on_HSlider_value_changed(value):
	if(value > 0):
		
		if value > 100:
			bbcode_text = \"[color=#c20010][shake rate=100.0 level=\"+str(value-100)+\"]\"+str(value)+\"%\"
		else:
			bbcode_text = str(value)+\"%\"
		Settings.settings[\"mastervolume\"] = ((value/3 - 25))
	else:
		bbcode_text = \"0%\"
		Settings.settings[\"mastervolume\"] = -80
"

