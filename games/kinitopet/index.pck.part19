[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var InfoBox = Tab.data[\"data\"][12] 


func _ready():
	print(InfoBox)

	
	$Title.text = InfoBox[\"Title\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	print(\"0\")
	#$\"Asset/2/DymamicSpacer\".rect_scale.x = -1.8 + ((float($\"Asset/2/T5\".text.length())/40))
	print(\"3\")
	
	
	
	$\"Asset/2/Box_Text\".bbcode_text = InfoBox[\"Info\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	print(\"1\")
	$\"Asset/2/sub_text\".bbcode_text = InfoBox[\"SubInfo\"].replace(\"[name]\",str(Vars.get(\"player_name\")))
	print(\"2\")

	print(InfoBox)
	
	if(Tab.data[\"data\"][12][\"Timer\"] > 0):
		print(InfoBox)
		yield(get_tree().create_timer(float(  Tab.data[\"data\"][12][\"Timer\"]  ),false), \"timeout\")
		get_parent().get_node(\"AnimationPlayer\").play(\"0\")
		yield(get_tree().create_timer(0.6,false), \"timeout\")
		Tab.close(12)
"

