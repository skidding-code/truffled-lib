[sub_resource type="GDScript" id=1]
script/source = "#======================================================#
#       Generates file and stores settings data        #
#======================================================#
# > Auto_load script 

extends Node

const SafeSave = preload(\"res://Script/SafeSave.gd\")

var enabled = true
var file = File.new()
var savefile = \"user://Kinitopet_DATA/SETTINGS.data\"
#recording = false
var settings = {\"acknowledge\": 0,\"mastervolume\": 0,\"muiscvolume\":0,\"MandKsounds\":0,\"Ambiance\":0,\"PCsound\":0,\"CustomDesktop\":true,\"CustomBackground\":true,\"Windowed\":false, \"Recording\":false , \"manualREC\":false }

func _ready():
	_exists()
#	print(Steam.userHasLicenceForApp(Steam.getSteamID(),2075070))
func _acknowledge():
	if(settings[\"acknowledge\"] == 0):
		settings[\"acknowledge\"] = 1
		_save()
var manul = false
func _save():
	#if settings.Recording:
	App.recording = settings.Recording
	SafeSave.write_var(savefile, settings)
	_load()
	
func _load():
	# Shared across every instance of the game; a read can land mid-write, so
	# fall back to the settings already in memory instead of a null.
	settings = SafeSave.read_var(savefile, settings)
	if settings.has(\"Recording\") == false:
		settings[\"Recording\"] = false
	if settings.has(\"manualREC\") == false:
		settings[\"manualREC\"] = false
	if settings.has(\"disableendCRT\") == false:
		settings[\"disableendCRT\"] = false
		#disableendCRT
#	if manul:
#		manul = false
#		settings.Recording = true
	App.recording = settings.Recording
func _exists():
	if(file.file_exists(savefile) == true):
		_load()
	_save()
	
func _process(delta):
	if enabled:
		if(AudioServer.get_bus_volume_db(0)+8*1.5 != (settings.mastervolume+8*1.5)):
			AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"Master\"),(settings.mastervolume+8*1.5))
		if(AudioServer.get_bus_volume_db(0) != (settings.MandKsounds)):
			AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"MandKsounds\"),(settings.MandKsounds))
		if(AudioServer.get_bus_volume_db(0)-5 != (settings.Ambiance-5)):
			AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"Ambiance\"),(settings.Ambiance-5))
		if(AudioServer.get_bus_volume_db(0) != (settings.PCsound)):
			AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"PC\"),(settings.PCsound))
		if(AudioServer.get_bus_volume_db(0) != (settings.muiscvolume)):
			AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"Music\"),(settings.muiscvolume))
#	if(settings.CustomDesktop == true):
#		pass
	
	pass



#	if(file.open_encrypted_with_pass(savefile, File.READ, OS.get_unique_id()) != OK):
#		var dir = Directory.new()
#		dir.remove(savefile)
## warn`ng-ignore:return_value_discarded
#		get_tree().reload_current_scene()

"

