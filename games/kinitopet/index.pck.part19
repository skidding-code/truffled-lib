[sub_resource type="GDScript" id=1]
script/source = "extends Control
var one_time = false
var one_time2 = false
func _ready():
	if Vars.get(\"KinitoWebWorld\") == \"HomeFromReadyRepair\" or  Vars.get(\"KinitoWebWorld\") == \"HomeFromFactoryFrenzy\" :
		get_node(\"GameWorld/StartScreen\").visible = false
	pass
func _process(delta):
	if(Vars.get(\"KinitoWebWorld\") == \"ReadyRepairEND\" ):
		if(one_time == false):
			one_time = true
			get_node(\"GameWorld/Game1\").queue_free()
			get_node(\"GameWorld/WorldMap\").visible = true
	elif(Vars.get(\"KinitoWebWorld\") == \"FactoryFrenzyEND\" ):
		if(one_time2 == false):
			one_time2 = true
			get_node(\"GameWorld/Game2\").queue_free()
			get_node(\"GameWorld/WorldMap\").visible = true
	
	
"

[sub_resource type="GDScript" id=2]
script/source = "extends Node
#var effects = {\"shake\":0.0,\"zoom\":1.0,\"zoom_tab\":-1,\"zoom_offset\":Vector2(0,0),\"spotlight\":0.0,\"spotlight_lerp\":2.0,\"spotlight_spot_mouse\":false,\"load\":false}
export var ACTIVE = false

export var zoom = 1.0
export var zoom_tab = 5
export var zoom_offset = Vector2(518,450)
#301 392 offset = Sam
#518 450
func _process(delta):
	if(ACTIVE):
		Tab.effects[\"zoom\"] = zoom
		Tab.effects[\"zoom_tab\"] = zoom_tab
		Tab.effects[\"zoom_offset\"] = zoom_offset
"

