class CreateDrunkenTerrainJob extends Job:
	var _tabToLoad = -1
	func _init(request:Node, callback:String, i:int).(request, callback) -> void:
		_tabToLoad = i
		pass
	# runs on background thread
	func _load() -> Array:
		var to_instance := []
		to_instance.push_back({\"position\": 0.0, \"resource\": load(\"res://-Scenes/Application\"+str(_tabToLoad).pad_zeros(3)+\"/Main/1.tscn\")})
		return to_instance
	# runs on main thread but in tiny time slices
	func _instance(to_instance) -> void:
		var instance = to_instance.resource.instance()
		self.staging_node.add_child(instance)
		
var setI = -1
func addchild_to_scene(job:CreateDrunkenTerrainJob) -> void:
	appParent.get_node(str(setI)).add_child(job.staging_node)

