[sub_resource type="GDScript" id=1]
script/source = "extends Control


# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.
func _ready():
	if not App.singleWindow:
		# Transparency let this float over the desktop as its own window; here it
		# would punch a hole through the game behind it.
		get_tree().get_root().set_transparent_background(true)
		OS.window_per_pixel_transparency_enabled = true
												
	if not App.singleWindow:
		# Shared mixer now - muting this here also mutes it for the rest of the game.
		AudioServer.set_bus_mute( AudioServer.get_bus_index(\"ButtonSFX\") , true)
												
	#get_tree().root.get_node(\"/root/ButtonSfx\").call_deferred(\"free\")
	
	#AudioStream.
	
	
	
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	if not App.singleWindow:
		OS.window_borderless = true
	
	#var scalval = (OS.get_screen_size(App.monitor).x/1920)
	#self.rect_scale = Vector2(scalval* 1.5,scalval* 1.5) 
#	OS.window_size = (Vector2(280,104)*1.5)
	print(OS.get_screen_size())
	#print()
	if not App.singleWindow:
		OS.window_size = (Vector2(280,104)*1.5) * (OS.get_screen_size().x / 1920)
	#get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_VIEWPORT,  SceneTree.STRETCH_ASPECT_KEEP,(Vector2(280,104)*1.5),2)
	#self.rect_scale = Vector2((1.5) * (OS.get_screen_size().x/1920),(1.5) * (OS.get_screen_size().x/1920))
	print(self.rect_scale)
	#get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_DISABLED,  SceneTree.STRETCH_MODE_DISABLED,OS.window_size * (OS.get_screen_size().x / 1920))
	if App.singleWindow:
		# Same 420x156 base the branch below hands the engine, but applied to this
		# scene's own fake window. set_screen_stretch() is global - it was resizing
		# the entire game's render space, so the question stopped looking like a
		# window and became the whole canvas.
		App.setWorldWindowBase(Vector2(280,104)*1.5)
	else:
		OS.center_window()
		get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_VIEWPORT,  SceneTree.STRETCH_ASPECT_KEEP, (Vector2(280,104)*1.5))
	App.setWorldWindowTitle(\"???\")
	#OS.center_window()
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)



func _on_Y_button_up():
	$press.play()
	App._worldToKinito(\"QUESTION_yes\")
	$Active/Icon/AnimationPlayer.play(\"0\")
	after()



func _on_N_button_up():
	$break.play()
	$AudioStreamPlayer.playing = false
	$press.play()
	App._worldToKinito(\"QUESTION_no\")
	$Active/Icon/AnimationPlayer.play(\"0\")
	
	$Ambient.play(\"2\")
	yield(get_tree().create_timer(6.0), \"timeout\")
	if not App.singleWindow:
		get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_DISABLED,  SceneTree.STRETCH_ASPECT_KEEP_HEIGHT, OS.window_size  )
	App.worldChangeScene(self, \"res://-Scenes/NewInstance/1/4.tscn\")

func after():
	$Ambient.play(\"2\")
	yield(get_tree().create_timer(6.0), \"timeout\")
	#OS.window_minimized = true
	if not App.singleWindow:
		get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_DISABLED,  SceneTree.STRETCH_ASPECT_KEEP_HEIGHT, OS.window_size  )
	App.worldChangeScene(self, \"res://-Scenes/NewInstance/1/3.tscn\")
#res://-Scenes/NewInstance/1/3.tscn


