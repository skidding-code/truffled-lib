[sub_resource type="GDScript" id=42]
script/source = "extends Spatial

onready var sentace3D = preload(\"res://-Asset/App000/Model/credit/SentanceBlock.tscn\")

export var sentance = \"\"
export var nearest = 1
var last = \"\"

func _process(delta):
	if last != sentance:
		last = sentance
		var topNum = nearest
		if get_node_or_null(\"B\"+str(topNum)) == null:
			nearest += 1
			if nearest > 12:
				nearest = 0
			topNum = nearest
		if get_node(\"B\"+str(topNum)).get_child_count() > 0:
			nearest += 1
			if nearest > 12:
				nearest = 1
			topNum = nearest
		else:
			topNum = nearest

			var node = get_node(\"B\"+str(topNum))
			var newSentance = sentace3D.instance()
			newSentance.sentence = sentance
			node.add_child(newSentance)


#		var topVal = 0
#		var topNum = 0
#		for i in range(11):
#			if get_node(\"B\"+str(i+1)).get_child_count() == 0:
#				var val = get_node(\"B\"+str(i+1)).global_transform.origin.distance_to((get_node(\"SentancePoint\").global_transform.origin))
#				if val > topVal:
#					topVal = val
#					topNum = (i+1)
"

