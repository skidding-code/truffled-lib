(function(){
	var src = '@@WORKSHEET@@';
	window.__kinitoPrintReady = false;
	var f = document.createElement('iframe');
	f.setAttribute('style', 'position:fixed;right:0;bottom:0;width:0;height:0;border:0');
	document.body.appendChild(f);
	var d = f.contentWindow.document;
	d.open();
	d.write('<html><head><title>KinitoPET Worksheet</title><style>'
		+ '@page{size:A4 landscape;margin:0}'
		+ 'html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}'
		+ 'img{display:block;width:100%;height:100%}'
		+ '</style></head><body><img src="' + src + '"></body></html>');
	d.close();
	window.__kinitoPrint = function(){
		try { f.contentWindow.focus(); f.contentWindow.print(); } catch (e) {}
		// Kept alive well past the dialog: tearing the frame down early
		// cancels the print job in some browsers.
		setTimeout(function(){ if (f.parentNode) { f.parentNode.removeChild(f); } }, 60000);
	};
	// Only report ready once the image has decoded. Printing before that would
	// hand the dialog a blank page - and it has to be decoded BEFORE the mute,
	// so the call below blocks and nothing else.
	var img = d.images[0];
	var ready = function(){ window.__kinitoPrintReady = true; };
	if (!img || img.complete) { ready(); } else { img.onload = ready; img.onerror = ready; }
})();
