[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
export var close = false
func _ready():
	self.position = Vars.get(\"ScreenSize\")/Vars.get(\"nodeScale\")/2 
	if OS.get_screen_count() > 1:
		App._externalAction(3,8)# activate 3rd external scare after 5 seconds
		
		$FakeGame/Jade/Monitor.visible = true
func _process(delta):
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	if close:
		close = false
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		Tab.close(24)
		#Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
"

