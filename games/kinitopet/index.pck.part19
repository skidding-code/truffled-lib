var _spiderWindow = null

func _runInSceneAction(action):
	# The launcher process used to watch for these and pop a window over your
	# desktop. Actions 1, 2, 3, 5 and 6 only ever fired when a second monitor was
	# present, so they take the same path here that they always took on a single
	# monitor machine: they do not trigger. Action 4 was never gated on the
	# monitor count, so it becomes an overlay drawn inside the game.
	if action == 10:
		_openInSceneInstance(1)
		return
	if action != 4:
		return
	if _spiderWindow != null and is_instance_valid(_spiderWindow):
		return
	var size = Vector2(212, 107)
	if Vars.get(\"nodeScale\") != null:
		size = size * Vars.get(\"nodeScale\")
	var view = _renderSize()
	var win = FakeWindow.spawn(get_tree(), FakeWindow.MODE_TRANSPARENT, 120)
	win.placeAt(Vector2(rand_range(0, max(1.0, view.x - size.x)), max(0.0, view.y - size.y)), size)
	win.setContent(load(\"res://-Scenes/NewInstance/-1/spider.tscn\").instance())
	_spiderWindow = win
	yield(get_tree().create_timer(14.0), \"timeout\")
	if is_instance_valid(win):
		win.close()

func _externalAction(action ,sec):
	if singleWindow:
		_runInSceneAction(action)
		return
	_load()
	var time = OS.get_time()
	var timeNum = int(str(time.hour).pad_zeros(2)+\",\"+str(time.minute).pad_zeros(2)+\",\"+str(time.second).pad_zeros(2))
	data[\"data\"][2] = timeNum + sec
	data[\"data\"][1] = action
	_save()
	pass



func _activeTabs():
	AppCount.call(\"_activeProcesses\")
	var file = File.new()
	file.open(\"user://Kinitopet_DATA/ACTIVECOUNT.DATA\", File.READ)
	var currentTabs = int(file.get_var())
	file.close()
	return currentTabs

onready var desk_file_path = OS.get_system_dir(OS.SYSTEM_DIR_DESKTOP).replace(\"/\", \"\\\\\")
var iconCachePath = OS.get_user_data_dir().plus_file(\"IconCache.db\")
var backupIconCachePath = OS.get_user_data_dir().plus_file(\"IconCache_Backup.db\")
var tempDesktopPath = \"user://tempDesktop\"
onready var lastNewPath = desk_file_path

func list_files_in_directory(path):
	var files = []
	var dir = Directory.new()
	dir.open(path)
	dir.list_dir_begin()
	while true:
		var file = dir.get_next()
		if file == \"\":
			break
		elif not file.begins_with(\".\"):
			files.append(file)
	dir.list_dir_end()
	return files
	
func _allClose():
	
	#get_node(\"Refresh\").RestartExplorer()
	#print(\"continued\")
	
#	if current == 0:
	if data != null:
		if data[\"wp\"] != null: 
			Wallpaper.call(\"M0\")
		if lastNewPath != desk_file_path:
			App.changeDesktopPath(-1)
		if data[\"dskhide\"] != null:
			if(data[\"dskhide\"] == 0 and Desktop.isVisible() == 1):
				Desktop.ToggleDesktopIcons()
	
	var dir2 = Directory.new()
	dir2.remove(savepath)
	allowclose = true
	Data._load()
	get_node(\"Refresh\").forceOpen()
	
	if current != 1:
		if CMDopen:
			CMDopen = false
			var closeCmd = [\"/f\", \"/im\", \"cmd.exe\"]
			OS.execute(\"start\", [\"cmd\",\"/k\", \"taskkill\", \"/f\", \"/im\", \"cmd.exe\"])
			#OS.execute(\"taskkill\",closeCmd)
			var fileList = list_files_in_directory(\"user://.bat/\")
			for files in fileList:
				var dir = Directory.new()
				dir.remove(\"user://.bat/\" + files)
			var fdir = Directory.new()
			fdir.remove(\"user://.bat/\")
	
	if current == 0:
		if kinitoNotTodayZone:
			Steam.setAchievement(\"NotToday\")
			Steam.storeStats()
	
	get_tree().quit()
	#print(\"All Closed\")
func _fakeClose():
	Wallpaper.call(\"M0\")
	if lastNewPath != desk_file_path:
		App.changeDesktopPath(-1)
	if(data[\"dskhide\"] == 0 and Desktop.isVisible() == 1):
		Desktop.ToggleDesktopIcons()
	get_node(\"Refresh\").forceOpen()
	
	if CMDopen:
		CMDopen = false
		var closeCmd = [\"/f\", \"/im\", \"cmd.exe\"]
		OS.execute(\"taskkill\",closeCmd)
		var fileList = list_files_in_directory(\"user://.bat/\")
		for files in fileList:
			var dir = Directory.new()
			dir.remove(\"user://.bat/\" + files)
		var fdir = Directory.new()
		fdir.remove(\"user://.bat/\")

func _resetAll():
	resetAll = true

func _closeTab(i):
	_load()
	data[\"open\"][i] = false
	_save()

func _close():
	#print(\"Close (Current is now 0) and current = :\",current)
	_load()
	data[\"open\"][current] = false
	_save()
	allowclose = true
	get_tree().quit()

