[sub_resource type="GDScript" id=55]
script/source = "extends Sprite
func _ready():
	frame = 0

func _on_StartBUTTON_button_down():
	Vars.set(\"WebWRLD_Mouse_Press\",true)
	Vars.set(\"WebWRLD_Mouse_Mode\",1)


func _on_StartBUTTON_mouse_entered():
	frame = 1
	Vars.set(\"WebWRLD_Mouse_Select\",true)
	Vars.set(\"WebWRLD_Mouse_Mode\",0)
	
func _on_StartBUTTON_mouse_exited():
	frame = 0
	Vars.set(\"WebWRLD_Mouse_Mode\",1)
"

