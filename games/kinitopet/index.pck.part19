[sub_resource type="Shader" id=15]
code = "shader_type canvas_item;
uniform vec4 color : hint_color;
uniform sampler2D mask_texture;

void fragment() {
    vec4 colour = texture(TEXTURE, SCREEN_UV);
    colour.a *= texture(mask_texture, UV).a;
	colour *= color;
    COLOR = colour;
	
}
"

