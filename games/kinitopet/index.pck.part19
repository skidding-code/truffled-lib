[sub_resource type="GDScript" id=512]
script/source = "extends Node
export var opacity = 0.0
export var ambientPitch = 1.0
func _process(delta):
	Vars.set(\"PC_BG\", opacity)
	Vars.set(\"AmbientPitch\",ambientPitch)
"

