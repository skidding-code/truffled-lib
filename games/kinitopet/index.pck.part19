[sub_resource type="GDScript" id=4]
script/source = "extends Node2D
export var Robot = false
export var Car = false
export var Bike = false
export var Bear = false
export var Wrongtrigger = false
export var meat = true

onready var main = get_parent().get_parent().get_parent().get_parent().get_parent().get_node(\"Main\")
onready var displayHolder = get_parent().get_parent().get_parent().get_node(\"Holder\")

var bank = []
var rng = RandomNumberGenerator.new()
func _ready():
	print(\"RNG SEED:  \",rng.seed)
	pass # Replace with function body.




var rngBear = [0,1,2,3,4,5]
var rngBike = [6,7,8,9,10,11]
var rngCar = [12,13,14,15]
var rngRobot = [16,17,18,19,20,21]

var loopBear = 0
var loopBike = 0
var loopCar = 0
var loopRobot = 0

var flipflop = false
func _getValue():
	var rngRange = rng.randi_range(0,21)
	if flipflop:
		flipflop = false
	else:
		flipflop = true
		if Robot: 
			if loopRobot >= rngRobot.size():
				loopRobot = 0
			rngRange = rngRobot[loopRobot]
			loopRobot += 1
		if Bear: 
			if loopBear >= rngBear.size():
				loopBear = 0
			rngRange = rngBear[loopBear]
			loopBear += 1
		if Bike:
			if loopBike >= rngBike.size():
				loopBike = 0
			rngRange = rngBike[loopBike]
			loopBike +=1
		if Car:
			if loopCar >= rngCar.size():
				loopCar = 0
			rngRange = rngCar[loopCar]
			loopCar+=1
	return int(clamp(rngRange,0,21))

var rangeamt = 3 


#I am now realisising if I just set the names of the nodes to there returned names in newpick I wouldnt have had to do this manually. oh well its done now and I am too lazy to fix it

var carWheel = false
func newPick(name):
	var wrong = true
	if meat:
		if name == \"Meat\":
			wrong = false
			main.play(\"Meat\")
	elif Robot:
		rangeamt = 1
		if name == \"Robot_Body\":
			displayHolder.get_node(\"Robot\").get_node(\"Body\").visible = true
			wrong = false
		elif name == \"Robot_Head\": 
			displayHolder.get_node(\"Robot\").get_node(\"Head\").visible = true
			wrong = false
		elif name == \"Robot_LeftArm\": 
			displayHolder.get_node(\"Robot\").get_node(\"LA\").visible = true
			wrong = false
		elif name == \"Robot_RightArm\": 
			displayHolder.get_node(\"Robot\").get_node(\"RA\").visible = true
			wrong = false
		elif name == \"Robot_LeftLeg\": 
			displayHolder.get_node(\"Robot\").get_node(\"LL\").visible = true
			wrong = false
		elif name == \"Robot_RightLeg\": 
			displayHolder.get_node(\"Robot\").get_node(\"RF\").visible = true
			wrong = false
	elif Bear:
		rangeamt = 1
		if name == \"Bear_Body\": 
			displayHolder.get_node(\"Bear\").get_node(\"Body\").visible = true
			wrong = false
		elif name == \"Bear_Head\":
			displayHolder.get_node(\"Bear\").get_node(\"Head\").visible = true
			wrong = false
		elif name == \"Bear_LeftArm\": 
			displayHolder.get_node(\"Bear\").get_node(\"LA\").visible = true
			wrong = false
		elif name == \"Bear_LeftLeg\": 
			displayHolder.get_node(\"Bear\").get_node(\"LL\").visible = true
			wrong = false
		elif name == \"Bear_RightArm\": 
			displayHolder.get_node(\"Bear\").get_node(\"RA\").visible = true
			wrong = false
		elif name == \"Bear_RightLeg\": 
			displayHolder.get_node(\"Bear\").get_node(\"RF\").visible = true
			wrong = false
	elif Bike:
		rangeamt = 0
		print(\"set range amount: \",str(rangeamt) )
		if name == \"Bike_BackWheel\": 
			displayHolder.get_node(\"Bike\").get_node(\"BackWheel\").visible = true
			wrong = false
		elif name == \"Bike_FrontWheel\": 
			displayHolder.get_node(\"Bike\").get_node(\"FrontWheel\").visible = true
			wrong = false
		elif name == \"Bike_Body\": 
			displayHolder.get_node(\"Bike\").get_node(\"Body\").visible = true
			wrong = false
		elif name == \"Bike_Gear\": 
			displayHolder.get_node(\"Bike\").get_node(\"Gear\").visible = true
			wrong = false
		elif name == \"Bike_Seat\": 
			displayHolder.get_node(\"Bike\").get_node(\"Seat\").visible = true
			wrong = false
		elif name == \"Bike_Handle\": 
			displayHolder.get_node(\"Bike\").get_node(\"Handle\").visible = true
			wrong = false
	elif Car:
		rangeamt = 3
		if name == \"Car_Back\": 
			displayHolder.get_node(\"Car\").get_node(\"Back\").visible = true
			wrong = false
		elif name == \"Car_Front\": 
			displayHolder.get_node(\"Car\").get_node(\"Front\").visible = true
			wrong = false
		elif name == \"Car_Wheel\": 
			wrong = false
			if carWheel:
				carWheel=false
				displayHolder.get_node(\"Car\").get_node(\"FrontWheel\").visible = true
			else:displayHolder.get_node(\"Car\").get_node(\"BackWheel\").visible = true
			carWheel = true
	
	
	if name == \"Meat\":
		main.play(\"Meat\")
	else:
		if wrong:
			if Wrongtrigger:main.play(\"Wrong\")
		else:
			if bank.has(name) == false:
				bank.append(name)
				
				
				
	if Car:
		if displayHolder.get_node(\"Car\").get_node(\"BackWheel\").visible and displayHolder.get_node(\"Car\").get_node(\"FrontWheel\").visible:
			if bank.size() >= 3:
				main.play(\"bike\")
				bank = []
	elif Bike:
		if bank.size() == 1:
			get_node(\"0\").meat = true
			pass
		if bank.size() >= 6:
			main.play(\"bear\")
			bank = []
	elif Bear:
		if bank.size() >= 6:
			main.play(\"robot\")
			bank = []
	elif Robot:
		if bank.size() >= 1:
			emailSequence()
			pass
		if bank.size() >= 6:
			
			main.play(\"Pos\")
			bank = []
	
	

	
	
	
	pass

func emailSequence():
	Tab._sendMail(1)
	#$AnimationPlayer.play(\"activate\")
	Vars.set(\"KinitoWebWorld\",\"game2EMAIL\")
	
	pass 
onready var meatob = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Meat.tscn\")
onready var o00 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_Body.tscn\")
onready var o01 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_Head.tscn\")
onready var o02 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_LeftArm.tscn\")
onready var o03 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_LeftLeg.tscn\")
onready var o04 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_RightArm.tscn\")
onready var o05 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bear_RightLeg.tscn\")

onready var o06 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_BackWheel.tscn\")
onready var o07 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_Body.tscn\")
onready var o08 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_FrontWheel.tscn\")
onready var o09 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_Gear.tscn\")
onready var o10 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_Handle.tscn\")
onready var o11 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Bike_Seat.tscn\")

onready var o12 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Car_Back.tscn\")
onready var o13 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Car_Front.tscn\")
onready var o14 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Car_Wheel.tscn\")
onready var o15 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Car_Wheel.tscn\")

onready var o16 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Robot_Body.tscn\")
onready var o17 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Robot_Head.tscn\")
onready var o18 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Robot_LeftArm.tscn\")
onready var o19 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Robot_RightArm .tscn\")
onready var o20 = load(\"res://-Scenes/Application005/Main/Web/WebWorld/Scene/Game2_Objects/Robot_RightLeg.tscn\")
