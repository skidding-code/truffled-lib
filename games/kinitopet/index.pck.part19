func _generateSubFolders():
	var dir = Directory.new()
	dir.open(\"user://\")
#	if(dir.file_exists(\"Mods\") == false):
#		dir.make_dir(\"Mods\")
	if(dir.file_exists(\"Kinitopet_DATA\") == false):
		dir.make_dir(\"Kinitopet_DATA\")
	dir.open(\"user://Kinitopet_DATA/\")
	if(dir.file_exists(\"Wallpaper_DATA\") == false):
		dir.make_dir(\"Wallpaper_DATA\")
	if(dir.file_exists(\"Make_DATA\") == false):
		dir.make_dir(\"Make_DATA\")
		
var windowedReady = false

func _bootAsOnlyInstance():
	# Nothing else is running and nothing will be launched, so this process is the
	# game. Any ACTIVE.data lying around can only be from a previous session.
	var stale = Directory.new()
	stale.remove(savepath)
	_generateSubFolders()
	_pid = OS.get_process_id()
	data[\"PID\"] = _pid
	current = 0
	data[\"open\"][0] = true
	print(\"\\n\\n============\\nSINGLE WINDOW - instance 0\\n============\")
	_save()

# \"Your world\" ran as its own process at 30fps. Engine.target_fps is global, so
# capping it here would slow Kinito and the desktop too. Instead the world's
# viewport is only asked to redraw at this rate; everything outside it keeps
# running at full speed.
const WORLD_FPS = 30.0
# set_screen_stretch(VIEWPORT, KEEP, Vector2(600,450), 2) - that trailing 2 is a
# shrink factor and it divides the base, so the world actually laid itself out at
# 300x225 and was scaled up from there. Measured, not assumed: minsize (600,450)
# with shrink 2 gives root.size (300,225).
const WORLD_BASE = Vector2(300, 225)

var _worldViewport = null
var _worldFpsAccum = 0.0
var _worldBackdrop = null


func _process(delta):
	_syncMouseToBrowser()
	if _worldViewport == null or not is_instance_valid(_worldViewport):
		return
	_worldFpsAccum += delta
	if _worldFpsAccum >= 1.0 / WORLD_FPS:
		_worldFpsAccum = 0.0
		_worldViewport.render_target_update_mode = Viewport.UPDATE_ONCE


func setWorldWindowBase(base, scale = 1.0):
	# Every scene in the world chain sized its own OS window and gave the engine a
	# matching stretch base. Applied to the fake window and its viewport instead -
	# calling set_screen_stretch() here would rescale the whole game, which is
	# exactly what made the \"will you stay with me\" question take over the canvas.
	if not singleWindow:
		return
	if _worldViewport == null or not is_instance_valid(_worldViewport):
		return
	var win = _inSceneInstances.get(1)
	if win == null or not is_instance_valid(win):
		return
	_worldViewport.size = base
	var frame = win.content
	if frame != null and is_instance_valid(frame):
		frame.rect_size = base
		frame.rect_scale = Vector2(scale, scale)
	win.placeContent(base * scale)


func showVirtualDesktop(shown = true):
	# The desktop these windows sit on. It used to be the player's real one, so
	# the game never drew it; now it has to. Raised as soon as the compile console
	# appears - the wallpaper is already there at that point in the original - and
	# taken down when the world closes.
	if not singleWindow:
		return
	if not shown:
		if _worldBackdrop != null and is_instance_valid(_worldBackdrop):
			_worldBackdrop.queue_free()
		_worldBackdrop = null
		return
	if _worldBackdrop != null and is_instance_valid(_worldBackdrop):
		return
	_worldBackdrop = CanvasLayer.new()
	# Behind everything. At layer 89 it sat on top of the layer Kinito draws on and
	# hid him completely.
	_worldBackdrop.layer = -1
	var wall = TextureRect.new()
	wall.texture = wallpaperTexture()
	wall.add_to_group(WALLPAPER_GROUP)
	wall.expand = true
	wall.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	wall.anchor_right = 1.0
	wall.anchor_bottom = 1.0
	wall.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_worldBackdrop.add_child(wall)
	get_tree().get_root().add_child(_worldBackdrop)


# --- the main game window's own chrome ----------------------------------------
#
# Some scenes shrink the real game window down to just their content and let the
# player see the desktop around it - the hide-and-seek minigame does, and it
# rewrites the window title while it runs (\"he is seeking you\", one word at a
# time). None of that survives a single fixed canvas, so the chrome is drawn.
#
# Laid OVER the game rather than behind it. That scene finishes itself with
# full-screen NTSC, bloom and blur passes that copy the back buffer, so anything
# underneath would simply be painted over. Hence a chrome-only window - title bar
# and outline, nothing filling the middle.
var _mainFrame = null

func showMainWindowFrame(contentSize, title = \"\"):
	if not singleWindow:
		return Vector2.ZERO
	if _mainFrame == null or not is_instance_valid(_mainFrame):
		_mainFrame = FakeWindow.spawn(get_tree(), FakeWindow.MODE_TITLED, 120)
		_mainFrame.opaque = false
		_mainFrame.closable = false
		_mainFrame.draggable = false
		# opaque/closable are read while building, and spawn() has already built.
		_mainFrame.rebuild()
	_mainFrame.title = title
	_mainFrame.placeContent(contentSize)
	return _mainFrame.contentOrigin()


func mainWindowFrameOrigin(contentSize):
	# Where the framed content sits. Same answer as showMainWindowFrame(), for
	# callers that only want to know and not to (re)create it.
	if _mainFrame == null or not is_instance_valid(_mainFrame):
		return ((_renderSize() - contentSize) / 2.0).floor()
	return _mainFrame.contentOrigin()


func offsetMainWindowFrame(offset):
	# The original shook the whole window: OS.center_window() every frame, then
	# window_position += offset. Border and all moved together. Same two steps on
	# the drawn chrome - recentre, then shift - so the frame travels with its
	# contents instead of the contents sliding around inside a frame nailed to
	# the middle of the screen.
	if _mainFrame == null or not is_instance_valid(_mainFrame):
		return
	_mainFrame.place(_mainFrame.rect_size)
	_mainFrame.rect_position += offset


func hideMainWindowFrame():
	if _mainFrame != null and is_instance_valid(_mainFrame):
		_mainFrame.close()
	_mainFrame = null


func setMainWindowTitle(text):
	# Always retitle the real window too: harmless in a browser tab, and correct
	# if this ever runs on desktop.
	OS.set_window_title(text)
	if _mainFrame != null and is_instance_valid(_mainFrame):
		_mainFrame.title = text


func setWorldWindowTitle(text):
	# The world process renamed its own window. There is no separate process and
	# no separate OS window now, so the name goes on the fake window's title bar -
	# retitling the real one would rename the whole game.
	if not singleWindow:
		return OS.set_window_title(text)
	var win = _inSceneInstances.get(1)
	if win != null and is_instance_valid(win):
		win.title = text


func setWorldWindowVisible(shown):
	# The world \"crashes\" by minimising its own window. Minimising the real one
	# would take the whole game with it, so the fake window is hidden instead -
	# the desktop behind it stays exactly where it was.
	if not singleWindow:
		return
	var win = _inSceneInstances.get(1)
	if win != null and is_instance_valid(win):
		win.visible = shown


func worldChangeScene(node, path):
	# Each of these scenes was its own process, so change_scene() only replaced
	# that process's scene. Hosted inside the game it would replace the WHOLE
	# game - taking the desktop and Kinito with it, which is exactly what happened
	# when the world moved on to the house. Swap the hosting viewport's contents
	# instead. Deferred, because the node calling this is about to be freed.
	if not singleWindow:
		return get_tree().change_scene(path)
	var vp = node.get_viewport()
	if vp == null or vp == get_tree().get_root():
		return get_tree().change_scene(path)
	call_deferred(\"_swapViewportScene\", vp, path)
	return OK


func _swapViewportScene(vp, path):
	if not is_instance_valid(vp):
		return
	var packed = load(path)
	if packed == null:
		printerr(\"world scene missing: \", path)
		return
	for child in vp.get_children():
		vp.remove_child(child)
		child.queue_free()
	var fresh = packed.instance()
	# Before adding it: the scene sizes the window from its own _ready(), and that
	# has to see the chrome it is actually going to get.
	if vp == _worldViewport:
		_setWorldOverlayMode(not _containsSpatial(fresh))
	vp.add_child(fresh)
	_rebindViewportTextures(fresh)


func _setWorldOverlayMode(isOverlay):
	# The last three scenes of the world chain are not the world - they are
	# overlays. 1/2 is the \"will you stay with me\" panel that fades away, 1/3 and
	# 1/4 are the screen-glitch passes that belong over the whole monitor. Each ran
	# in a per-pixel-transparent window over the real desktop.
	#
	# Hosted in a viewport, two opaque things sit behind them instead: the
	# viewport clears to the project clear colour (the teal that was showing
	# through), and the fake window draws its own body and title bar. Both have to
	# go while an overlay is up, and both have to come back for the 3D world -
	# which needs its own background, since its sky is what fills it.
	if _worldViewport != null and is_instance_valid(_worldViewport):
		_worldViewport.transparent_bg = isOverlay
	var win = _inSceneInstances.get(1)
	if win == null or not is_instance_valid(win):
		return
	var want = FakeWindow.MODE_TRANSPARENT if isOverlay else FakeWindow.MODE_TITLED
	if win.mode == want:
		return
	win.mode = want
	win.rebuild()


func _rebindViewportTextures(root):
	# ViewportTextures saved in a scene resolve while it is being instanced, before
	# the Viewport nodes exist, so they come back unbound and whatever displays
	# them draws nothing. Re-resolve them now the tree is built.
	_rebindWalk(root, root)


func _rebindWalk(node, root):
	var tex = node.get(\"texture\")
	if tex != null and tex is ViewportTexture:
		var target = root.get_node_or_null(tex.viewport_path)
		if target != null and target is Viewport:
			node.texture = target.get_texture()
	for child in node.get_children():
		_rebindWalk(child, root)


# The state the game thinks the desktop wallpaper is in. M0 is the player's own,
# M1..M5 the corrupted copies (M2 is solid black, M5 near-white).
const WALLPAPER_GROUP = \"virtual_wallpaper\"
var wallpaperState = 1


func setWallpaperState(state):
	# SystemParametersInfo() used to swap the player's real desktop background.
	# Nothing here can touch that, but the game draws its own desktop in several
	# places now - the power button screen, the computer cutscene, behind the
	# world window - so the swap happens on those instead. Anything that wants to
	# follow along just joins the WALLPAPER_GROUP group.
	wallpaperState = int(state)
	var tex = wallpaperTexture()
	if tex == null:
		return
	for node in get_tree().get_nodes_in_group(WALLPAPER_GROUP):
		if is_instance_valid(node):
			node.texture = tex


func wallpaperTexture():
	return load(\"res://-Asset/Theme/Wallpapers/0/M\" + str(wallpaperState) + \".png\")


# --- the two windows the Bliss ending needs ------------------------------------
#
# Both were separate things on Windows: lense.exe was its own executable in
# extra/lense/, and the Files folder was opened in the real File Explorer from a
# link in one of the emails. Drawn inside the game instead, on a layer above
# everything and parented to the root rather than the running scene, so they
# survive change_scene() the way separate processes survived it.
const LENSE_SCENE = \"res://Lense/Lense.tscn\"
const LENSE_SIZE = Vector2(600, 400)
const EXPLORER_SIZE = Vector2(520, 360)
const DESKTOP_APP_LAYER = 200

var _lenseWindow = null
var _explorerWindow = null


func openLense():
	if not singleWindow:
		return _openExternal(OS.get_executable_path().get_base_dir() + \"/extra/lense/lense.exe\")
	if _lenseWindow != null and is_instance_valid(_lenseWindow):
		return OK
	# Chrome only, no body. The whole point of the thing is that it is a lens: the
	# real one ran per-pixel transparent over the desktop, and all it draws of its
	# own is a barely-there white tint. An opaque body turns it into a dark
	# rectangle you cannot see anything through.
	var win = _spawnDesktopApp(\"Lense.exe\", LENSE_SIZE, false)
	# Clipped, because the lens only reveals what is under the glass: the scene
	# inside parks its entry at a fixed screen position and relies on the window
	# edge to hide it the rest of the time.
	var clip = Control.new()
	clip.anchor_right = 1.0
	clip.anchor_bottom = 1.0
	clip.rect_clip_content = true
	clip.mouse_filter = Control.MOUSE_FILTER_PASS
	clip.add_child(load(LENSE_SCENE).instance())
	win.setContent(clip)
	win.placeContent(LENSE_SIZE)
	win.connect(\"closed\", self, \"_onDesktopAppClosed\", [\"lense\"])
	_lenseWindow = win
	return OK


func openFileExplorer():
	if not singleWindow:
		return _openExternal(OS.get_user_data_dir() + \"/Files\")
	if _explorerWindow != null and is_instance_valid(_explorerWindow):
		return OK
	var win = _spawnDesktopApp(\"Files\", EXPLORER_SIZE)
	win.setContent(load(\"res://Script/FakeExplorer.gd\").new())
	win.placeContent(EXPLORER_SIZE)
	win.connect(\"closed\", self, \"_onDesktopAppClosed\", [\"explorer\"])
	_explorerWindow = win
	return OK


const TEXT_VIEWER_SIZE = Vector2(460, 300)
var _openFiles = {}


func openFile(name):
	# Double-clicking a row in the Files window. Only .txt means anything: those
	# are what Application014 writes once an encrypted entry has been decoded, and
	# reading them is the whole point of the ending. The .encrypted files are not
	# meant to be readable - that is what the decoder is for.
	if not singleWindow:
		return _openExternal(OS.get_user_data_dir() + \"/Files/\" + str(name))
	if not str(name).to_lower().ends_with(\".txt\"):
		return OK
	if _openFiles.has(name) and is_instance_valid(_openFiles[name]):
		return OK
	var file = File.new()
	if file.open(\"user://Files/\" + str(name), File.READ) != OK:
		printerr(\"Files: cannot open \", name)
		return ERR_FILE_CANT_OPEN
	var text = file.get_as_text()
	file.close()

	var win = _spawnDesktopApp(str(name), TEXT_VIEWER_SIZE)
	var viewer = load(\"res://Script/FakeTextViewer.gd\").new()
	viewer.setup(text)
	win.setContent(viewer)
	win.placeContent(TEXT_VIEWER_SIZE)
	win.connect(\"closed\", self, \"_onTextFileClosed\", [name])
	_openFiles[name] = win
	return OK


func _onTextFileClosed(name):
	_openFiles.erase(name)


# Bottom of the stack first, most recently focused last - the order they are
# drawn in, and the order _restackDesktopApps() writes back as layer numbers.
var _desktopApps = []


func _spawnDesktopApp(title, size, opaque = true):
	var win = FakeWindow.spawn(get_tree(), FakeWindow.MODE_TITLED, DESKTOP_APP_LAYER)
	win.title = title
	_desktopApps.append(win)
	_restackDesktopApps()
	if not opaque:
		# opaque is read while building and spawn() has already built.
		win.opaque = false
		win.rebuild()
	# These stood outside the game as their own processes, so they kept running
	# while it paused - and the game pauses for whole sequences at a time.
	win.pause_mode = Node.PAUSE_MODE_PROCESS
	win.get_parent().pause_mode = Node.PAUSE_MODE_PROCESS
	win.placeContent(size)
	return win


func _dropBrokenPostProcess(node):
	var env = null
	if node is WorldEnvironment:
		env = node.environment
	elif node is Camera:
		env = node.environment
	if env == null:
		return
	if env.dof_blur_far_enabled or env.dof_blur_near_enabled:
		env.dof_blur_far_enabled = false
		env.dof_blur_near_enabled = false
		print(\"App: disabled depth-of-field blur on \", node.name, \" (broken through ANGLE)\")
	if env.ss_reflections_enabled:
		env.ss_reflections_enabled = false
		print(\"App: disabled screen-space reflections on \", node.name, \" (broken through ANGLE)\")


func _restackDesktopApps():
	# Each window sits on a CanvasLayer of its own, and a CanvasLayer's order is
	# its layer number - so giving them consecutive numbers from the bottom of the
	# list up puts the most recently focused one on top. Closed windows drop out on
	# the way through.
	var live = []
	for win in _desktopApps:
		if win != null and is_instance_valid(win):
			live.append(win)
	_desktopApps = live
	for i in range(_desktopApps.size()):
		var layer = _desktopApps[i].get_parent()
		if layer is CanvasLayer:
			layer.layer = DESKTOP_APP_LAYER + i


func focusDesktopApp(win):
	if win == null or not is_instance_valid(win):
		return
	if _desktopApps.size() > 0 and _desktopApps[_desktopApps.size() - 1] == win:
		return
	_desktopApps.erase(win)
	_desktopApps.append(win)
	_restackDesktopApps()


func _input(event):
	# Click a window, it comes to the front - the one thing every real window
	# manager does. Handled here rather than inside the windows because their own
	# contents (title bar, file rows, the text view) eat the click before the
	# window itself would ever see it.
	#
	# _input runs before the GUI picks a target, so by the time the click is
	# routed the raised window is already on top and gets it.
	if not (event is InputEventMouseButton and event.pressed):
		return
	if _desktopApps.empty():
		return
	for i in range(_desktopApps.size() - 1, -1, -1):
		var win = _desktopApps[i]
		if win == null or not is_instance_valid(win) or not win.visible:
			continue
		if win.get_global_rect().has_point(event.position):
			focusDesktopApp(win)
			return


func _onDesktopAppClosed(which):
	if which == \"lense\":
		_lenseWindow = null
	elif which == \"explorer\":
		_explorerWindow = null


func _openInSceneInstance(i):
	# What used to be launched as its own process is drawn inside the game now.
	# Same scene, same script - it just lives in a fake window.
	if i == 0:
		return
	if _inSceneInstances.has(i) and is_instance_valid(_inSceneInstances[i]):
		return
	var path = \"res://-Scenes/NewInstance/\" + str(i) + \"/1.tscn\"
	var probe = File.new()
	if not probe.file_exists(path):
		printerr(\"No scene for instance \", i, \" at \", path)
		return
	# Titled, not borderless: \"your world\" ran as its own process in an ordinary
	# window, and it renames that window as the game goes on - to
	# \"<yourname>_world.exe\" and later to \"???\" - so the title bar has to be there
	# for those to be seen at all.
	var win = FakeWindow.spawn(get_tree(), FakeWindow.MODE_TITLED, 90)
	# No close button. The game never closes this window itself - it ends the
	# world by hiding it (setWorldWindowVisible) - so the X was a way to lose the
	# world mid-game with nothing to bring it back. closable is read while
	# building and spawn() has already built, hence the rebuild; it survives the
	# later rebuilds in _setWorldOverlayMode, being a plain property.
	win.closable = false
	win.rebuild()
	var size = Vector2(800, 600)
	if Vars.get(\"nodeScale\") != null:
		size = size * Vars.get(\"nodeScale\")
	# By content size, so the chrome is added around the world rather than taken
	# out of it.
	win.placeContent(size)

	# Registered BEFORE the scene is built. Adding the scene runs its _ready()
	# chain, and the world names its own window from in there (the 3D title screen
	# sets it to \"<name>s_world.exe\"). Registering afterwards meant that lookup
	# found nothing and the title was dropped on the floor, so the bar came up
	# blank and stayed blank.
	win.connect(\"closed\", self, \"_onInSceneInstanceClosed\", [i])
	_inSceneInstances[i] = win

	var scene = load(path).instance()
	if _containsSpatial(scene):
		# \"Your world\" is a 3D scene. 3D cannot be drawn inside a Control: a Camera
		# renders to its whole viewport, not into some rect, so parenting it to the
		# fake window's holder left the window showing nothing but its own body -
		# a flat grey square. It needs a Viewport of its own, with own_world so its
		# camera and lighting do not fight the game's.
		var viewport = Viewport.new()
		viewport.own_world = true
		# A sub-Viewport has no audio listener unless it is told to be one, so every
		# AudioStreamPlayer3D inside it stays silent - the house has seven of them,
		# which is why the bike, the robot, the door and the key made no sound. The
		# hide-and-seek scene sets exactly these two flags on its own viewport.
		viewport.audio_listener_enable_2d = true
		viewport.audio_listener_enable_3d = true
		# The world ran with STRETCH_MODE_VIEWPORT on a 600x450 base: render at that
		# resolution, then scale the result up to the window. Reproduced by giving
		# the viewport the base as its real size and scaling the container.
		#
		# NOT size_override: ViewportContainer.stretch re-applies its own override
		# from the container size on every resize, so it silently overwrote a 600x450
		# override with 800x600 - which is why the UI stayed laid out at 600x450
		# inside an 800x600 viewport, small and pinned to the top-left.
		viewport.size = WORLD_BASE
		# Driven at WORLD_FPS from _process instead of every frame.
		viewport.render_target_update_mode = Viewport.UPDATE_DISABLED
		_worldViewport = viewport
		_worldFpsAccum = 0.0
		var frame = ViewportContainer.new()
		frame.stretch = false
		frame.rect_size = WORLD_BASE
		frame.rect_scale = size / WORLD_BASE
		frame.mouse_filter = Control.MOUSE_FILTER_PASS
		frame.add_child(viewport)
		viewport.add_child(scene)
		win.setContent(frame)
		_rebindViewportTextures(scene)

		showVirtualDesktop(true)
	else:
		win.setContent(scene)


func _containsSpatial(node):
	if node is Spatial:
		return true
	for child in node.get_children():
		if _containsSpatial(child):
			return true
	return false

func _onInSceneInstanceClosed(i):
	if i == 1:
		_worldViewport = null
		showVirtualDesktop(false)
	_inSceneInstances.erase(i)
	_load()
	if data != null and i < data[\"open\"].size():
		data[\"open\"][i] = false
	_save()

func _initalise():
	var file = File.new()
	if singleWindow:
		_bootAsOnlyInstance()
	else:
		# A session's first process is never launched with the instance marker, so any
		# ACTIVE.data it finds was left behind by a session that was killed rather than
		# closed - stopped from the editor, or crashed. Trusting it makes this process
		# come up as a background scare instance and idle forever with no main window.
		if file.file_exists(savepath) and not _isSpawnedInstance():
			print(\"Clearing stale ACTIVE.data left over by a previous session\")
			var stale = Directory.new()
			stale.remove(savepath)
		if file.file_exists(savepath):
		
			#_initiMods()
			#_detectRecord()
			#print(\"File Exsists\")
			_load()
			

		
		
			_pid = data[\"PID\"]
			current = data[\"next\"]
			print(\"\\n\\n============\\nNEW INSTANCE [\"+str(current)+\"]\\n============\")
			data[\"next\"] = -1
			#print(\"\\nCURRENT: \",current,\"\\n\")
			data[\"open\"][current] = true
			_save()
		else:
			_generateSubFolders()
			_pid = 0
			data[\"PID\"] = 0
			current = -1
			print(\"\\nCURRENT: \",current,\"\\n\")
			_save()
			open(0) # comeback
	
	crashHandler()
	_update()
	if(current == 0):
		#print(\"Loading the instance\")
		#get_tree().change_scene(\"res://-Scenes/NewInstance/\"+str(current)+\"/1.tscn\")
			
		if windowedMode:
			_windowMode()
		yield(get_tree(),\"idle_frame\")
		#print(\"Loaded the instance\")
		
		storeOriginalIconLayouts()
		data[\"PID\"] = (OS.get_process_id())
		_pid = data[\"PID\"]
		if(Desktop.isVisible() == 0):
			data[\"dskhide\"] = 0
		else:
			data[\"dskhide\"] = 1
		_save()
		while Vars.get(\"WallpaperFinnished\") == false or Vars.get(\"WallpaperFinnished\") == null:
			yield(get_tree(),\"idle_frame\")
			print(\"Wallpaper processesing\")
		_initialize_Steam()
		
		
		Tab.queuescene(\"res://-Scenes/Application000/Main/-1.tscn\",false)
		Tab.queuescene(\"res://-Scenes/Application000/Main/2.tscn\",false)
#		Tab.queuescene(\"res://-Scenes/Application000/Main/PC.tscn\",false)
#	if current == 1:
#		App._initialize_Steam()
		#if(recording):
		#	OS.alert(\"Please note for when recording KinitoPET.exe its best to use display capture instead of game capture as some elements of the game will not be captured correctly.\")
		
	get_tree().root.connect(\"size_changed\", self, \"_on_viewport_size_changed\")
		
	#print(\"res://-Scenes/NewInstance/\"+str(current)+\"/1.tscn\")
	
	get_tree().change_scene(\"res://-Scenes/NewInstance/\"+str(current)+\"/1.tscn\")
var oldpos = Vector2.ZERO

func desktopVisisisisi():
	if(Desktop.isVisible() == 1):
		Desktop.ToggleDesktopIcons()

func _update():
	while resetAll == false:
		if current == 1:
			pass
			#_save()
		elif App.data != null:
			if str(App.data[\"data\"][3]) == \"QUESTION_goto\": 
				#bango
				if oldpos != OS.window_position:
					oldpos = OS.window_position
					#print(\"SaveFromPosition\")
					_save()
			
		
		
		yield(get_tree().create_timer(1.0), \"timeout\")
		yield(get_tree(),\"idle_frame\")
		if windowedMode == false:
			if originialScreenSize != OS.get_screen_size(monitor):
				_allClose()
				return
		

		
		var file = File.new()
		if file.file_exists(savepath):
			_load()
			if data != null:
				if(data[\"PID\"] != _pid):
					_pid = data[\"PID\"]
			if(current != -1):
				if(data[\"open\"][current] == false):
					_allClose()
		else:
			_allClose()

func _load():
	if(closing == false):
		# Every instance shares this file, so a read can land mid-write in another
		# process. Keep the data we already have rather than taking a null.
		data = SafeSave.read_var(savepath, data)
		yield(get_tree(),\"idle_frame\")

func _save():
	if(closing == false):
		if data == null:
			return
		print(\"save_\",str(current))
		if current != 0:
			data[\"pos\"][1] = _kinitoSavedPosition()
			#print(\"save posisiotn 1: , \",str(OS.window_position))
		#data[\"pos\"][current] = OS.window_position
		SafeSave.write_var(savepath, data)
		print(\"SAVED(c=\"+str(current)+\")  \",str(data),\"   position real = \",str(OS.window_position),\"  position value = \",str(data[\"pos\"][1]))
		yield(get_tree(),\"idle_frame\")

