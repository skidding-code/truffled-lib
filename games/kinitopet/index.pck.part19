[sub_resource type="GDScript" id=32]
script/source = "extends Control
export var num = 0
func _ready():
	var url =  (OS.get_user_data_dir()+\"/Kinitopet_DATA/Make_DATA/s\"+str(num)+\".data\")
	var file = File.new()
	if file.open(url, File.READ) == OK:
		var file_data = file.get_buffer(file.get_len())
		file.close()
		
		var image = Image.new()
		
		# Load the PNG data from the buffer
		if image.load_png_from_buffer(file_data) == OK:
			var texture = ImageTexture.new()
			texture.create_from_image(image)
			self.texture = texture
			
			#var sc = 250/self.rect_size.y
			self.rect_scale.y = 250/texture.get_size().y
			self.rect_scale.x = 200/texture.get_size().x
			#self.rect_scale = Vector2(sc,sc)
			#self.rect_position.x = -((self.rect_scale.x * self.rect_size.x) /2)
		else:
			print(\"Failed to load image from file.\")
	else:
		print(\"Failed to open file:\", url)
	
	
	
	


func load_external_tex(path):
	var tex_file = File.new()
	tex_file.open(path, File.READ)
	var bytes = tex_file.get_buffer(tex_file.get_len())
	var img = Image.new()
	var data = img.load_png_from_buffer(bytes)
	var imgtex = ImageTexture.new()
	imgtex.create_from_image(img)
	tex_file.close()
	return imgtex
"

