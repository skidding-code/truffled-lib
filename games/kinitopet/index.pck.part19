script/source = "extends Control

func _ready():
	pass # Replace with function body.

func _process(delta):
	if Vars.get(\"Survey_Button\") == true:$Hub/BTN.visible = true
	
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

var ot = true
func _on_Button_button_down():
	if ot:
		ot = false
		get_parent().get_node(\"Main\").play(\"LoadQuestions\")
		yield(get_tree().create_timer(6.0), \"timeout\")
		Vars.set(\"Survey_Start\",true)
	#start game
	pass


func _on_Button_mouse_entered():
	$BTN/Sprite.frame = 1
	$BTN/Sprite/A.play()

func _on_Button_mouse_exited():
	$BTN/Sprite.frame = 0
"

