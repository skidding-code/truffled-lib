[sub_resource type="GDScript" id=5]
script/source = "extends KinematicBody2D
export var on = false
export var speed = 100
onready var anim = get_node(\"Pos/Test\")
var dir = \"SW\"
var moving = false
var velocity = Vector2.ZERO
var path = []
export var threshold = 16
var cursousrPos = Vector2.ZERO
var destination = Vector2.ZERO
var modeGoTo = 0
var lock = false

onready var nav = get_parent().get_node(\"Navigation2D\")

func _physics_process(delta):
	if(on):
		# get_target_path() wants a point in the same space as position - local to
		# this node's parent - so ask the parent to convert, rather than assuming.
		#
		# Dividing the global mouse by nodeScale only undoes the scale, and only
		# lands in the right place if the scene sits at the origin. Mid is scaled by
		# nodeScale AND parked at the centre of the screen, and Nav is offset
		# another (-930, -546) inside it, so every click resolved to a point far off
		# the navmesh and the path came back empty. Same fault as the world map.
		cursousrPos = get_parent().get_global_transform().affine_inverse().xform(get_global_mouse_position())
		if path.size() > 0:
			move_to_target()
		if(moving):
			anim.play(str(dir)+\"_RUN\")
		else:
			anim.play(str(dir)+\"_IDLE\")
			

func move_to_target():
	if(on):
		if position.distance_to(path[0]) < threshold:
			path.remove(0)
			yield(get_tree().create_timer(0.1), \"timeout\")
			moving = false
			
		else:
			moving = true
			var direction = position.direction_to(path[0])
			velocity = direction * speed
			if(direction.x > -1 and direction.y > 0   and   direction.x < 0 and direction.y < 1 ):
				dir = \"SW\"
			elif(direction.x > 0 and direction.y < 1   and   direction.x < 1 and direction.y > 0 ):
				dir = \"SE\"
			elif(direction.x > 0 and direction.y > -1   and   direction.x < 1 and direction.y < 0 ):
				dir = \"NE\"
			elif(direction.x < 1 and direction.y < 0   and   direction.x < 0 and direction.y > -1 ):
				dir = \"NW\"
			#anim.play(\"SW_IDLE\")
			
			velocity = move_and_slide(velocity)
			
func get_target_path(target_pos):
	if(on):
		destination = target_pos
		# Same global-vs-local navmesh problem as the world map: Navigation2D
		# resolves paths in global space, but position and target_pos are local to
		# this node's parent, so once the app window is anywhere but the origin
		# both endpoints fall off the navmesh and clamp to a single point.
		var xf = get_parent().get_global_transform()
		var inv = xf.affine_inverse()
		var gpath = nav.get_simple_path(xf.xform(position), xf.xform(target_pos), false)
		path = []
		for gp in gpath:
			path.append(inv.xform(gp))
	
func _on_Board_button_down():
	if(on):
		get_target_path(  cursousrPos  )
"

