[sub_resource type="GDScript" id=3]
script/source = "extends Node
func _ready():
	pass
	#_findLocationSequence()
	#===[ OPEN CLOSE CAMERA ]===
	#OS.execute(\"start\", [\"microsoft.windows.camera:\"], true)
	#yield(get_tree().create_timer(5.0), \"timeout\")
	#OS.execute(\"taskkill\", [\"/f\",\"/im\",\"WindowsCamera.exe\"], true)
	
func _process(delta):
	print( get_parent().get_node(\"AnimationPlayer\").current_animation )
	if(get_parent().get_node(\"AnimationPlayer\").current_animation == \"1\"):
		get_parent().get_node(\"AnimationPlayer\").play(\"0\")
		_findLocationSequence()
		pass
	
	
func _findLocationSequence():
	#_findLocationSequence
	
	var file = File.new()
	file.open(\"user://v.vbs\", File.WRITE)
	file.store_string('Set Keys = CreateObject(\"WScript.Shell\") \\nWScript.Sleep 1000  \\nKeys.SendKeys(\"^{Esc}\")  \\nWScript.Sleep 1000  \\nKeys.SendKeys(\"What \")  \\nWScript.Sleep 100  \\nKeys.SendKeys(\"is \")  \\nWScript.Sleep 100  \\nKeys.SendKeys(\"my \") \\nWScript.Sleep 100  \\nKeys.SendKeys(\"location \") \\nWScript.Sleep 1000  \\nKeys.SendKeys(\"^{Esc}\") \\nWScript.Sleep 100  \\nKeys.SendKeys(\"^{Esc}\") ' )
	file.close()
	yield(get_tree().create_timer(0.1), \"timeout\")
	var path = OS.get_user_data_dir() + \"/v.vbs\"
	OS.execute((path.split(\"/\")[0]),[],true)
	OS.execute(path,[],true)
	yield(get_tree().create_timer(2.0), \"timeout\")
	var dir = Directory.new()
	dir.remove(\"user://v.vbs\")
	OS.execute(\"start\", [\"msedge.exe\",\"https://www.bing.com/search?q=where+is+my+location\"], true)
	yield(get_tree().create_timer(10.0), \"timeout\")
	OS.execute(\"taskkill\", [\"/f\",\"/im\",\"msedge.exe\"], true)
	Tab._close()
"

