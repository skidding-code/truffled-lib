#emailBox


func _readMail(mailNum):
	for i in range(Data.data[\"emailBox\"].size()):
		if(Data.data[\"emailBox\"][i][0] == mailNum ):
			Data.data[\"emailBox\"][i][1] = 1
	Data._save(\"_ALL\",0)

func _deleteMail(mailNum):
	var _i=0
	while _i < (Data.data[\"emailBox\"].size()):
		if(Data.data[\"emailBox\"][_i][0] >= mailNum ):
			Data.data[\"emailBox\"].remove(_i)
			_i-=1
		_i+=1
	Data._save(\"_ALL\",0)

func _checkMail():
	var i = 0
	while i < (Data.data[\"emailBox\"].size()):
		if(Data.data[\"emailBox\"][i][2] >= sp ):
			Data.data[\"emailBox\"].remove(i)
			i-=1
		i+=1
	Data._save(\"_ALL\",0)


func _sendMail(mailNum):
	var check = true
	for i in range(Data.data[\"emailBox\"].size()):
		if(Data.data[\"emailBox\"][i][0] == mailNum ):
			check = false
	if(check):
		Data.data[\"emailBox\"].append( [mailNum,0,sp] )
		Data._save(\"_ALL\",0)
		mailNumber = mailNum
		mailSent = true
		resetMail = true
		
	#0 unread
	#1 read
	pass

