[sub_resource type="GDScript" id=38]
script/source = "extends Node2D
var PickedUp = false

func _ready():
	
	pass # Replace with function body.

func _deselectAll():
	PickedUp = false
	for N in get_children():
		N._deselect()
	pass


var act3_data = {}
func _ConvertToImage():
	for N in get_children():
		act3_data[N.name] = N.position
		
		N.on = false
		N.get_node(\"SpriteH\").queue_free()
		N.get_node(\"GRAB\").queue_free()
		N.get_node(\"Sel\").queue_free()
		N.get_node(\"PickUp\").queue_free()
		N.get_node(\"Drop\").queue_free()
	Data._save(\"PLAYER_redyrepair\",act3_data)
	print(\"save: \",act3_data)
"

