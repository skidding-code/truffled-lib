func _windowMode():
	ValidMonitor = false
	if singleWindow:
		# Nothing to switch to: there is one window and it never changes size.
		setNodeScale()
		windowedReady = true
		return
	OS.window_borderless = false
	if (OS.get_screen_size(monitor).y/1080) > (OS.get_screen_size(monitor).x/1920):
		OS.window_size = (Vector2(1920,1080))*(OS.get_screen_size(monitor).x/1920)*.8
	else:
		OS.window_size = (Vector2(1920,1080))*(OS.get_screen_size(monitor).y/1080)*.8
	print(OS.window_size)
	OS.center_window()
	setNodeScale()
	windowedReady = true
"

