[sub_resource type="GDScript" id=5]
script/source = "extends Node
export var keyboardNoise = true
var lastevent
var pitch = 1.0
func _input(event):
	if(keyboardNoise == true):
		if event is InputEventKey:
			if((event.scancode != KEY_ENTER) and (event.scancode != KEY_BACKSPACE) and (event.scancode != KEY_SPACE) and (event.scancode != KEY_CAPSLOCK) and (event.scancode != KEY_SHIFT) and (event.scancode != KEY_CONTROL) and (event.scancode !=  KEY_ALT) ):
				if event.pressed:
					if(lastevent != event.scancode):
						lastevent = event.scancode
						pitch = rand_range(0.9,1.1)
						get_node(\"1D\").pitch_scale = pitch
						get_node(\"1D\").play()
				else:
					lastevent = null
					pitch = rand_range(0.9,1.1)
					get_node(\"1U\").pitch_scale = pitch
					get_node(\"1U\").play()
			else:
				if event.pressed:
					if(lastevent != event.scancode):
						lastevent = event.scancode
						pitch = rand_range(0.9,1.1)
						get_node(\"2D\").pitch_scale = pitch
						get_node(\"2D\").play()
				else:
					lastevent = null
					pitch = rand_range(0.9,1.1)
					get_node(\"2U\").pitch_scale = pitch
					get_node(\"2U\").play()
"

[sub_resource type="GDScript" id=6]
script/source = "extends Control
var Nscale = (App._screenSize().y/1080)
var FOLLOW_SPEED = 1.0

func _physics_process(delta):
	var mouse_pos = get_global_mouse_position()
	FOLLOW_SPEED = Tab.effects[\"spotlight_lerp\"]
	
	if(Tab.effects[\"spotlight\"] > 0.0):
		$Mask.visible = true
		$Mask/Light2D.texture_scale = Tab.effects[\"spotlight\"] * Nscale
		if(Tab.effects[\"spotlight_spot_mouse\"]):
			$Mask/Light2D.position = $Mask/Light2D.position.linear_interpolate(mouse_pos, delta * FOLLOW_SPEED)
	else:
		$Mask.visible = false
"

