[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

func _ready():
	var na_me = Data.data[\"name\"]
	
	$Viewport/Control/T.bbcode_text = \"[center]Welcome to \" + na_me + \" Land!\"
	if na_me.length() > 4:
		$Viewport/Control/T/A.play(\"B\")
	else:
		$Viewport/Control/T/A.play(\"S\")
"

