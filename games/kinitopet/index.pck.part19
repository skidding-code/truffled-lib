[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

func _process(delta):
	self.translation.y = get_parent().get_node(\"Horse/untitled\").translation.y  + 1.35
"

[sub_resource type="GDScript" id=2]
script/source = "extends Spatial
var zoom = false
var fpv_camera_angle = 0
var fpv_mouse_sensitivity = 0.3
var c_fov = 70
var dis_fov = 0
onready var camera = $B/Camera
func _process(delta):
	camera.fov = camera.fov + ((c_fov+dis_fov) - camera.fov) * delta*10.0
	camera.fov = clamp(camera.fov,10,70)
	
func _input(event):
	if Input.is_action_just_pressed(\"esc\"):
		pass
	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if event is InputEventMouseMotion:
			rotate_y(deg2rad(-event.relative.x * fpv_mouse_sensitivity))
			var change = -event.relative.y * fpv_mouse_sensitivity
			if change + fpv_camera_angle < 90 and change + fpv_camera_angle > -90:
				$B.rotate_x(deg2rad(change))
				fpv_camera_angle += change
	if Input.is_action_just_pressed(\"click2\"):
		c_fov = 40
		zoom = true 
		$zoom/in.play()
	elif Input.is_action_just_released(\"click2\"):
		c_fov = 70
		dis_fov = 0
		zoom = false
		$zoom/out.play()
	if zoom:
		if Input.is_action_just_pressed(\"ScrollUp\"):
			dis_fov -= 10
			$zoom/c.pitch_scale = -(float(dis_fov)/100)/2+3.7
			$zoom/c.play()
		if Input.is_action_just_pressed(\"ScrollDown\"):
			dis_fov += 10
			$zoom/c.pitch_scale = -(float(dis_fov)/100)/2+3.7
			$zoom/c.play()
		dis_fov = clamp(dis_fov,-30,20)
"

