[sub_resource type="GDScript" id=14]
script/source = "extends Button
func _on_Button_button_up():
	if(get_parent().get_node(\"Password TextEdit\").fText != \"\"):
		Tab.data[\"data\"][12][\"Output\"] = get_parent().get_node(\"Password TextEdit\").fText
		$Anim.play(\"1\")
		yield(get_tree().create_timer(float(  Tab.data[\"data\"][12][\"timeToClose\"] )), \"timeout\")
		get_parent().get_parent().get_parent().get_parent().get_node(\"AnimationPlayer\").play(\"0\")
		yield(get_tree().create_timer(float( 0.6)), \"timeout\")
		Tab.close(12)
"

