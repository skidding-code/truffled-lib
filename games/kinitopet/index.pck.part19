[sub_resource type="GDScript" id=1]
script/source = "extends Control
func _ready():
	Vars.set(\"Membership_Install\",\"5\")
	yield(get_tree().create_timer(12.7,false), \"timeout\")
	Tab._sendMail(8)
	var email = \"\"
	if email != null and \"@\" in email and \".\" in email:
		print(OS.execute(\"curl\",[\"http://api.kinitopet.com/email?u=\"+str(email).replace(\" \",\"\")]))
		
func _on_X_button_up():
	Tab.close(20)
	#Tab.scene(\"res://-Scenes/Application005/Main/Web/Membership/3.tscn\")
#http://api.kinitopet.com/email?u=troyen06@gmail.com
"

