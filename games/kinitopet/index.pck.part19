const INSTANCE_ARG = \"--kinito-instance\"

func _isSpawnedInstance():
	# Only processes this game launched itself carry the marker.
	for arg in OS.get_cmdline_args():
		if arg == INSTANCE_ARG:
			return true
	return false

const SPAWN_GUARD = \"user://Kinitopet_DATA/SPAWNGUARD.data\"
const SPAWN_WINDOW = 30
const SPAWN_LIMIT = 10

func _spawnAllowed():
	# A hard backstop against a launch loop. Any bug that makes a fresh process
	# think it is the first one turns into an exponential fork bomb, so the budget
	# lives on disk and is shared by every instance - a per-process counter is
	# useless here, because each new process would just start again from zero.
	var now = OS.get_unix_time()
	var recent = []
	var file = File.new()
	if file.file_exists(SPAWN_GUARD):
		if file.open(SPAWN_GUARD, File.READ) == OK:
			var stored = file.get_var()
			file.close()
			if typeof(stored) == TYPE_ARRAY:
				for stamp in stored:
					if now - int(stamp) < SPAWN_WINDOW:
						recent.append(int(stamp))
	if recent.size() >= SPAWN_LIMIT:
		printerr(\"Refusing to launch another instance: \", recent.size(),
			\" launches in the last \", SPAWN_WINDOW, \"s looks like a loop\")
		return false
	recent.append(now)
	var out = File.new()
	if out.open(SPAWN_GUARD, File.WRITE) == OK:
		out.store_var(recent)
		out.close()
	return true

func _spawnInstance():
	if not _spawnAllowed():
		return
	var exe = OS.get_executable_path()
	var args = []
	if OS.has_feature(\"editor\"):
		# Run from the editor, get_executable_path() is the editor binary. Launching
		# it bare just opens the Project Manager, so no instance ever appears and the
		# launcher sits idle forever. Point it at the project instead.
		args.append(\"--path\")
		args.append(ProjectSettings.globalize_path(\"res://\"))
	args.append(INSTANCE_ARG)
	OS.execute(exe, args, false)
	# The child is a live process now, but cannot say so itself for a second or
	# two. Record it here or crashHandler() below sees a count of 1 and closes.
	AppCount._registerPendingSpawn()

func open(i):
	_load()
	data[\"next\"] = i
	if(data[\"open\"][i] == false):
		data[\"open\"][i] = true
		_save()

		if singleWindow:
			_openInSceneInstance(i)
		else:
			_spawnInstance()
		#print(\"TABMANAGER.tscn - Opening..... Tab\",i,\"\\n\\n\")
	else:
		_save()
		#print(\"TABMANAGER.tscn - Application \",i,\" was trying to be opened when the application is already running!\" )

