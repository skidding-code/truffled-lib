[sub_resource type="GDScript" id=3]
script/source = "extends Viewport


# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.
func _ready():
	self.size = App._renderSize()/(Vars.get(\"nodeScale\"))
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass
"

[sub_resource type="GDScript" id=4]
script/source = "extends Control
var selected = false
var pos = Vector2(0,0)
var rng = RandomNumberGenerator.new()
export var direction = Vector2(0.5, 1.0); onready var Position = Vector2(1000 / 2,500 / 2)
export var speed = 1000
export var app_size = Vector2(0,0)
var screen_size = Vector2(1080,1920)


func _ready():
	rng.randomize()
	rect_position = ( Vector2(App._windowOrigin().x-(rng.randf()*100),App._windowOrigin().y-(rng.randf()*100) ))
	
	screen_size = App._renderSize()/(Vars.get(\"nodeScale\"))
	Position = rect_position
	
	
func _process(delta):
	Position += direction * speed * delta
	rect_position = ( Vector2(Position.x , Position.y ) )
	
	if ((Position.y < 0 and direction.y < 0) or (Position.y + app_size.y > screen_size.y and direction.y > 0)):
		direction.y = -direction.y
		$Bonk.play()
	if ((Position.x < 0 and direction.x < 0) or (Position.x + app_size.x > screen_size.x and direction.x > 0)):
		direction.x = -direction.x
		$Bonk.play()
func button_down():
	selected = true
	pos = (get_viewport().get_mouse_position()/($APPMANAGER.get(\"ApplicationSizeMultiplier\")))
func button_up():
	selected = false



func _on_CANCEL_button_up():
	get_parent().get_node(\"AnimationPlayer\").play(\"E\")
	Tab.data[\"data\"][5] = 3
	yield(get_tree().create_timer(1.0), \"timeout\")
	Tab.close(6)
"

