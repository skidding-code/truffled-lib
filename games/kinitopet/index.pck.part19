[sub_resource type="GDScript" id=1]
script/source = "extends Node

func _ready():
	print(\"KINITO WORLD LOADED - HAVE FUN\")
	if not App.singleWindow:
		# Only meaningful when this scene owns its own OS window. In single window
		# mode it is hosted inside the game, and every one of these would be
		# reconfiguring the game's own window out from under it.
		get_tree().get_root().set_transparent_background(false)
		OS.window_per_pixel_transparency_enabled = false
		OS.set_window_always_on_top(false)
		OS.window_minimized = false
		OS.window_size = Vector2(800,600) * (OS.get_screen_size().x/1920)
		get_tree().set_screen_stretch(SceneTree.STRETCH_MODE_VIEWPORT,  SceneTree.STRETCH_ASPECT_KEEP, Vector2(600,450),2)
		OS.center_window()
		OS.window_position = Vector2(OS.window_position.x,OS.window_position.y*1.2)
		OS.window_borderless = false
		OS.window_resizable = false
		Engine.target_fps = 30
	else:
		# The 600x450 stretch base and the ViewportTexture rebinding are both done
		# by App when it creates the hosting viewport, so they survive this scene
		# being swapped for the house and back.
		pass
	App._load()
	_loadVars()
	
	
	#get_tree().change_scene(\"res://Act3/Home/Scenese/Feild/Feild.tscn\")
	

func _loadVars():

#data = {\"PostRunAnimation\":false,\"WP\":\"\" ,\"name\":\"\",\"namefound\":0,\"tts_sn\":0,\"sp\":0,\"dataSP\":0,\"dfs\":0,\"ContAcc\":0,\"RESET\":false,\"KCount\":0,\"Colour\":\"\",\"name_valid\":false,\"colour_valid\":false,\"emailBox\":[], \"lastSave\":\"never\", \"Endings\":[], \"Memory\":[]         , \"PLAYER_FavWord\":\"\" , \"PLAYER_Super\":\"\" ,\"PLAYER_redyrepair\":{} ,\"PP_Painting\":false, \"Act1_hang\":false ,\"BDAY\":0,\"BMONTH\":0,\"LastName\":\"\", \"ACT3_Weather\":\"\",\"ACT3_Place\":\"\"  ,\"F_Food\":\"\",\"F_Game\":\"\",\"PET_Name\":\"\",\"PET_Type\":\"\" } 

	
	Vars.set(\"HOUSE_key_door\",0)
	Vars.set(\"HOUSE_playername\",Data.data[\"name\"])
	Vars.set(\"HOUSE_favcolour\",Data.data[\"Colour\"])
	Vars.set(\"HOUSE_favfood\",Data.data[\"F_Food\"])
	Vars.set(\"HOUSE_superpower\",Data.data[\"PLAYER_Super\"].left(10))
	Vars.set(\"HOUSE_petname\",Data.data[\"PET_Name\"])
	Vars.set(\"HOUSE_pettype\",Data.data[\"PET_Type\"])
	Vars.set(\"HOUSE_favgame\",Data.data[\"F_Game\"])

	Vars.set(\"HOUSE_season\",Data.data[\"ACT3_Weather\"])
	Vars.set(\"HOUSE_world\",Data.data[\"ACT3_Place\"])
	
	#\"BDAY\":0,\"BMONTH\":0
	
	#Vars.set(\"HOUSE_birthday\",birthday)
	var time = OS.get_datetime()
	var day = time[\"day\"]
	var month = time[\"month\"]
	
	if day == Data.data[\"BDAY\"] and month ==  Data.data[\"BMONTH\"]:
		Vars.set(\"HOUSE_birthday\",true)
	else:
		Vars.set(\"HOUSE_birthday\",false)
	
	#Summer
	#Winter
	#Autumn
	
	#Field
	#Island
	#Forest

	
	
	
# if the games can be sucessfully loaded this varaible will be true so kinito can say the line about getting your favourite game
# if it is false we can play the line about saying how we can play whatever you want or need in this world.
# Vars.get(\"HOUSE_GamesValid\") == true
"

[sub_resource type="GDScript" id=2]
script/source = "extends Spatial

var acceptClick = false
func _ready():
	
	#yield(get_tree().create_timer(4.0), \"timeout\")
	#App._worldToKinito(\"StartReady\")
	App._worldToKinito(\"FUNFAIR_INITLOAD\")
	yield(get_tree().create_timer(10.0,false), \"timeout\")
	while str(App.data[\"data\"][3]) != \"FUNFAIR_StartReady\":
		yield(get_tree(), \"idle_frame\")
	get_node(\"IntroSeq/TITLE/AnimationPlayer/start/loop\").play(\"loop\")
	acceptClick = true
	
	while str(App.data[\"data\"][3]) != \"FUNFAIR_TrainAppear\":
		yield(get_tree(), \"idle_frame\")
	get_node(\"IntroSeq/TITLE/AnimationPlayer\").play(\"Train\")
	
	
	while str(App.data[\"data\"][3]) != \"FUNFAIR_CoasterGo\":
		yield(get_tree(), \"idle_frame\")
	
	get_node(\"Funland/coaster/AnimationPlayer\").play(\"Cart\")
	
	yield(get_tree().create_timer(3.0,false), \"timeout\")
	get_node(\"Funland/coaster/AnimationPlayer\").playback_speed = 0
	yield(get_tree().create_timer(1.0,false), \"timeout\")
	$Funland/coaster/broke.play()
	
	while str(App.data[\"data\"][3]) != \"FUNFAIR_CoasterStart\":
		yield(get_tree(), \"idle_frame\")
	
	
	var initpos = OS.window_position.y 
	OS.window_position = Vector2(OS.window_position.x,OS.window_position.y *1.1)
	get_node(\"Funland/coaster/AnimationPlayer\").playback_speed = 1
	$hit.play()
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	
	OS.window_position = Vector2(OS.window_position.x,initpos)
		

func _input(event):
	if Input.is_action_just_pressed(\"click\"):
		if acceptClick:
			acceptClick = false
			App._worldToKinito(\"FUNFAIR_StartGame\")
			
			#App._initialize_Steam()
		#	yield(get_tree().create_timer(5.0), \"timeout\")
			get_node(\"IntroSeq/TITLE/AnimationPlayer\").play(\"Continue\")
			get_node(\"IntroSeq/TITLE/AnimationPlayer/start/loop\").stop()
			get_node(\"IntroSeq/TITLE/AnimationPlayer/start\").visible = false


var ot = false
func _on_InCart_body_entered(body):
	if body.name == \"Player\":
		if App.data[\"data\"][4] == \"FUNFAIR_move\":
			if ot == false:
				ot = true
				App._worldToKinito(\"FUNFAIR_StartTrain\")
				$IntroSeq/AnimationPlayer.play(\"TrainGo\")
				yield(get_tree().create_timer(58.0), \"timeout\")
				App._worldToKinito(\"FUNFAIR_TrainArrive\")
				
			pass
	#TrainGo
	
	pass # Replace with function body.

var otWheel = false
func _on_Wheel_body_entered(body):
	if otWheel == false:
		if body.name == \"Player\":
		#	if App.data[\"data\"][4] == \"null\":
			otWheel = true
			App._worldToKinito(\"FUNFAIR_wheel\")
			#HOUSE_land
	pass # Replace with function body.

var __ready = false
var ykO = false
func _on_you_know_body_entered(body):
	if __ready:
		if body.name == \"Player\":
			#if App.data[\"data\"][4] == \"null\":
			if ykO == false:
				App._worldToKinito(\"FUNFAIR_youknow\")
				ykO = true
				$Funland/StoryArea/Death.visible = true
				yield(get_tree().create_timer(0.4), \"timeout\")
				$Funland/StoryArea/Death.visible = false
				$Funland/StoryArea/anim.play(\"switch\")

		
	pass # Replace with function body.


func _on_knowtrig_body_entered(body):
	if body.name == \"Player\":
		__ready = true

var moveot = false
func _on_move_body_entered(body):
	if moveot == false:
		if body.name == \"Player\":
			
			App._worldToKinito(\"FUNFAIR_move\")
			moveot= true
			
	pass # Replace with function body.
"

