[sub_resource type="GDScript" id=26]
script/source = "extends Control
var oneshot = false
func _process(delta):
	if(Tab.data[\"open\"][17] == true ):
		Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
	else:
		if(Tab.mouseOveride == false):
			if(Tab.effects[\"load\"] == true):
				oneshot = false
				rect_position = (get_global_mouse_position())
				modulate.a = 1.0
				Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
			else:
				if(oneshot == false):
					oneshot = true
					modulate.a = 0.0
					Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		else:
			modulate.a = 0.0
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
"

