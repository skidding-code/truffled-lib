[sub_resource type="GDScript" id=8]
script/source = "extends Sprite
var NextPass = 0
func _ready():
	_timer()
func _timer():
	var _timer = Timer.new()
	add_child(_timer)
	_timer.connect(\"timeout\", self, \"_timeout\")
	_timer.set_wait_time(0.1)
	_timer.set_one_shot(false)
	_timer.start()
func _timeout():
	if(NextPass == 0):
		if(frame >= 20):
			frame = 1
			NextPass = 1
		else:
			frame += 2
	else:
		if(frame >= 21):
			frame = 0
			NextPass = 0
		else:
			frame += 2
	pass
"

[sub_resource type="GDScript" id=9]
script/source = "extends RichTextLabel
export var audio = false
export var lastVisi = -1

func _process(delta):	
	if(audio == true):
		if(lastVisi != visible_characters):
			lastVisi = visible_characters
			$AudioStreamPlayer.play()
		if(percent_visible == 1):
			audio = false
	pass
"

