[sub_resource type="GDScript" id=1]
script/source = "extends Control
export var sScene = false
export var zoom = 1.0



func _ready():
	Tab.focus(5)
	Tab.close(6)
	#Tab.effects[\"zoom_tab\"] = 5
	#Tab.effects[\"zoom_offset\"] = Vector2(525,320)

func _process(delta):
	#Tab.effects[\"zoom\"] = zoom

	if(sScene == true):
		sScene = false
		Tab.scene(\"res://-Scenes/Application005/Main/Web/KinitoPET/1.tscn\")
"

