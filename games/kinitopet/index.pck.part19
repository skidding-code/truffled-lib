[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var plot = $Active/ScrollContainer/VBoxContainer/
onready var mod_box = preload(\"res://-Scenes/Application015/Mod.tscn\")
onready var modtot = App.mods.size()
var switched = -1
func _ready():
	for mod in (modtot):
		print(\"GENERATING MOD NO: \"+str(mod)  )
		plot.add_child(mod_box.instance() )
		plot.get_node(\"Mod/Name\").text = str(App.mods[mod])
		var image = Image.new()
		var err = image.load(\"user://Mods/\"+str(App.mods[mod])+\"/mod_icon.png\")
		print((\"user://Mods/\"+str(App.mods[mod])+\"/mod_icon.png\"))
		if err == OK:
			var texture = ImageTexture.new()
			texture.create_from_image(image, 0)
			
			plot.get_node(\"Mod/Pos/Pos/Icon\").texture = texture
		plot.get_node(\"Mod\").modname = str(App.mods[mod])
		plot.get_node(\"Mod\").name = str(mod)
		

func _process(delta):
	for mod in (modtot):
		if (plot.get_node(str(mod)).switch == true and plot.get_node(str(mod)).reset == false):
			for switchmod in (modtot):
				plot.get_node(str(switchmod)).switch = false
				plot.get_node(str(switchmod)).reset = false
			plot.get_node(str(mod)).reset = true
			plot.get_node(str(mod)).switch = true
			switched = mod
			
	if(switched == -1):
		get_node(\"Active/Run\").modulate.a = .3
	else:
		get_node(\"Active/Run\").modulate.a = 1.0
		





func _on_CANCEL2_button_up():
	get_node(\"Active/AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0), \"timeout\")
	Tab.close(15)

func _on_Run_button_up():
	if(switched != -1):
		var msgBox = Tab.msgBox(\"Are you sure?\",\"Mods are not checked for contents and or threats. \\nRun at your own risk.\",1,\"Run\",\"Quit\",0)
		if msgBox is GDScriptFunctionState:
			msgBox = yield(msgBox, \"completed\")
		if(msgBox == 1):
			
			Tab.mod = App.mods[switched]
			Tab.open(20)
			
			get_node(\"Active/AnimationPlayer\").play(\"1\")
			yield(get_tree().create_timer(2.0), \"timeout\")
			Tab.close(15)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

func _on_X_button_up():
	get_node(\"AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0), \"timeout\")
	Tab.close(15)
"

