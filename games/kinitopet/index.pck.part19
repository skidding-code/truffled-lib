	if not App.singleWindow:
		OS.window_borderless = true
	OS.set_window_title(\"KinitoPET.exe\")
	Vars.set(\"Kinito_alone\",true)
	
	
	_closeAll([1])
	close(0)
	if not App.singleWindow:
		# He pops out by shrinking the whole window down to just him over a
		# transparent background, so he floats on the desktop. With one window
		# there is no desktop behind us - leave the window alone and let him
		# float in the scene, which is already where he is drawn.
		OS.window_size = Vector2(250,345) * Vars.get(\"nodeScale\")
		OS.window_position +=  (window_position(1))
		Tab.set_window_position(1, Vector2(-100,-60) * Vars.get(\"nodeScale\") )
	soloKinito = true
	appParent.remCam()

func tempRevertKinito():
	#OS.set_window_title(\"<!>\")
	soloKinito = false
	if App.singleWindow:
		# One window, fixed 1920x1080 stretch. Resizing, centring or fullscreening
		# it churns the canvas and fixes nothing, so skip both branches.
		pass
	elif App.windowedMode:
		OS.window_borderless = false
		if (OS.get_screen_size(App.monitor).y/1080) > (OS.get_screen_size(App.monitor).x/1920):
			OS.window_size = (Vector2(1920,1080))*(OS.get_screen_size(App.monitor).x/1920)*.8
		else:
			OS.window_size = (Vector2(1920,1080))*(OS.get_screen_size(App.monitor).y/1080)*.8
		OS.center_window()
	else:
		OS.window_size = App.initSize
		OS.window_position = Vector2.ZERO
	
	set_window_position(1, (Vector2(-100,-55)- (App._windowOrigin())) * Vars.get(\"nodeScale\") ) 
	appParent.addCam()
