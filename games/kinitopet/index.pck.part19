[sub_resource type="GDScript" id=44]
script/source = "extends Viewport
export var value = 0
var setval = 0
var achiveset = false
func _process(delta):
	#value = get_parent().get_node(\"ViewportContainer/Viewport/M\").score*50
	
	
	setval = int(clamp(value,0,99999))
	$\"4\".frame = int((str(setval).pad_zeros(5))[4])
	$\"3\".frame = int((str(setval).pad_zeros(5))[3])
	$\"2\".frame = int((str(setval).pad_zeros(5))[2])
	$\"1\".frame = int((str(setval).pad_zeros(5))[1])
	$\"0\".frame = int((str(setval).pad_zeros(5))[0])

"

