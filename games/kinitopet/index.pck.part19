[sub_resource type="GDScript" id=1]
script/source = "extends Control
var selected = false
var pos = Vector2(0,0)
export var sScene = false
func _ready():
	if(Tab.sp == 0):
		Tab.open_note(1)
	Tab.queuescene(\"res://-Scenes/Application005/Main/Web/InternetPMT.tscn\",false)

func _process(delta):
	if(sScene == true):
		sScene = false
		Tab._close(5)


func _on_X_button_up():
	get_node(\"Active/OC\").play(\"0\")
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	Tab.close(5)
"

