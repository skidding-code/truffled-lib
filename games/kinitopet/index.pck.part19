script/source = "extends AnimationPlayer

func _process(delta):
	var dis = get_parent().get_parent().get_node(\"PointTo\").distanceTo
	self.playback_speed = clamp((dis-1)/2,0.2,1)
	
func _ready():
	pass # Replace with function body.



func _on_AnimationPlayer_animation_finished(anim_name):
	pass # Replace with function body.
"

