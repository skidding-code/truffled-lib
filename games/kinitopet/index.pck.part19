[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var username = (((str(OS.get_environment(\"USERNAME\")).left(5))+\"532@email>\"))

func _process(delta):
	
	if(Tab.resetMail):
		Tab.resetMail = false
		Tab.scene(\"res://-Scenes/Application004/Main/1.tscn\")

func _ready():
	Vars.set(\"EMAIL_NAME\",str(\"<\"+username))
	Vars.set(\"EMAIL_USERNAME\",str(OS.get_environment(\"USERNAME\")).to_upper())
	Vars.set(\"EMAIL_TO\",str(\"    <to \"+username))
	$EmailTitle/TOPNAME_NAME.bbcode_text = str(OS.get_environment(\"USERNAME\")).to_upper()
	$EmailTitle/TOPNAME_EMAIL.bbcode_text = str(\"<\"+username)
	
	while true:
		yield(get_tree().create_timer(3.0,false), \"timeout\")
		Vars.set(\"OnApp\",\"Email\")
	
#	get_node(\"Emails/TOPNAME_EMAIL\").bbcode_text = \"<\"+username
#	get_node(\"Emails/TOPNAME_NAME\").bbcode_text = str(OS.get_environment(\"USERNAME\")).to_upper()
#	get_node(\"Emails/1/T1\").bbcode_text = (\"<from no-reply@dailymailonline.web>    < to \"+username)
	
	
func _on_X_button_up():
	get_parent().get_node(\"OC\").play(\"1\")
	yield(get_tree().create_timer(0.2,false), \"timeout\")
	Tab.close(4)

"

