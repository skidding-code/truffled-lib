[sub_resource type="GDScript" id=5]
script/source = "extends Node2D
export var newLoad = false
export var meat = false

func _ready():
	pass # Replace with function body.
var ot = true
func _process(delta):
	if newLoad:
		newLoad = false
		if is_instance_valid(get_child(0)):
			get_child(0).queue_free()
			
		if meat:
			meat = false
			if ot:
				ot= false
				add_child( get_parent().get(\"meatob\").instance()  )
				get_parent().get_node(\"AnimationPlayer\").play(\"Meat\")
		else:
			var rngVal = get_parent()._getValue()
			add_child(  (get_parent().get((\"o\"+str(rngVal).pad_zeros(2))).instance())  )
"

