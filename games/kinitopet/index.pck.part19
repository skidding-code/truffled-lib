[sub_resource type="GDScript" id=1]
script/source = "extends Node

const SafeSave = preload(\"res://Script/SafeSave.gd\")


onready var appParent = null

var sp = 0
var data = {\"open\":[],\"data\":[],\"pos\":[]}
var NodeCount = 32

var buttonValue = 0
#DEKSTOP
#onready var kinitoScene = preload((\"res://-Scenes/Application001/Main/1.tscn\")) 

var preloadbank = {}
var topfocus = 0
var effects = {\"shake\":0.0,\"zoom\":1.0,\"zoom_tab\":-1,\"zoom_offset\":Vector2(0,0),\"spotlight\":0.0,\"spotlight_lerp\":2.0,\"spotlight_spot_mouse\":false,\"load\":false} ; var loadMouse = false ; var screenSaver = false ; var CameraOveride = false ; var mouseOveride = false
var mailSent = false ; var mailNumber = -1 ; var resetMail = false
var disablePause = false
var NEW_GAME = false
#When game is beten once we enter NEW_GAME mode.

func endplay():
	
	pass
#var mod = \"\" ; var modApps = 0
#func _initMod():
#	for _i in range(modApps):
#		var node = Node2D.new()
#		node.name = str(_i+NodeCount)
#		var setscale = false
#		node.scale = Vars.get(\"nodeScale\")
#		if(setscale == false):
#			setscale = true
#		appParent.add_child(node)
#
#		data[\"open\"].append(false)
#		data[\"data\"].append(0)
#		data[\"pos\"].append(Vector2(0,0))
var startdone = false
func _start():

	

	
	appParent = get_tree().get_current_scene().get_node(\"Main\")
	#queueapp(16,true)
	_BRE()
	sp = Data.data[\"sp\"]
	for _i in range(NodeCount):
		var node = Node2D.new()
		node.name = str(_i)
		var setscale = false
		if(_i != 0):
			App.setNodeScale()
			if(_i != 25):
				node.scale = Vars.get(\"nodeScale\")
			if(setscale == false):
				setscale = true
				#Vars.set(\"nodeScale\",Vector2( (1080/OS.get_real_window_size().y), (1080/OS.get_real_window_size().y)))
				#appParent.scale = Vector2( (1080/OS.get_real_window_size().y), (1080/OS.get_real_window_size().y))
		appParent.add_child(node)
		
		data[\"open\"].append(false)
		data[\"data\"].append(0)
		data[\"pos\"].append(Vector2(0,0))
	startdone = true
	_initiVars()
	_checkMail()
	
	#print(\"ENDINGS:::  \",Data.data[\"Endings\"])
	if Data.data[\"Endings\"].size() >= 1:
		NEW_GAME = true
	if Data.data[\"sp\"] ==  13:
		NEW_GAME = true




func changeSP(number):
	Data._save(\"sp\",number)
	_closeAll([0])
	Vars.global = {}
	
	App.setNodeScale()
	Vars.set(\"ScreenSize\",App._renderSize())
	Vars.set(\"player_name\",Data.data[\"name\"])
	if(Data.data[\"namefound\"] == 1):
		Vars.set(\"name_valid\",false)
	elif((Data.data[\"namefound\"] == 2)):
		Vars.set(\"name_valid\",true)
	appParent.refreshZ()
	scene(\"res://-Scenes/Application000/Main/PC.tscn\")
	pass

func _resize():
	# Re-apply the scale every application container was given at startup. Nodes
	# 0 and 25 are deliberately left alone, matching how they are built in _ready.
	if startdone == false:
		return
	var scale = Vars.get(\"nodeScale\")
	if scale == null:
		return
	for _i in range(NodeCount):
		if _i == 0 or _i == 25:
			continue
		var node = appParent.get_node_or_null(str(_i))
		if node != null:
			node.scale = scale
##	if(startdone):
##		for _i in range(NodeCount):
##			if(_i != 0):
##
##				App.setNodeScale()
##				appParent.get_node(str(_i)).scale = Vars.get(\"nodeScale\")
##				print(appParent.get_node(str(_i)).scale)
#		pass

#var idle = false
#func _idle():
#	if(screenSaver):
#		yield(get_tree().create_timer(120.0), \"timeout\")
#		if (get_tree().paused == false):
