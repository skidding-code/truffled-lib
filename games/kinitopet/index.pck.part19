func set_window_position(tab,postoset):
	data[\"pos\"][tab] = postoset
	#print(\"set data[pos][\"+str(tab)+\"] to \",postoset)
	if tab == 1 and soloKinito and not App.singleWindow:
		# Solo Kinito IS the OS window there, so moving him means moving it. Here he
		# is still a node in the one window, and routing his position to
		# OS.window_position simply threw it away - he stopped moving entirely once
		# he \"popped out\".
		OS.window_position = (postoset) 
#	if tab == 19 and soloSurvey:
#		OS.window_position = postoset * Vars.get(\"nodeScale\")
	else:
		appParent.get_node(str(tab)).position = postoset

func window_position(i):
	if i == 1 and soloKinito and not App.singleWindow:
		return OS.window_position
	else:
		return data[\"pos\"][i]
		
	
func _closeAll(array):
	for i in range (Tab.data[\"open\"].size()):
		if i in array:
			pass
		else:
			Tab.close(i)
			
var gotEntrys = []

func _sendEntry(entry):
	print(\"Enery Send -> \",str(entry))
	if NEW_GAME:
		if gotEntrys.has(entry) == false:
			var dir = Directory.new()
			dir.open(\"user://\")
			if(dir.file_exists(\"Kinitopet_DATA\") == false):
				dir.make_dir(\"Kinitopet_DATA\")
			# One slot. A new entry replaces whatever was in it, so only ever the
			# most recent one is out there to be found.
			SafeSave.write_var(\"user://Kinitopet_DATA/ENTRY.get\", entry)


func _on_EntryTimer_timeout():
	if NEW_GAME:
		var dir = Directory.new()
		dir.open(\"user://\")
		var file = File.new()
		if(dir.file_exists(\"Kinitopet_DATA/ENTRY.send\")):
			# Written by another instance, so it may be caught mid-write.
			var entry = SafeSave.read_var(\"user://Kinitopet_DATA/ENTRY.send\", null)
			if entry != null:
				_sendMail(entry+2)
				gotEntrys.append(entry)
				dir.remove(\"user://Kinitopet_DATA/ENTRY.send\")
"

