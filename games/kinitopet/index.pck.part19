	data[\"data\"][2] =[
		5,
		Vector2(0,0),
		Vector2(0,0),
		0]
	data[\"data\"][14] = {
		\"InitalEffect\":str(\"Null\"),
		\"NameOfEffect\":str(\"Null\"),
		\"EffectDuration\":float(1.0),
		\"TotalDuration\":float(1.0),
		\"Background\":bool(false),
		\"EffectActive\":false,
		\"OtherInfo\":int(0)}
	data[\"data\"][12] = {
		\"Title\":str(\"Error\"),
		\"Info\":str(\"Error\"),
		\"SubInfo\":str(\"Error\"),
		\"Timer\":1.0,
		\"MaxChar\":10,
		\"CustomReq\":str(\"Null\"),
		\"Output\":\"\",
		\"timeToClose\":0}
	data[\"data\"][11] = {
