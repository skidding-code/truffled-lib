#define _SCHEDULE_H_

#ifdef __cplusplus
extern "C" {
#endif

#define SCHEDULE_INTERVAL 0
#define SCHEDULE_BANDWIDTH 1
#define SCHEDULE_PRIORITY 2

  typedef struct _SCHEDULE_HEADER {
