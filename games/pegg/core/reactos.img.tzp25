"
" Maintainer:	Bram Moolenaar <Bram@vim.org>
" Last Change:	2011 Oct 20

if exists("did_load_ftplugin")
  unlet did_load_ftplugin
endif

" Remove all autocommands in the filetypeplugin group, if any exist.
if exists("#filetypeplugin")
