" The GUI toolbar
if has("toolbar")
  if exists("*Do_toolbar_tmenu")
    delfun Do_toolbar_tmenu
  endif
  fun Do_toolbar_tmenu()
    tmenu ToolBar.Open		Otvoriù s˙bor
    tmenu ToolBar.Save		Uloûiù s˙bor
    tmenu ToolBar.SaveAll	Uloûiù vöetky
