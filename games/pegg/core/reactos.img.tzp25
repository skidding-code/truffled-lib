    tmenu ToolBar.FindPrev	N·jsù predch·dzaj˙ce
    tmenu ToolBar.Replace	Nahradiù...
    if 0	" disabled; These are in the Windows menu
      tmenu ToolBar.New		NovÈ okno
      tmenu ToolBar.WinSplit	Rozdeliù okno
      tmenu ToolBar.WinMax	Maximalizovaù okno
