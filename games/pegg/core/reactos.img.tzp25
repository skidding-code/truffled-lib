  fun Do_toolbar_tmenu()
    tmenu ToolBar.Open     Ucitaj
    tmenu ToolBar.Save     Sacuvaj
    tmenu ToolBar.SaveAll  Sacuvaj sve
    tmenu ToolBar.Print    Stampaj
    tmenu ToolBar.Undo     Vrati
    tmenu ToolBar.Redo     Povrati
