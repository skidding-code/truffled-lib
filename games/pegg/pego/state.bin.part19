		<Image x="114" y="246" halign="center" valign="center" src="game" />
		<Image x="395" y="74" halign="center" valign="center" src="logo" />
		<Image x="418" y="266" halign="center" valign="center" src="!prog:return gBulletManager:GetImage('main')" />
		<Image x="123" y="378" src="common/images/buyitnowfor" />
		<Image x="162" y="420" halign="center" valign="center" src="price" />
		<Text halign="center" valign="center" x="218" y="192" width="399" height="18" color="#003399" font="FONT_ARIAL9BOLD" id="MessageExpireScreenPreBullet" />
		<Text halign="center" valign="center" x="218" y="325" width="399" height="18" color="#003399" font="FONT_ARIAL9BOLD" id="MessageExpireScreenPostBullet" />
		<Text halign="center" valign="center" x="218" y="157" width="399" height="21" color="#CC0000" font="!sys:Arial:10,bold" id="!prog:gScreen:GetTimeLeftString()" />
		<Text halign="center" valign="center" x="0" y="455" width="640" height="25" color="#CCCCCC" font="!sys:Arial:8" spacing="10" id="CopyrightDisclaimer" />
