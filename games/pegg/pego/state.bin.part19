<Properties>
	<Layout screen="APScreen">
		<Image x="0" y="0" src="common/images/ecomm_wrapper_background_centered" />
		<Image x="395" y="74" halign="center" valign="center" src="logo" />
		<Text halign="right" valign="center" x="22" y="233" width="239" height="18" color="#000000" font="!sys:Arial:9,bold" id="OrderNumber" />
		<Text halign="center" valign="center" x="125" y="154" width="388" height="20" color="#CC0000" font="!sys:Arial:12,bold" id="HeaderAPScreen" />
		<Text halign="center" valign="center" x="36" y="196" width="571" height="18" color="#FF6600" font="!sys:Arial:9,bold" id="MessageAPScreen" />
		<Text halign="center" valign="center" x="0" y="455" width="640" height="25" color="#CCCCCC" font="!sys:Arial:8" spacing="10" id="CopyrightDisclaimer" />
		<Text halign="center" valign="center" x="95" y="368" width="453" height="18" color="#CC0000" font="!sys:Arial:9,bold" id="!prog:gScreen.mError" />
		<Button id="Cancel" x="114" y="278" normal="common/images/btn_cancel" over="common/images/btn_cancel2" applyMask="common/images/btn_mask" function="Cancel" />
		<Button id="Register" x="321" y="278" normal="common/images/btn_register" over="common/images/btn_register2" applyMask="common/images/btn_mask" function="Register" />
		<Button id="Help" x="453" y="423" normal="common/images/btn_help" over="common/images/btn_help2" label="Help" font="!sys:Arial:9" function="ShowHelp" />
		<Button id="Privacy" x="499" y="423" normal="common/images/btn_privacy" over="common/images/btn_privacy2" label="Privacy" font="!sys:Arial:9" function="ShowPrivacy" />
		<Button id="Security" x="555" y="423" normal="common/images/btn_security" over="common/images/btn_security2" label="Security" font="!sys:Arial:9" function="ShowSecurity" />
		<Button id="BBB" x="22" y="372" normal="common/images/bbb" function="ShowBBB" />
		<Link id="ResendReceipt" x="319" y="410" label="Lost Your Email Receipt?" font="!sys:Arial:9,bold" color="#003399" color_over="#FF6600" function="ResendReceipt" />
		<Link id="ManualAP" x="324" y="434" label="Enter the Registration Key Manually" font="!sys:Arial:9,bold" color="#003399" color_over="#FF6600" function="EnterRegKey" />
	</Layout>

	<Layout screen="ConnectBegin">
		<Image x="0" y="0" src="common/images/ecomm_wrapper_background_centered" />
		<Image x="395" y="74" halign="center" valign="center" src="logo" />
		<Image x="30" y="200" src="common/images/icon_connected" />
		<Text halign="center" valign="center" x="125" y="154" width="388" height="20" color="#CC0000" font="!sys:Arial:12,bold" id="!prog:gConnectBegin_Header" />
		<Text halign="center" valign="center" x="58" y="196" width="524" height="18" color="#FF6600" font="!sys:Arial:9,bold" id="!prog:gConnectBegin_Message" />
		<Text halign="center" valign="center" x="0" y="455" width="640" height="25" color="#CCCCCC" font="!sys:Arial:8" spacing="10" id="CopyrightDisclaimer" />
		<Text halign="center" valign="center" x="25" y="274" width="591" height="66" color="#000000" font="!sys:Arial:9,bold" id="!prog:gConnectBegin_Details" />
		<Text halign="center" valign="center" x="84" y="369" width="490" height="18" color="#000000" font="!sys:Arial:9,bold" id="!prog:gConnectBegin_ButtonInfo" />
		<Button id="Cancel" x="123" y="394" normal="common/images/btn_cancel" over="common/images/btn_cancel2" applyMask="common/images/btn_mask" function="Cancel" />
		<Button id="Retry" x="330" y="394" normal="common/images/btn_retry" over="common/images/btn_retry2" applyMask="common/images/btn_mask" function="Retry" />
		<Button id="BBB" x="22" y="372" normal="common/images/bbb" function="ShowBBB" />
	</Layout>

	<Layout screen="ConnectCheck">
		<Image x="0" y="0" src="common/images/ecomm_wrapper_background_centered" />
		<Image x="395" y="74" halign="center" valign="center" src="logo" />
		<Image x="30" y="200" src="common/images/icon_connecting" />
		<Text halign="center" valign="center" x="125" y="154" width="388" height="20" color="#CC0000" font="!sys:Arial:12,bold" id="!prog:gConnectCheck_Header" />
		<Text halign="center" valign="center" x="25" y="196" width="592" height="36" color="#FF6600" font="!sys:Arial:9,bold" id="!prog:gConnectCheck_Message" />
