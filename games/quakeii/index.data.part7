map bunk1
wait
wait
wait

give shotgun;give shells 20;give machinegun;give bullets 50
give grenades 5




// Configuration file for the Jail

map jail1
wait
wait
wait
wait

give shotgun;give shells 40;give machinegun;give bullets 50
give chaingun
give "super shotgun"
give grenades 5





// Configuration file for the Mines     

map mintro
wait
wait
wait

give shotgun;give shells;give shells;give machinegun;give bullets;give bullets
give "super shotgun";give chaingun;give "grenade launcher";give rockets
give hyperblaster;give cells;give cells
give grenades



// Configuration file for the Factory

map fact1
wait
wait
wait

give shotgun;give shells 20;give machinegun;give bullets 20
give "super shotgun";give chaingun;give "grenade launcher";give rockets 5
give hyperblaster;give cells;give "rocket launcher";give rockets
give cells
give cells
give grenades


map power1
wait
wait
wait

give shotgun;give shells;give shells;give machinegun;give bullets;give bullets
give "super shotgun";give chaingun;give "grenade launcher";give rockets
give hyperblaster;give cells;give "rocket launcher";give railgun
give slugs
give grenades



// Configuration file for biggun

map biggun
wait
wait
wait


give shotgun;give shells ;give machinegun;give bullets
give "super shotgun";give chaingun;give "grenade launcher";give rockets
give hyperblaster;give cells;give cells;give "rocket launcher";give railgun
give slugs;give bfg10k; give grenades
give bullets; give bullets; give bullets
give shells; give shells; give shells; give shells




// Configuration file for the hangar

map hangar1
wait
wait
wait

give shotgun;give shells ;give machinegun;give bullets
give "super shotgun";give chaingun;give "grenade launcher";give rockets
give hyperblaster;give cells;give cells;give "rocket launcher";give railgun
give slugs;give bfg10k; give grenades
give bullets; give bullets; give bullets
give shells; give shells; give shells; give shells



// Configuration file for the City

map city1
wait
wait
wait

give Shotgun;give shells 20;give machinegun;give bullets 100
give Super Shotgun;give Chaingun;give Grenade Launcher;give rockets 5
give HyperBlaster;give cells 50;give Rocket Launcher;give Railgun
give slugs 5;give BFG10k; give grenades 5
give slugs
give slugs
give rockets
give rockets
give cells
give cells
give bullets
give bullets
give bullets




// Configuration file for the boss

map boss1
wait
wait
wait

give Shotgun;give shells 20;give machinegun;give bullets 100
give Super Shotgun;give Chaingun;give Grenade Launcher;give rockets 5
give HyperBlaster;give cells 50;give Rocket Launcher;give Railgun
give slugs 5;give BFG10k; give grenades 5
give slugs
give slugs
give rockets
give rockets
give cells
give cells
give bullets
give bullets
give bullets
give rockets
give rockets
give rockets
give bullets
give bullets
give bullets


